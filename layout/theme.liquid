<!doctype html>
<html lang="{{ request.locale.iso_code | default: 'en' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#1A56F0">
  <title>{{ page_title }}{% if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} &ndash; Page {{ current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>
  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- else -%}
    <meta name="description" content="{{ shop.description | default: shop.name | default: 'Kartzo - Shop the best deals across trending electronics, accessories and lifestyle essentials.' | escape }}">
  {%- endif -%}
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32 }}">
    <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180 }}">
  {%- else -%}
    <link rel="icon" type="image/webp" href="{{ 'k-icon.webp' | asset_url }}">
    <link rel="apple-touch-icon" href="{{ 'k-icon.webp' | asset_url }}">
  {%- endif -%}

  {% render 'seo-head' %}

  {%- if template.name == 'index' -%}
    <link rel="preload" as="image" href="{{ 'hero-1.webp' | asset_url }}" fetchpriority="high">
  {%- endif -%}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap"></noscript>
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <script>
    (function() {
      // 1. Intercept Telemetry & Tracking network calls to prevent blocked client errors, unhandled promise rejections, and retry loops
      var isTelemetry = function(u) {
        if (!u) return false;
        var s = typeof u === 'string' ? u : (u.url || '');
        return s.indexOf('produce_batch') !== -1 ||
               s.indexOf('/api/collect') !== -1 ||
               s.indexOf('shopifysvc.com') !== -1 ||
               s.indexOf('otlp-http') !== -1 ||
               s.indexOf('monorail') !== -1;
      };

      if (window.fetch) {
        var origFetch = window.fetch;
        window.fetch = function(input, init) {
          try {
            if (isTelemetry(input)) {
              return Promise.resolve(new Response(JSON.stringify({ status: 'ok' }), {
                status: 200,
                headers: { 'Content-Type': 'application/json' }
              }));
            }
          } catch (e) {}
          return origFetch.apply(this, arguments).catch(function(err) {
            if (isTelemetry(input)) {
              return new Response('{}', { status: 200 });
            }
            throw err;
          });
        };
      }

      if (navigator.sendBeacon) {
        var origBeacon = navigator.sendBeacon.bind(navigator);
        navigator.sendBeacon = function(url, data) {
          try {
            if (isTelemetry(url)) {
              return true;
            }
          } catch (e) {}
          return origBeacon(url, data);
        };
      }

      if (window.XMLHttpRequest) {
        var origOpen = XMLHttpRequest.prototype.open;
        var origSend = XMLHttpRequest.prototype.send;
        XMLHttpRequest.prototype.open = function(method, url) {
          this._kzUrl = url;
          return origOpen.apply(this, arguments);
        };
        XMLHttpRequest.prototype.send = function() {
          if (isTelemetry(this._kzUrl)) {
            try {
              Object.defineProperty(this, 'status', { value: 200, writable: false });
              Object.defineProperty(this, 'readyState', { value: 4, writable: false });
              Object.defineProperty(this, 'responseText', { value: '{}', writable: false });
            } catch (e) {}
            if (typeof this.onreadystatechange === 'function') this.onreadystatechange();
            if (typeof this.onload === 'function') this.onload();
            return;
          }
          return origSend.apply(this, arguments);
        };
      }

      // 2. Prevent unhandled promise rejections & uncaught errors from telemetry scripts
      window.addEventListener('unhandledrejection', function(e) {
        if (e && e.reason) {
          var str = (e.reason.message || e.reason || '').toString();
          if (str.indexOf('Failed to fetch') !== -1 || str.indexOf('ERR_BLOCKED_BY_CLIENT') !== -1) {
            e.preventDefault();
          }
        }
      });
      window.addEventListener('error', function(e) {
        if (e && (e.message || '').indexOf('Failed to fetch') !== -1) {
          e.preventDefault();
        }
      });

      // 3. Shop Pay stub (neutralizes 3rd party cookie / Shop sync)
      window.Shopify = window.Shopify || {};
      var dummy = { initShopCartSync: function() {} };
      try {
        Object.defineProperty(window.Shopify, 'SignInWithShop', {
          get: function() { return dummy; },
          set: function() {},
          configurable: true
        });
      } catch (e) {
        window.Shopify.SignInWithShop = dummy;
      }
    })();
  </script>
  {{ content_for_header }}
  <script>
    window.KartzoSettings = {
      moneyFormat: {{ shop.money_format | json }},
      currency: {{ cart.currency.iso_code | json }},
      freeShippingThreshold: {{ settings.free_shipping_threshold | default: 49900 | json }},
      routes: {
        root: {{ routes.root_url | json }},
        cart: {{ routes.cart_url | json }},
        search: {{ routes.search_url | json }},
        account: {{ routes.account_url | json }}
      }
    };
  </script>
  <script src="{{ 'kartzo.js' | asset_url }}" defer></script>
</head>
<body id="top" class="overflow-x-hidden bg-white font-sans text-brand-ink antialiased">
  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded-lg focus:bg-white focus:px-3 focus:py-2 focus:text-sm focus:font-bold focus:text-brand">{{ 'general.skip_content' | t }}</a>

  {% sections 'header-group' %}

  <main id="main" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  <div id="kartzo-toast-container" aria-live="polite" aria-atomic="false"></div>
</body>
</html>
