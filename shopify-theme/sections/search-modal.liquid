{% comment %}
  Predictive search modal — trending links + live suggestions from /search/suggest.json.
  Form submits to real /search; suggestions enhance, never replace, navigation.
{% endcomment %}
<div
  id="search-modal"
  class="modal-backdrop fixed inset-0 z-[80] flex items-start justify-center bg-slate-950/60 p-4 pt-16 backdrop-blur-sm sm:pt-24"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-search-label"
>
  <div class="modal-panel w-full max-w-2xl rounded-3xl bg-white p-6 shadow-2xl" tabindex="-1">
    <div class="flex items-center justify-between gap-3 border-b border-slate-100 pb-4">
      <form class="flex flex-1 items-center gap-3" action="{{ routes.search_url }}" method="get" role="search">
        <span class="text-brand">{% render 'icons', name: 'search', class: 'h-5 w-5' %}</span>
        <label id="modal-search-label" for="search-modal-input" class="sr-only">{{ 'general.search_label' | t }}</label>
        <input
          id="search-modal-input"
          name="q"
          type="search"
          placeholder="Search by product name, brand, or category..."
          autocomplete="off"
          role="combobox"
          aria-expanded="false"
          aria-controls="modal-search-results"
          aria-autocomplete="list"
          class="w-full border-0 bg-transparent text-base font-semibold text-brand-ink outline-none placeholder:text-slate-400 focus:border-0 focus:outline-none focus:ring-0 !outline-none !ring-0 !shadow-none"
          style="outline: none !important; box-shadow: none !important; border: 0 !important;"
        >
      </form>
      <button type="button" data-search-modal-close class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-slate-100 text-slate-500 hover:bg-slate-200 transition" aria-label="{{ 'general.close' | t }}">
        {% render 'icons', name: 'close', class: 'h-4 w-4' %}
      </button>
    </div>

    <div id="modal-trending-searches" class="mt-4" data-trending>
      <p class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Popular Searches</p>
      <div class="mt-2.5 flex flex-wrap gap-2">
        {%- assign trending_list = section.settings.trending_terms | split: ',' -%}
        {%- for term in trending_list -%}
          {%- assign t = term | strip -%}
          {%- if t != blank -%}
            <a href="{{ routes.search_url }}?q={{ t | url_encode }}" class="rounded-full border border-slate-200 bg-slate-50 px-3.5 py-1 text-xs font-semibold text-slate-700 hover:border-brand hover:text-brand hover:bg-brand-soft transition">{{ t }}</a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="mt-5">
      <p class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Suggested Products</p>
      <div id="modal-search-results" data-suggest-results class="mt-2.5 grid max-h-[320px] gap-2 overflow-y-auto pr-1" role="listbox" aria-label="Search suggestions"></div>
      <p id="modal-search-empty" data-suggest-empty class="mt-4 hidden text-center text-xs font-semibold text-slate-400">No matching items found. Try different keywords.</p>
    </div>

    <div class="mt-4 border-t border-slate-100 pt-3 text-center">
      <a href="{{ routes.all_products_collection_url }}" data-suggest-view-all class="text-xs font-bold text-brand hover:underline inline-flex items-center gap-1">
        <span>View All Products in Catalog</span>
        {% render 'icons', name: 'arrow-right', class: 'h-3.5 w-3.5' %}
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Search modal",
  "settings": [
    { "type": "text", "id": "trending_terms", "label": "Trending search terms (comma-separated)", "default": "Headphones, Watch, Shoes, Fryer" }
  ],
  "presets": [{ "name": "Search modal" }]
}
{% endschema %}
