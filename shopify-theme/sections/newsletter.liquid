{% comment %} Newsletter band — native customer form (tags=newsletter), same visuals as original. {% endcomment %}
<section class="pad hidden w-full pb-10 sm:block" aria-label="Newsletter">
  <div class="flex flex-col gap-4 rounded-2xl bg-[#0c1b4d] px-5 py-5 text-white sm:px-8 lg:flex-row lg:items-center">
    <div class="flex items-center gap-3">
      <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-white/20" aria-hidden="true">
        {% render 'icons', name: 'mail', class: 'h-5 w-5' %}
      </span>
      <div>
        <h2 class="text-lg font-extrabold">{{ section.settings.heading | default: 'Stay Updated' }}</h2>
        <p class="text-sm text-white/75">{{ section.settings.sub | default: 'Exclusive offers & new arrivals.' }}</p>
      </div>
    </div>
    {%- form 'customer', class: 'lg:ml-auto' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="flex w-full flex-col gap-2 sm:flex-row sm:items-center lg:w-auto">
        <label for="newsletter-email-{{ section.id }}" class="sr-only">Email address</label>
        <input
          id="newsletter-email-{{ section.id }}"
          name="contact[email]"
          type="email"
          required
          autocomplete="email"
          value="{{ form.email }}"
          placeholder="Enter your email address..."
          aria-invalid="{% if form.errors %}true{% else %}false{% endif %}"
          class="min-h-11 w-full rounded-lg border border-white/10 bg-white px-4 text-sm text-brand-ink outline-none placeholder:text-[#93a0b8] focus:ring-2 focus:ring-brand sm:w-72"
        >
        <button type="submit" name="commit" class="min-h-11 rounded-lg bg-brand px-5 text-sm font-bold text-white hover:bg-brand-dark">Subscribe</button>
      </div>
      {%- if form.errors -%}
        <p class="mt-2 text-xs font-semibold text-rose-300" role="alert">{{ form.errors | default_errors }}</p>
      {%- endif -%}
      {%- if form.posted_successfully? -%}
        <p class="mt-2 text-xs font-semibold text-emerald-300" role="status" data-newsletter-success="{{ 'general.newsletter_success' | t }}">{{ 'general.newsletter_success' | t }}</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stay Updated" },
    { "type": "text", "id": "sub", "label": "Subtext", "default": "Exclusive offers & new arrivals." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
