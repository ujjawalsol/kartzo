{% comment %}
  Kartzo Main Page — smart-renders rich layout for About, FAQ, Deals, or Policies, or standard page content.
  100% customizable in Theme Editor with blocks, collection pickers, and banner images.
{% endcomment %}
{%- assign h = page.handle | downcase -%}
{%- assign t = page.title | downcase -%}

{%- if section.blocks.size > 0 -%}
  {% render 'breadcrumbs', trail: page.title %}
  <div class="pad site-max py-5 sm:py-8">
    <div class="mb-6 border-b border-slate-200/80 pb-6">
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-brand-ink">
        {{ section.settings.heading | default: page.title }}
      </h1>
      {%- if section.settings.subtext != blank -%}
        <p class="mt-1 text-xs sm:text-sm text-slate-500">{{ section.settings.subtext }}</p>
      {%- endif -%}
    </div>

    {%- if section.settings.banner_image -%}
      <div class="mb-8 overflow-hidden rounded-2xl">
        {{ section.settings.banner_image | image_url: width: 1600 | image_tag: widths: '600, 1000, 1600', class: 'w-full h-auto object-cover max-h-72' }}
      </div>
    {%- endif -%}

    <div class="grid grid-cols-2 gap-3 sm:gap-4 sm:grid-cols-3 lg:grid-cols-4">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'deal_card' -%}
            {%- assign p = block.settings.product -%}
            {%- assign card_title = block.settings.custom_title -%}
            {%- if card_title == blank and p != blank -%}{%- assign card_title = p.title -%}{%- endif -%}
            {%- if card_title == blank -%}{%- assign card_title = 'Featured Item' -%}{%- endif -%}

            {%- assign card_url = block.settings.custom_link -%}
            {%- if card_url == blank and p != blank -%}{%- assign card_url = p.url -%}{%- endif -%}
            {%- if card_url == blank -%}{%- assign card_url = routes.all_products_collection_url -%}{%- endif -%}

            {%- assign card_price = block.settings.custom_price -%}
            {%- if card_price == blank and p != blank -%}{%- assign card_price = p.price | money -%}{%- endif -%}
            {%- if card_price == blank -%}{%- assign card_price = '₹1,999' -%}{%- endif -%}

            {%- assign card_compare = block.settings.custom_compare -%}
            {%- if card_compare == blank and p != blank and p.compare_at_price > p.price -%}{%- assign card_compare = p.compare_at_price | money -%}{%- endif -%}

            <article class="product-card group rounded-2xl border border-slate-200/80 bg-white p-3 sm:p-4 shadow-sm hover:border-brand/40 hover:shadow-card transition duration-200 flex flex-col justify-between" {{ block.shopify_attributes }}>
              <div>
                <div class="image-wrap relative flex aspect-square w-full items-center justify-center overflow-hidden rounded-xl bg-[#F6F8FB] p-3">
                  {%- if block.settings.custom_badge != blank -%}
                    <span class="absolute left-2.5 top-2.5 z-10 rounded-md bg-[#ef3b3b] text-white px-2 py-0.5 text-[10px] font-black tracking-wide shadow-sm">{{ block.settings.custom_badge }}</span>
                  {%- endif -%}
                  <a href="{{ card_url }}" class="flex h-full w-full items-center justify-center">
                    {%- if block.settings.custom_image -%}
                      {{ block.settings.custom_image | image_url: width: 800 | image_tag: widths: '400, 800', alt: card_title, class: 'h-full w-auto max-h-[85%] object-contain transition duration-200 group-hover:scale-105' }}
                    {%- elsif p.featured_image -%}
                      {{ p.featured_image | image_url: width: 800 | image_tag: widths: '400, 800', alt: card_title, class: 'h-full w-auto max-h-[85%] object-contain transition duration-200 group-hover:scale-105' }}
                    {%- else -%}
                      <img src="{{ 'p-headphones.webp' | asset_url }}" alt="{{ card_title | escape }}" width="800" height="800" class="h-full w-auto max-h-[85%] object-contain transition duration-200 group-hover:scale-105" loading="lazy">
                    {%- endif -%}
                  </a>
                </div>
                <div class="mt-3.5">
                  {%- if block.settings.custom_sub != blank -%}
                    <p class="text-[10px] font-extrabold uppercase tracking-wider text-slate-400">{{ block.settings.custom_sub }}</p>
                  {%- endif -%}
                  <h3 class="mt-1 text-xs sm:text-sm font-bold text-brand-ink leading-snug line-clamp-2">
                    <a href="{{ card_url }}" class="hover:text-brand transition">{{ card_title }}</a>
                  </h3>
                </div>
              </div>
              <div class="mt-3">
                <div class="flex items-baseline justify-between gap-1">
                  <span class="text-sm sm:text-base font-black text-brand-ink">{{ card_price }}</span>
                  {%- if card_compare != blank -%}
                    <span class="text-xs text-slate-400 line-through font-medium">{{ card_compare }}</span>
                  {%- endif -%}
                </div>
                <a href="{{ card_url }}" class="mt-2.5 flex min-h-11 w-full items-center justify-center rounded-xl bg-brand text-xs font-bold text-white hover:bg-brand-dark transition active:scale-[0.98]">
                  View Details
                </a>
              </div>
            </article>

          {%- when 'feature_card' -%}
            <div class="rounded-2xl border border-slate-200/80 bg-white p-4 sm:p-5 shadow-sm flex flex-col justify-between" {{ block.shopify_attributes }}>
              <div>
                {%- if block.settings.image -%}
                  <div class="mb-3 overflow-hidden rounded-xl">
                    {{ block.settings.image | image_url: width: 600 | image_tag: widths: '300, 600', class: 'w-full h-36 object-cover' }}
                  </div>
                {%- endif -%}
                <h3 class="text-sm sm:text-base font-extrabold text-brand-ink">{{ block.settings.title }}</h3>
                <p class="mt-1.5 text-xs text-slate-500 leading-relaxed">{{ block.settings.description }}</p>
              </div>
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" class="mt-3 inline-flex items-center gap-1 text-xs font-bold text-brand hover:underline">
                  <span>Learn more</span>
                  <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </a>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

{%- elsif h contains 'about' or t contains 'about' -%}
  {% render 'about-content' %}

{%- elsif h contains 'faq' or t contains 'faq' or h contains 'help' or t contains 'help' -%}
  {% render 'faq-content' %}

{%- elsif h contains 'deal' or t contains 'deal' -%}
  {% render 'deals-content' %}

{%- elsif h contains 'privacy' or t contains 'privacy' or h contains 'shipping' or t contains 'shipping' or h contains 'return' or t contains 'return' or h contains 'refund' or t contains 'refund' or h contains 'cancel' or t contains 'cancel' or h contains 'terms' or t contains 'terms' -%}
  {% render 'policy-content' %}

{%- else -%}
  {% render 'breadcrumbs', trail: page.title %}
  <div class="pad site-max py-5 sm:py-8 max-w-4xl mx-auto">
    <div class="mb-5 sm:mb-8">
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-brand-ink">{{ section.settings.heading | default: page.title }}</h1>
      {%- if section.settings.subtext != blank -%}
        <p class="mt-1 text-xs sm:text-sm text-slate-500">{{ section.settings.subtext }}</p>
      {%- endif -%}
    </div>
    {%- if section.settings.banner_image -%}
      <div class="mb-6 overflow-hidden rounded-2xl">
        {{ section.settings.banner_image | image_url: width: 1600 | image_tag: widths: '600, 1000, 1600', class: 'w-full h-auto object-cover max-h-72' }}
      </div>
    {%- endif -%}
    {%- if page.content != blank -%}
      <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-10 shadow-sm prose-kartzo text-xs sm:text-sm leading-relaxed text-slate-600 space-y-4">
        {{ page.content }}
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Page content",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading Override"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subheading"
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Page Top Banner Image"
    }
  ],
  "blocks": [
    {
      "type": "deal_card",
      "name": "Product / Deal Card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Card Image Override"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Title Override"
        },
        {
          "type": "text",
          "id": "custom_sub",
          "label": "Subtitle / Tag"
        },
        {
          "type": "text",
          "id": "custom_badge",
          "label": "Discount Badge (e.g. 30% OFF)"
        },
        {
          "type": "text",
          "id": "custom_price",
          "label": "Price (e.g. ₹2,799)"
        },
        {
          "type": "text",
          "id": "custom_compare",
          "label": "Original Price (e.g. ₹3,999)"
        },
        {
          "type": "url",
          "id": "custom_link",
          "label": "Custom Link (Optional)"
        }
      ]
    },
    {
      "type": "feature_card",
      "name": "Feature / Info Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card Title",
          "default": "Feature Highlight"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Card Description"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Card Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Page content"
    }
  ]
}
{% endschema %}
