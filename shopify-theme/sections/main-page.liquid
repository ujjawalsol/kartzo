{% comment %} Generic page (about, policies, etc.) — merchant page content in original prose styling. {% endcomment %}
{% render 'breadcrumbs', trail: page.title %}

<div class="pad mx-auto w-full max-w-3xl pb-12 pt-4 sm:pt-6">
  <h1 class="text-2xl font-extrabold tracking-tight sm:text-3xl">{{ page.title }}</h1>
  {%- if page.content != blank -%}
    <div class="prose-kartzo mt-4 space-y-4 text-sm leading-relaxed text-slate-600 sm:text-[15px]">
      {{ page.content }}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Page content",
  "settings": [],
  "presets": [{ "name": "Page content" }]
}
{% endschema %}
