{% comment %} FAQ — merchant-editable accordion blocks in the original details/summary style. {% endcomment %}
{% render 'breadcrumbs', trail: page.title %}

<div class="pad mx-auto w-full max-w-3xl pb-12 pt-4 sm:pt-6">
  <h1 class="text-2xl font-extrabold tracking-tight sm:text-3xl">{{ page.title | default: 'Frequently Asked Questions' }}</h1>
  {%- if page.content != blank -%}
    <div class="mt-2 text-sm text-slate-600">{{ page.content }}</div>
  {%- endif -%}
  <div class="mt-5 space-y-3">
    {%- for block in section.blocks -%}
      <details class="rounded-2xl border border-[#e6eefb] bg-white px-4 py-3" {% if forloop.first and section.settings.open_first %}open{% endif %} {{ block.shopify_attributes }}>
        <summary class="flex cursor-pointer items-center justify-between gap-3 text-sm font-bold text-brand-ink">
          <span>{{ block.settings.question }}</span>
          {% render 'icons', name: 'chevron-down', class: 'accordion-chevron h-4 w-4 shrink-0 text-brand' %}
        </summary>
        <div class="mt-2 text-sm leading-relaxed text-slate-600">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}
  </div>
    {%- assign contact_page = pages['contact'] -%}
    <div class="mt-6 rounded-2xl bg-brand-soft p-5 text-center">
      <h2 class="text-base font-extrabold text-brand-ink">Still have an unanswered question?</h2>
      <p class="mt-1 text-xs text-slate-500">Our customer support team is here to assist you 24/7.</p>
      <a href="{% if contact_page %}{{ contact_page.url }}{% else %}/pages/contact{% endif %}" class="mt-3 inline-flex min-h-11 items-center rounded-xl bg-brand px-6 text-sm font-bold text-white hover:bg-brand-dark transition shadow-sm">Contact support</a>
    </div>
</div>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "checkbox", "id": "open_first", "label": "Expand first question by default", "default": true }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How long does delivery take?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Delivery timeframes depend on your location and are shown at checkout before you pay.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "FAQ", "blocks": [{ "type": "qa" }, { "type": "qa" }, { "type": "qa" }] }]
}
{% endschema %}
