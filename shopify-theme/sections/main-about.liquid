{% comment %}
  Kartzo About Us section — 100% customizable in Shopify Theme Editor.
  Supports:
  1. Hero section: Headline, subtitle, purpose badge, and hero image upload.
  2. Value Cards Blocks: Add, edit, or remove value pillars (Direct Factory Sourcing, 7-Day Returns, etc.).
  3. Trust Metrics: Edit key statistics (100K+ Orders, 4.8/5 Rating, etc.).
{% endcomment %}
{% render 'breadcrumbs', trail: 'About Us' %}

{%- assign hero_badge = section.settings.badge_text | default: 'Our Purpose' -%}
{%- assign hero_title = section.settings.heading | default: 'Precision Essentials, Honestly Priced.' -%}
{%- assign hero_desc = section.settings.description | default: 'Kartzo was established to cut through inflated retail markups and counterfeit uncertainty. We partner directly with verified component manufacturers to bring premium audio, smart wearables, lifestyle gear, and home goods directly to customers across India.' -%}
{%- assign hero_img = section.settings.hero_image -%}

<div class="pad site-max py-5 sm:py-8">
  <!-- Hero Intro -->
  <div class="grid items-center gap-6 lg:grid-cols-2 lg:gap-16">
    <div>
      <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-soft px-3 py-1 text-xs font-bold text-brand">
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 3 1.91 5.82a2 2 0 0 0 1.27 1.27L21 12l-5.82 1.91a2 2 0 0 0-1.27 1.27L12 21l-1.91-5.82a2 2 0 0 0-1.27-1.27L3 12l5.82-1.91a2 2 0 0 0 1.27-1.27L12 3z"/></svg>
        {{ hero_badge }}
      </span>
      <h1 class="mt-3 text-[1.7rem] font-extrabold leading-tight tracking-tight text-brand-ink sm:text-5xl">
        {{ hero_title }}
      </h1>
      <p class="mt-4 text-sm sm:text-base leading-relaxed text-slate-600">
        {{ hero_desc }}
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="{{ section.settings.button_1_link | default: routes.all_products_collection_url }}" class="inline-flex min-h-12 items-center gap-2 rounded-xl bg-brand px-6 text-xs sm:text-sm font-bold text-white shadow-[0_8px_20px_rgba(26,86,240,0.28)] hover:bg-brand-dark transition">
          <span>{{ section.settings.button_1_text | default: 'Explore Collection' }}</span>
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a href="{{ section.settings.button_2_link | default: pages['contact'].url | default: '/pages/contact' }}" class="inline-flex min-h-12 items-center rounded-xl border border-slate-200 bg-white px-6 text-xs sm:text-sm font-bold text-slate-700 hover:bg-slate-50 transition">
          {{ section.settings.button_2_text | default: 'Contact Support' }}
        </a>
      </div>
    </div>
    
    <div class="overflow-hidden rounded-3xl bg-[#F6F8FB] p-6 shadow-sm">
      {%- if hero_img -%}
        {{ hero_img | image_url: width: 1536 | image_tag: widths: '600, 1000, 1536', alt: hero_title, class: 'h-full w-full object-contain' }}
      {%- else -%}
        <img src="{{ 'hero.webp' | asset_url }}" alt="Kartzo Lifestyle Collection" class="h-full w-full object-contain" width="1536" height="1024">
      {%- endif -%}
    </div>
  </div>

  <!-- Core Brand Values -->
  <div class="mt-10 border-t border-slate-200 pt-8 sm:mt-20 sm:pt-14">
    <div class="max-w-xl">
      <span class="text-xs font-bold uppercase tracking-wider text-brand">{{ section.settings.values_badge | default: 'Our Commitments' }}</span>
      <h2 class="mt-1 text-2xl sm:text-3xl font-extrabold text-brand-ink">{{ section.settings.values_title | default: 'Built for Every Indian Shopper' }}</h2>
      <p class="mt-2 text-xs sm:text-sm text-slate-500">{{ section.settings.values_sub | default: 'How we maintain product integrity and customer trust at scale.' }}</p>
    </div>
    
    <div class="mt-5 grid gap-3 sm:mt-8 sm:gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm" {{ block.shopify_attributes }}>
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-soft text-brand">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
            </div>
            <h3 class="mt-4 text-base font-extrabold text-brand-ink">{{ block.settings.title }}</h3>
            <p class="mt-2 text-xs sm:text-sm leading-relaxed text-slate-500">{{ block.settings.description }}</p>
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-soft text-brand">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
          </div>
          <h3 class="mt-4 text-base font-extrabold text-brand-ink">Direct Factory Sourcing</h3>
          <p class="mt-2 text-xs sm:text-sm leading-relaxed text-slate-500">Every item is sourced directly from original manufacturers, eliminating intermediary markups and guaranteeing genuine factory seals.</p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-soft text-brand">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/><path d="M3 21v-5h5"/></svg>
          </div>
          <h3 class="mt-4 text-base font-extrabold text-brand-ink">7-Day Doorstep Returns</h3>
          <p class="mt-2 text-xs sm:text-sm leading-relaxed text-slate-500">If your purchase fails to meet expectations or sustains shipping transit damage, our logistics courier will pick it up directly from your door.</p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-soft text-brand">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 5h13v10H2zM15 9h4l3 3v3h-7z"/><circle cx="6" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></svg>
          </div>
          <h3 class="mt-4 text-base font-extrabold text-brand-ink">Pan-India Express Dispatch</h3>
          <p class="mt-2 text-xs sm:text-sm leading-relaxed text-slate-500">Orders are packed within 24 hours from regional fulfillment hubs in Mumbai and Delhi, reaching over 19,000 postal codes rapidly.</p>
        </div>
      {%- endif -%}
    </div>
  </div>

  <!-- Trust Metrics Strip -->
  {%- if section.settings.show_stats -%}
    <div class="mt-10 rounded-2xl bg-brand-ink p-5 text-white sm:mt-16 sm:p-12">
      <div class="grid gap-6 grid-cols-2 md:grid-cols-4 text-center">
        {%- if section.settings.stat_1_num != blank -%}
          <div>
            <span class="block text-3xl sm:text-4xl font-black text-white">{{ section.settings.stat_1_num }}</span>
            <span class="mt-1 block text-xs text-white/70">{{ section.settings.stat_1_label }}</span>
          </div>
        {%- endif -%}
        {%- if section.settings.stat_2_num != blank -%}
          <div>
            <span class="block text-3xl sm:text-4xl font-black text-white">{{ section.settings.stat_2_num }}</span>
            <span class="mt-1 block text-xs text-white/70">{{ section.settings.stat_2_label }}</span>
          </div>
        {%- endif -%}
        {%- if section.settings.stat_3_num != blank -%}
          <div>
            <span class="block text-3xl sm:text-4xl font-black text-white">{{ section.settings.stat_3_num }}</span>
            <span class="mt-1 block text-xs text-white/70">{{ section.settings.stat_3_label }}</span>
          </div>
        {%- endif -%}
        {%- if section.settings.stat_4_num != blank -%}
          <div>
            <span class="block text-3xl sm:text-4xl font-black text-white">{{ section.settings.stat_4_num }}</span>
            <span class="mt-1 block text-xs text-white/70">{{ section.settings.stat_4_label }}</span>
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "About Us",
  "settings": [
    {
      "type": "header",
      "content": "Hero Intro"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Our Purpose"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Precision Essentials, Honestly Priced."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Kartzo was established to cut through inflated retail markups and counterfeit uncertainty. We partner directly with verified component manufacturers to bring premium audio, smart wearables, lifestyle gear, and home goods directly to customers across India."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image (Upload or falls back to hero.webp)"
    },
    {
      "type": "text",
      "id": "button_1_text",
      "label": "Primary Button Text",
      "default": "Explore Collection"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "button_2_text",
      "label": "Secondary Button Text",
      "default": "Contact Support"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "header",
      "content": "Commitments & Values"
    },
    {
      "type": "text",
      "id": "values_badge",
      "label": "Values Badge",
      "default": "Our Commitments"
    },
    {
      "type": "text",
      "id": "values_title",
      "label": "Values Section Title",
      "default": "Built for Every Indian Shopper"
    },
    {
      "type": "textarea",
      "id": "values_sub",
      "label": "Values Subtitle",
      "default": "How we maintain product integrity and customer trust at scale."
    },
    {
      "type": "header",
      "content": "Trust Metrics Strip"
    },
    {
      "type": "checkbox",
      "id": "show_stats",
      "label": "Show Trust Metrics Strip",
      "default": true
    },
    {
      "type": "text",
      "id": "stat_1_num",
      "label": "Stat 1 Number",
      "default": "100K+"
    },
    {
      "type": "text",
      "id": "stat_1_label",
      "label": "Stat 1 Label",
      "default": "Verified Orders"
    },
    {
      "type": "text",
      "id": "stat_2_num",
      "label": "Stat 2 Number",
      "default": "1,200+"
    },
    {
      "type": "text",
      "id": "stat_2_label",
      "label": "Stat 2 Label",
      "default": "Tested Products"
    },
    {
      "type": "text",
      "id": "stat_3_num",
      "label": "Stat 3 Number",
      "default": "99.4%"
    },
    {
      "type": "text",
      "id": "stat_3_label",
      "label": "Stat 3 Label",
      "default": "On-Time Deliveries"
    },
    {
      "type": "text",
      "id": "stat_4_num",
      "label": "Stat 4 Number",
      "default": "4.8 / 5"
    },
    {
      "type": "text",
      "id": "stat_4_label",
      "label": "Stat 4 Label",
      "default": "Average Customer Rating"
    }
  ],
  "blocks": [
    {
      "type": "value_card",
      "name": "Commitment Pillar",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Pillar Title",
          "default": "Direct Factory Sourcing"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Every item is sourced directly from original manufacturers, eliminating intermediary markups and guaranteeing genuine factory seals."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Us"
    }
  ]
}
{% endschema %}
