{% comment %}
  Multi-purpose Store Policy & Company section.
  Renders page.content if provided by merchant, or rich standard store policy fallback.
{% endcomment %}

{%- assign policy_title = page.title -%}
{%- assign current_view = request.path -%}

{%- if policy_title == blank -%}
  {%- if current_view contains 'shipping' -%}
    {%- assign policy_title = 'Shipping Policy' -%}
  {%- elsif current_view contains 'return' -%}
    {%- assign policy_title = '7-Day Returns & Exchange Policy' -%}
  {%- elsif current_view contains 'cancel' -%}
    {%- assign policy_title = 'Order Cancellation Policy' -%}
  {%- elsif current_view contains 'privacy' -%}
    {%- assign policy_title = 'Privacy Policy' -%}
  {%- elsif current_view contains 'terms' -%}
    {%- assign policy_title = 'Terms of Service' -%}
  {%- elsif current_view contains 'about' -%}
    {%- assign policy_title = 'About ' | append: shop.name -%}
  {%- else -%}
    {%- assign policy_title = 'Customer Support & Store Policies' -%}
  {%- endif -%}
{%- endif -%}

{% render 'breadcrumbs', trail: policy_title %}

<div class="pad mx-auto w-full max-w-6xl pb-16 pt-4 sm:pt-6">
  <!-- Header Banner -->
  <div class="rounded-3xl bg-gradient-to-r from-[#041868] via-[#0a38b8] to-[#1a56f0] p-6 text-white sm:p-10 shadow-md">
    <div class="max-w-2xl">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-white/20 px-3 py-1 text-xs font-bold uppercase tracking-wider backdrop-blur-sm">
        {{ shop.name }} Help Center &amp; Policies
      </span>
      <h1 class="mt-3 text-2xl font-black tracking-tight sm:text-4xl">
        {{ policy_title }}
      </h1>
      <p class="mt-2 text-xs sm:text-sm text-white/85">
        Last updated: October 2026. Transparent terms designed to give you a trustworthy and secure shopping experience.
      </p>
    </div>
  </div>

  <div class="mt-8 grid gap-8 lg:grid-cols-[260px_minmax(0,1fr)]">
    <!-- Policy Navigation Sidebar -->
    <aside class="space-y-4">
      <div class="rounded-2xl border border-slate-200/80 bg-white p-4 shadow-sm">
        <p class="text-xs font-extrabold uppercase tracking-wider text-slate-400">Policy Directory</p>
        <nav class="mt-3 space-y-1" aria-label="Policy Directory">
          {%- assign p_shipping = pages['shipping-policy'].url | default: '/collections/all?view=shipping-policy' -%}
          {%- assign p_returns = pages['returns-policy'].url | default: '/collections/all?view=returns-policy' -%}
          {%- assign p_cancel = pages['cancellation-policy'].url | default: '/collections/all?view=cancellation-policy' -%}
          {%- assign p_privacy = pages['privacy-policy'].url | default: '/collections/all?view=privacy-policy' -%}
          {%- assign p_terms = pages['terms-conditions'].url | default: '/collections/all?view=terms-conditions' -%}
          {%- assign p_about = pages['about'].url | default: '/collections/all?view=about' -%}
          {%- assign p_faq = pages['faq'].url | default: '/collections/all?view=faq' -%}
          {%- assign p_contact = pages['contact'].url | default: '/pages/contact' -%}

          <a href="{{ p_shipping }}" class="flex items-center justify-between rounded-xl px-3 py-2 text-xs font-bold {% if policy_title contains 'Shipping' %}bg-brand text-white shadow-sm{% else %}text-slate-700 hover:bg-slate-50 hover:text-brand{% endif %} transition">
            <span>Shipping Policy</span>
            <span>→</span>
          </a>
          <a href="{{ p_returns }}" class="flex items-center justify-between rounded-xl px-3 py-2 text-xs font-bold {% if policy_title contains 'Return' %}bg-brand text-white shadow-sm{% else %}text-slate-700 hover:bg-slate-50 hover:text-brand{% endif %} transition">
            <span>7-Day Returns</span>
            <span>→</span>
          </a>
          <a href="{{ p_cancel }}" class="flex items-center justify-between rounded-xl px-3 py-2 text-xs font-bold {% if policy_title contains 'Cancel' %}bg-brand text-white shadow-sm{% else %}text-slate-700 hover:bg-slate-50 hover:text-brand{% endif %} transition">
            <span>Cancellation Policy</span>
            <span>→</span>
          </a>
          <a href="{{ p_privacy }}" class="flex items-center justify-between rounded-xl px-3 py-2 text-xs font-bold {% if policy_title contains 'Privacy' %}bg-brand text-white shadow-sm{% else %}text-slate-700 hover:bg-slate-50 hover:text-brand{% endif %} transition">
            <span>Privacy Policy</span>
            <span>→</span>
          </a>
          <a href="{{ p_terms }}" class="flex items-center justify-between rounded-xl px-3 py-2 text-xs font-bold {% if policy_title contains 'Terms' %}bg-brand text-white shadow-sm{% else %}text-slate-700 hover:bg-slate-50 hover:text-brand{% endif %} transition">
            <span>Terms of Service</span>
            <span>→</span>
          </a>
          <a href="{{ p_about }}" class="flex items-center justify-between rounded-xl px-3 py-2 text-xs font-bold {% if policy_title contains 'About' %}bg-brand text-white shadow-sm{% else %}text-slate-700 hover:bg-slate-50 hover:text-brand{% endif %} transition">
            <span>About {{ shop.name }}</span>
            <span>→</span>
          </a>
          <a href="{{ p_faq }}" class="flex items-center justify-between rounded-xl px-3 py-2 text-xs font-bold {% if policy_title contains 'FAQ' %}bg-brand text-white shadow-sm{% else %}text-slate-700 hover:bg-slate-50 hover:text-brand{% endif %} transition">
            <span>Help &amp; FAQs</span>
            <span>→</span>
          </a>
          <a href="{{ p_contact }}" class="flex items-center justify-between rounded-xl px-3 py-2 text-xs font-bold text-slate-700 hover:bg-slate-50 hover:text-brand transition">
            <span>Contact Support</span>
            <span>→</span>
          </a>
        </nav>
      </div>

      <!-- Quick Assistance Card -->
      <div class="rounded-2xl bg-brand-soft/80 p-4 border border-[#d7e3f8]">
        <h2 class="text-xs font-extrabold uppercase tracking-wide text-brand-ink">Need Immediate Help?</h2>
        <p class="mt-1 text-xs text-slate-600 leading-relaxed">Our support executives are available 24/7 to assist with tracking, returns, or queries.</p>
        <div class="mt-3 space-y-1.5 text-xs font-semibold text-brand">
          <p><a href="mailto:{{ settings.support_email | default: 'support@kartzo.com' }}" class="hover:underline">{{ settings.support_email | default: 'support@kartzo.com' }}</a></p>
          <p><a href="tel:{{ settings.support_phone | default: '+919876543210' }}" class="hover:underline">{{ settings.support_phone | default: '+91 98765 43210' }}</a></p>
        </div>
      </div>
    </aside>

    <!-- Main Content Area -->
    <main class="rounded-3xl border border-slate-200/80 bg-white p-6 sm:p-10 shadow-sm leading-relaxed text-slate-700 space-y-6">
      {%- if page.content != blank -%}
        <div class="prose max-w-none text-sm text-slate-700 leading-relaxed">
          {{ page.content }}
        </div>
      {%- else -%}
        {%- if policy_title contains 'Shipping' -%}
          <div>
            <h2 class="text-lg font-black text-brand-ink">1. Processing &amp; Dispatch Timeline</h2>
            <p class="mt-2 text-sm text-slate-600">All orders placed on {{ shop.name }} are processed and packed within 24 to 48 hours (excluding Sundays and national holidays). You will receive an SMS and email notification with your tracking number once your package has been handed over to our courier partner.</p>
          </div>
          <div>
            <h2 class="text-lg font-black text-brand-ink">2. Delivery Timeframes</h2>
            <ul class="mt-2 list-disc pl-5 space-y-1 text-sm text-slate-600">
              <li><strong>Metro Cities:</strong> Delivered within 2 to 4 business days.</li>
              <li><strong>Rest of India / Tier 2 &amp; 3:</strong> Delivered within 4 to 7 business days.</li>
              <li><strong>Express Delivery:</strong> Eligible PIN codes qualify for 24-48 hour expedited delivery.</li>
            </ul>
          </div>
          <div>
            <h2 class="text-lg font-black text-brand-ink">3. Shipping Charges</h2>
            <p class="mt-2 text-sm text-slate-600">We offer <strong>Free Standard Shipping</strong> on all prepaid orders across the country. Cash on delivery (COD) orders may carry a minimal handling fee of ₹49 which is transparently displayed at checkout.</p>
          </div>
          <div>
            <h2 class="text-lg font-black text-brand-ink">4. Order Tracking</h2>
            <p class="mt-2 text-sm text-slate-600">You can track your package anytime directly through our <a href="{{ routes.all_products_collection_url }}?view=tracking" class="text-brand font-bold hover:underline">Track Your Parcel</a> portal using your Order ID or tracking AWB number.</p>
          </div>

        {%- elsif policy_title contains 'Return' -%}
          <div>
            <h2 class="text-lg font-black text-brand-ink">1. 7-Day Hassle-Free Returns &amp; Exchanges</h2>
            <p class="mt-2 text-sm text-slate-600">We want you to love what you bought! If you are not completely satisfied with your purchase, you may initiate a return or exchange request within <strong>7 days</strong> of parcel delivery.</p>
          </div>
          <div>
            <h2 class="text-lg font-black text-brand-ink">2. Return Eligibility Criteria</h2>
            <ul class="mt-2 list-disc pl-5 space-y-1 text-sm text-slate-600">
              <li>Item must be unused, unwashed, and in its original condition.</li>
              <li>Original brand tags, packaging boxes, and warranty cards must be intact.</li>
              <li>For electronic items, the serial number on the box must match the unit.</li>
            </ul>
          </div>
          <div>
            <h2 class="text-lg font-black text-brand-ink">3. Doorstep Pickup &amp; Refund Processing</h2>
            <p class="mt-2 text-sm text-slate-600">Once your return request is approved, our courier partner will pick up the package from your doorstep within 48 hours. After quality inspection at our fulfillment facility, your refund is credited back to your original payment method (or UPI/Bank account for COD) within 3-5 business days.</p>
          </div>

        {%- elsif policy_title contains 'Cancel' -%}
          <div>
            <h2 class="text-lg font-black text-brand-ink">1. How to Cancel Your Order</h2>
            <p class="mt-2 text-sm text-slate-600">You can cancel your order any time before it has been dispatched from our fulfillment warehouse. Simply visit your Account section, navigate to Orders, and tap <strong>Cancel Order</strong>.</p>
          </div>
          <div>
            <h2 class="text-lg font-black text-brand-ink">2. Post-Dispatch Cancellation</h2>
            <p class="mt-2 text-sm text-slate-600">If your package has already been handed over to the courier, cancellation cannot be done online. However, you can simply refuse delivery when the courier partner arrives at your address. Once the package returns to our warehouse, a full refund will be processed.</p>
          </div>
          <div>
            <h2 class="text-lg font-black text-brand-ink">3. Refund for Cancelled Orders</h2>
            <p class="mt-2 text-sm text-slate-600">For prepaid orders cancelled before dispatch, 100% of the amount is automatically refunded back to the source bank account, credit/debit card, or wallet within 24 to 48 hours.</p>
          </div>

        {%- elsif policy_title contains 'Privacy' -%}
          <div>
            <h2 class="text-lg font-black text-brand-ink">1. Information We Collect</h2>
            <p class="mt-2 text-sm text-slate-600">{{ shop.name }} respects your privacy. When you place an order, create an account, or browse our website, we only collect information necessary to fulfill orders and provide support (e.g. name, shipping address, email, phone number).</p>
          </div>
          <div>
            <h2 class="text-lg font-black text-brand-ink">2. How We Protect Your Data</h2>
            <p class="mt-2 text-sm text-slate-600">All payment transactions are encrypted with 256-bit SSL protocols handled exclusively by PCI-DSS certified payment gateways. We never store credit/debit card numbers or CVV details on our servers.</p>
          </div>
          <div>
            <h2 class="text-lg font-black text-brand-ink">3. No Third-Party Selling</h2>
            <p class="mt-2 text-sm text-slate-600">We do not sell, rent, or lease your personal customer data to any third-party marketing companies under any circumstances.</p>
          </div>

        {%- elsif policy_title contains 'Terms' -%}
          <div>
            <h2 class="text-lg font-black text-brand-ink">1. General Terms of Use</h2>
            <p class="mt-2 text-sm text-slate-600">By browsing, purchasing, or using services on {{ shop.name }}, you agree to be bound by these Terms of Service and all applicable national e-commerce regulations.</p>
          </div>
          <div>
            <h2 class="text-lg font-black text-brand-ink">2. Product Pricing &amp; Accuracy</h2>
            <p class="mt-2 text-sm text-slate-600">All prices listed are in Indian Rupees (INR) and are inclusive of GST taxes unless specified otherwise. We reserve the right to correct any typographical pricing errors prior to order dispatch.</p>
          </div>
          <div>
            <h2 class="text-lg font-black text-brand-ink">3. Authentic Sourcing Guarantee</h2>
            <p class="mt-2 text-sm text-slate-600">All products listed on {{ shop.name }} are 100% genuine and sourced directly from verified authorized manufacturers and distributors.</p>
          </div>

        {%- else -%}
          <!-- About Company fallback -->
          <div>
            <h2 class="text-lg font-black text-brand-ink">Welcome to {{ shop.name }}</h2>
            <p class="mt-2 text-sm text-slate-600">{{ shop.name }} is committed to delivering curated essentials across consumer technology, fashion, and home lifestyle with guaranteed authentic sourcing, fair pricing, and direct doorstep returns.</p>
          </div>
          <div class="grid gap-4 sm:grid-cols-3 pt-2">
            <div class="rounded-2xl bg-slate-50 p-4 border border-slate-100">
              <span class="text-xl">🏆</span>
              <h3 class="mt-2 text-xs font-bold text-brand-ink">Verified Authenticity</h3>
              <p class="mt-1 text-[11px] text-slate-500">Every item is 100% genuine with direct manufacturer warranty.</p>
            </div>
            <div class="rounded-2xl bg-slate-50 p-4 border border-slate-100">
              <span class="text-xl">🚀</span>
              <h3 class="mt-2 text-xs font-bold text-brand-ink">Express Shipping</h3>
              <p class="mt-1 text-[11px] text-slate-500">Fast delivery across 19,000+ PIN codes nationwide.</p>
            </div>
            <div class="rounded-2xl bg-slate-50 p-4 border border-slate-100">
              <span class="text-xl">🛡️</span>
              <h3 class="mt-2 text-xs font-bold text-brand-ink">Customer First</h3>
              <p class="mt-1 text-[11px] text-slate-500">Dedicated 24/7 support and 7-day doorstep return policy.</p>
            </div>
          </div>
        {%- endif -%}
      {%- endif -%}
    </main>
  </div>
</div>

{% schema %}
{
  "name": "Store Policy",
  "settings": [],
  "presets": [{ "name": "Store Policy" }]
}
{% endschema %}
