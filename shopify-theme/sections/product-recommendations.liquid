{% comment %} Shopify product recommendations (replaces hardcoded "Similar picks"). {% endcomment %}
{%- if section.settings.enable -%}
  <div class="pad mx-auto w-full max-w-7xl pb-10" data-product-recommendations data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}">
    {%- if recommendations.performed and recommendations.products_count > 0 -%}
      <div class="mb-5 flex items-center justify-between gap-3">
        <h2 class="text-xl font-extrabold tracking-tight sm:text-2xl">{{ section.settings.heading | default: 'Similar picks' }}</h2>
        <a href="{{ routes.all_products_collection_url }}" class="text-sm font-bold text-brand hover:underline">{{ 'general.view_all' | t }} →</a>
      </div>
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6">
        {%- for rec in recommendations.products -%}
          {% render 'product-card', product: rec %}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Product recommendations",
  "settings": [
    { "type": "checkbox", "id": "enable", "label": "Enable recommendations", "default": true },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Similar picks" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 10, "step": 1, "default": 6 }
  ],
  "presets": [{ "name": "Product recommendations" }]
}
{% endschema %}
