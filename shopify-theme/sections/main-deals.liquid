{% comment %}
  Flash Deals page — hero countdown banner + deal filters + discount product grid.
{% endcomment %}
{% render 'breadcrumbs', trail: 'Flash Deals' %}

<div class="pad mx-auto w-full max-w-7xl pb-16 pt-4 sm:pt-6">
  <!-- Deals Hero Banner -->
  <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-[#041868] via-[#0b47e8] to-[#1a56f0] p-6 text-white sm:p-10 shadow-lg">
    <div class="relative z-10 max-w-2xl">
      <div class="inline-flex items-center gap-2 rounded-full bg-white/20 px-3 py-1 text-xs font-bold uppercase tracking-wider backdrop-blur-sm">
        <span class="flex h-2 w-2 rounded-full bg-rose-400 animate-pulse"></span>
        Limited Time Flash Sale
      </div>
      <h1 class="mt-3 text-2xl font-black tracking-tight sm:text-4xl lg:text-5xl">
        Mega Deals &amp; Daily Steals
      </h1>
      <p class="mt-2 text-sm text-white/85 sm:text-base">
        Up to 60% OFF on premium headphones, watches, footwear, home essentials, and smart gadgets. Grab them before stocks run out!
      </p>

      <!-- Countdown Timer -->
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <span class="text-xs font-extrabold uppercase tracking-wider text-white/70">Sale Ends In:</span>
        <div class="flex items-center gap-2 text-brand-ink" data-countdown="2026-12-31T23:59">
          <div class="flex min-w-[52px] flex-col items-center rounded-xl bg-white px-2.5 py-1.5 shadow-sm">
            <span class="text-base sm:text-lg font-black leading-none" data-cd-h>18</span>
            <span class="text-[9px] font-bold uppercase tracking-wider text-slate-500">Hours</span>
          </div>
          <span class="text-lg font-bold text-white">:</span>
          <div class="flex min-w-[52px] flex-col items-center rounded-xl bg-white px-2.5 py-1.5 shadow-sm">
            <span class="text-base sm:text-lg font-black leading-none" data-cd-m>45</span>
            <span class="text-[9px] font-bold uppercase tracking-wider text-slate-500">Mins</span>
          </div>
          <span class="text-lg font-bold text-white">:</span>
          <div class="flex min-w-[52px] flex-col items-center rounded-xl bg-white px-2.5 py-1.5 shadow-sm">
            <span class="text-base sm:text-lg font-black leading-none text-rose-600" data-cd-s>30</span>
            <span class="text-[9px] font-bold uppercase tracking-wider text-slate-500">Secs</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Decorative Badge -->
    <div class="pointer-events-none absolute -right-6 -bottom-6 hidden h-48 w-48 rounded-full bg-white/10 blur-2xl lg:block" aria-hidden="true"></div>
  </div>

  <!-- Deals Quick Filter Tabs -->
  <div class="mt-8 flex flex-wrap items-center justify-between gap-4 border-b border-slate-100 pb-4">
    <div class="flex flex-wrap items-center gap-2">
      <a href="{{ request.path }}?view=deals" class="rounded-full bg-brand px-4 py-2 text-xs font-bold text-white shadow-sm">
        All Deals
      </a>
      <a href="{{ routes.all_products_collection_url }}?filter.v.price.lte=1000" class="rounded-full border border-slate-200 bg-white px-4 py-2 text-xs font-semibold text-slate-700 hover:border-brand hover:text-brand transition">
        Under ₹1,000
      </a>
      {%- assign el_col = collections['electronics'] -%}
      <a href="{{ el_col.url | default: routes.all_products_collection_url }}" class="rounded-full border border-slate-200 bg-white px-4 py-2 text-xs font-semibold text-slate-700 hover:border-brand hover:text-brand transition">
        Electronics Deals
      </a>
      {%- assign fa_col = collections['fashion'] -%}
      <a href="{{ fa_col.url | default: routes.all_products_collection_url }}" class="rounded-full border border-slate-200 bg-white px-4 py-2 text-xs font-semibold text-slate-700 hover:border-brand hover:text-brand transition">
        Fashion Deals
      </a>
      {%- assign ho_col = collections['home'] -%}
      <a href="{{ ho_col.url | default: routes.all_products_collection_url }}" class="rounded-full border border-slate-200 bg-white px-4 py-2 text-xs font-semibold text-slate-700 hover:border-brand hover:text-brand transition">
        Home &amp; Living
      </a>
    </div>
    <p class="text-xs font-bold text-slate-500">
      ⚡ Hand-picked deals updated daily
    </p>
  </div>

  <!-- Products Grid -->
  <div class="mt-6">
    {%- assign deals_collection = collections['frontpage'] | default: collections['all'] -%}
    {%- if deals_collection and deals_collection.products_count > 0 -%}
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 xl:grid-cols-4">
        {%- for product in deals_collection.products limit: 16 -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <!-- Demo Deals Grid -->
      {%- assign demo_titles = 'Wireless Noise Canceling Headphones,Smart Fitness Watch,Ultra Light Running Shoes,Smartphone 128GB AMOLED,Digital Air Fryer 5.5L,Waterproof Laptop Backpack,Mechanical Gaming Keyboard,Stainless Steel Water Bottle' | split: ',' -%}
      {%- assign demo_images = 'p-headphones.webp,p-watch.webp,p-shoes.webp,p-phone.webp,p-fryer.webp,p-backpack.webp,p-headphones.webp,p-watch.webp' | split: ',' -%}
      {%- assign demo_prices = '₹2,799,₹3,499,₹2,399,₹54,999,₹4,499,₹1,299,₹3,199,₹899' | split: ',' -%}
      {%- assign demo_compares = '₹3,999,₹5,832,₹3,998,₹73,332,₹5,999,₹1,856,₹4,999,₹1,499' | split: ',' -%}
      {%- assign demo_discounts = '-30%,-40%,-40%,-25%,-25%,-30%,-36%,-40%' | split: ',' -%}
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 xl:grid-cols-4">
        {%- for title in demo_titles -%}
          {%- assign idx = forloop.index0 -%}
          <article class="product-card product relative flex h-full flex-col justify-between rounded-2xl border border-[#e6eefb] bg-white p-3 shadow-[0_2px_10px_rgba(15,50,120,0.04)] transition duration-200 hover:border-[#b9d0ff] hover:shadow-card">
            <div class="flex flex-col">
              <div class="relative w-full">
                <span class="absolute left-2.5 top-2.5 z-20 rounded-md bg-[#ef3b3b] px-1.5 py-0.5 text-[10px] font-extrabold text-white">{{ demo_discounts[idx] }}</span>
                <button
                  type="button"
                  class="wish absolute right-2.5 top-2.5 z-20 flex h-9 w-9 items-center justify-center rounded-full bg-white text-brand shadow-md transition hover:scale-105"
                  aria-pressed="false"
                  data-wishlist-toggle="deal-demo-{{ forloop.index }}"
                  data-wish-title="{{ title }}"
                  data-wish-image="{{ demo_images[idx] | asset_url }}"
                  data-wish-price="{{ demo_prices[idx] }}"
                  data-wish-url="{{ routes.all_products_collection_url }}"
                  aria-label="Add {{ title }} to wishlist"
                >
                  {% render 'icons', name: 'heart', class: 'h-4 w-4' %}
                </button>
                <a href="{{ routes.all_products_collection_url }}" class="image-wrap relative flex h-36 w-full items-center justify-center overflow-hidden rounded-xl bg-[#f8fbff] p-2">
                  <img src="{{ demo_images[idx] | asset_url }}" alt="{{ title }}" width="500" height="500" class="max-h-full max-w-full object-contain transition duration-200 hover:scale-105" loading="lazy">
                </a>
              </div>
              <div class="mt-2.5 flex flex-col flex-grow">
                <h3 class="product-title text-[13px] font-bold leading-snug line-clamp-2 min-h-[2.6rem] text-brand-ink">
                  <a href="{{ routes.all_products_collection_url }}" class="hover:text-brand">{{ title }}</a>
                </h3>
                <div class="product-rating mt-1 flex items-center gap-1 text-[11px] text-[#8b97ad]">
                  {% render 'rating', value: 4.8 %}
                  <span class="text-[10px] text-slate-400">4.8 (2.4K)</span>
                </div>
                <p class="product-price-row mt-1 flex items-baseline justify-between gap-2">
                  <span class="text-[15px] font-extrabold text-brand-ink">{{ demo_prices[idx] }}</span>
                  <span class="text-[11px] text-[#a8b1c2] line-through">{{ demo_compares[idx] }}</span>
                </p>
              </div>
            </div>
            <div class="product-action mt-2.5">
              <a href="{{ routes.all_products_collection_url }}" class="add-cart inline-flex min-h-10 w-full items-center justify-center rounded-lg bg-brand text-xs font-bold text-white hover:bg-brand-dark transition">
                Shop Deal
              </a>
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Deals",
  "settings": [],
  "presets": [{ "name": "Deals" }]
}
{% endschema %}
