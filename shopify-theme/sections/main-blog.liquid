{% comment %} Blog listing — featured article + grid, real blog data. {% endcomment %}
{%- paginate blog.articles by section.settings.per_page -%}
  {% render 'breadcrumbs', trail: blog.title %}

  <div class="pad mx-auto w-full max-w-7xl pb-12 pt-4 sm:pt-6">
    <h1 class="text-2xl font-extrabold tracking-tight sm:text-3xl">{{ blog.title }}</h1>

    {%- if blog.articles.size > 0 -%}
      {%- assign featured = blog.articles.first -%}
      <a href="{{ featured.url }}" class="group mt-5 grid overflow-hidden rounded-3xl border border-[#e6eefb] bg-white lg:grid-cols-2">
        {%- if featured.image -%}
          <span class="block aspect-[16/9] overflow-hidden bg-[#F6F8FB] lg:aspect-auto lg:min-h-[280px]">
            {{ featured.image | image_url: width: 1400 | image_tag: widths: '750, 1400', fetchpriority: 'high', alt: '', class: 'h-full w-full object-cover transition duration-200 group-hover:scale-105' }}
          </span>
        {%- endif -%}
        <span class="flex flex-col justify-center p-5 sm:p-8">
          <span class="text-[11px] font-bold uppercase tracking-wider text-brand">Featured guide</span>
          <span class="mt-2 text-xl font-extrabold leading-tight sm:text-2xl group-hover:text-brand">{{ featured.title }}</span>
          {%- if featured.excerpt != blank -%}
            <span class="mt-2 line-clamp-3 text-sm text-slate-600">{{ featured.excerpt | strip_html }}</span>
          {%- endif -%}
          <span class="mt-3 text-xs font-semibold text-slate-400">{{ featured.published_at | date: '%d %b %Y' }} · {{ featured.author }}</span>
        </span>
      </a>

      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {%- for article in blog.articles offset: 1 -%}
          <article class="overflow-hidden rounded-2xl border border-[#e6eefb] bg-white transition hover:border-[#b9d0ff] hover:shadow-card">
            <a href="{{ article.url }}" class="block aspect-[16/9] overflow-hidden bg-[#F6F8FB]" tabindex="-1" aria-hidden="true">
              {%- if article.image -%}
                {{ article.image | image_url: width: 800 | image_tag: widths: '400, 800', loading: 'lazy', alt: '', class: 'h-full w-full object-cover' }}
              {%- endif -%}
            </a>
            <div class="p-4">
              <p class="text-[11px] font-bold uppercase tracking-wider text-slate-400">{{ article.published_at | date: '%d %b %Y' }}</p>
              <h2 class="mt-1 text-sm font-extrabold leading-snug"><a href="{{ article.url }}" class="hover:text-brand">{{ article.title }}</a></h2>
              {%- if article.excerpt != blank -%}
                <p class="mt-1 line-clamp-2 text-xs text-slate-500">{{ article.excerpt | strip_html }}</p>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="mt-8 flex items-center justify-center gap-2" aria-label="Pagination">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}" class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-xl border border-slate-200 px-3 text-sm font-bold hover:border-brand hover:text-brand" aria-label="Previous page">←</a>
          {%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}" class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-xl border border-slate-200 px-3 text-sm font-bold hover:border-brand hover:text-brand">{{ part.title }}</a>
            {%- else -%}
              <span {% if part.title == paginate.current_page %}aria-current="page"{% endif %} class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-xl px-3 text-sm font-bold {% if part.title == paginate.current_page %}bg-brand text-white{% else %}text-slate-500{% endif %}">{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}" class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-xl border border-slate-200 px-3 text-sm font-bold hover:border-brand hover:text-brand" aria-label="Next page">→</a>
          {%- endif -%}
        </nav>
      {%- endif -%}
    {%- else -%}
      <p class="mt-5 rounded-xl bg-brand-soft px-4 py-3 text-sm font-semibold text-brand-dark">Publish articles to this blog to fill this page.</p>
    {%- endif -%}
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Blog",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Articles per page", "min": 4, "max": 24, "step": 1, "default": 7 }
  ],
  "presets": [{ "name": "Blog" }]
}
{% endschema %}
