{% comment %}
  Kartzo Contact section — 100% faithful to contact.html prototype with Shopify native contact form and customizable schema.
{% endcomment %}
{% render 'breadcrumbs', trail: 'Contact Support' %}

<div class="pad site-max py-5 sm:py-8">
  <div class="mb-5 border-b border-slate-200/80 pb-4 sm:mb-8 sm:pb-6">
    <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-soft px-3 py-1 text-xs font-bold text-brand">
      <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3M12 17h.01"/></svg>
      {{ section.settings.badge | default: 'Customer Help Desk' }}
    </span>
    <h1 class="mt-2 text-[1.45rem] font-extrabold leading-tight tracking-tight text-brand-ink sm:text-4xl">
      {{ section.settings.heading | default: "We're Here to Help" }}
    </h1>
    <p class="mt-1 text-xs sm:text-sm text-slate-500">{{ section.settings.subtext | default: 'Have a question regarding your order, delivery timeline, or returns? Reach out anytime.' }}</p>
  </div>

  <div class="grid gap-5 lg:grid-cols-[1fr_380px] lg:gap-8">
    
    <!-- Contact Form -->
    <div class="rounded-2xl border border-slate-200/80 bg-white p-4 shadow-sm sm:p-8">
      <h2 class="text-base sm:text-lg font-extrabold text-brand-ink">{{ section.settings.form_title | default: 'Send Us a Message' }}</h2>
      <p class="mt-1 text-xs text-slate-500">{{ section.settings.form_sub | default: 'Our customer care team typically responds within 2 business hours.' }}</p>

      {%- form 'contact', id: 'contact-form', class: 'mt-6 space-y-4' -%}
        {%- if form.posted_successfully? -%}
          <div class="rounded-xl bg-emerald-50 p-4 text-xs sm:text-sm font-bold text-emerald-700 border border-emerald-200">
            Thank you! Your message has been received. Our support team will get back to you shortly.
          </div>
        {%- elsif form.errors -%}
          <div class="rounded-xl bg-rose-50 p-4 text-xs sm:text-sm font-bold text-rose-700 border border-rose-200">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block text-xs font-bold text-slate-600">Full Name *
            <input required name="contact[name]" class="mt-1.5 min-h-11 w-full rounded-xl border border-slate-200 bg-slate-50/50 px-3.5 text-xs sm:text-sm font-semibold text-brand-ink outline-none focus:border-brand focus:bg-white transition" placeholder="e.g. Rahul Sharma">
          </label>
          <label class="block text-xs font-bold text-slate-600">Email Address *
            <input required type="email" name="contact[email]" class="mt-1.5 min-h-11 w-full rounded-xl border border-slate-200 bg-slate-50/50 px-3.5 text-xs sm:text-sm font-semibold text-brand-ink outline-none focus:border-brand focus:bg-white transition" placeholder="e.g. rahul@example.com">
          </label>
        </div>
        
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block text-xs font-bold text-slate-600">Phone Number (Optional)
            <input name="contact[phone]" class="mt-1.5 min-h-11 w-full rounded-xl border border-slate-200 bg-slate-50/50 px-3.5 text-xs sm:text-sm font-semibold text-brand-ink outline-none focus:border-brand focus:bg-white transition" placeholder="+91 98765 43210">
          </label>
          <label class="block text-xs font-bold text-slate-600">Order ID (If Applicable)
            <input name="order_id" class="mt-1.5 min-h-11 w-full rounded-xl border border-slate-200 bg-slate-50/50 px-3.5 text-xs sm:text-sm font-semibold text-brand-ink outline-none focus:border-brand focus:bg-white transition" placeholder="e.g. KZ-10482">
          </label>
        </div>

        <label class="block text-xs font-bold text-slate-600">Subject *
          <input type="hidden" name="contact[subject]" id="subject-input" value="tracking">
          <span class="relative mt-1.5 block" data-subject-wrap>
            <button type="button" id="subject-btn" aria-haspopup="listbox" aria-expanded="false" class="flex min-h-11 w-full items-center justify-between gap-2 rounded-xl border border-slate-200 bg-slate-50/50 px-3.5 text-xs sm:text-sm font-semibold text-brand-ink outline-none transition focus:border-brand focus:bg-white">
              <span id="subject-label" class="truncate">Order Tracking &amp; Delivery Inquiry</span>
              <svg class="h-4 w-4 shrink-0 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <span id="subject-menu" role="listbox" aria-label="Message subject" class="absolute inset-x-0 top-full z-30 mt-2 hidden overflow-hidden rounded-xl border border-slate-200 bg-white py-1 shadow-xl">
              <button type="button" role="option" data-subject="tracking" aria-selected="true" class="subject-option flex min-h-11 w-full items-center justify-between gap-2 px-3.5 text-xs sm:text-sm font-semibold transition bg-brand-soft text-brand">
                <span class="truncate">Order Tracking & Delivery Inquiry</span>
                <svg class="subject-tick h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
              </button>
              <button type="button" role="option" data-subject="return" aria-selected="false" class="subject-option flex min-h-11 w-full items-center justify-between gap-2 px-3.5 text-xs sm:text-sm font-semibold transition text-slate-600 hover:bg-slate-50">
                <span class="truncate">Return or Doorstep Replacement</span>
                <svg class="subject-tick h-4 w-4 shrink-0 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
              </button>
              <button type="button" role="option" data-subject="warranty" aria-selected="false" class="subject-option flex min-h-11 w-full items-center justify-between gap-2 px-3.5 text-xs sm:text-sm font-semibold transition text-slate-600 hover:bg-slate-50">
                <span class="truncate">Product Warranty Claim</span>
                <svg class="subject-tick h-4 w-4 shrink-0 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
              </button>
              <button type="button" role="option" data-subject="billing" aria-selected="false" class="subject-option flex min-h-11 w-full items-center justify-between gap-2 px-3.5 text-xs sm:text-sm font-semibold transition text-slate-600 hover:bg-slate-50">
                <span class="truncate">Payment or Invoice Assistance</span>
                <svg class="subject-tick h-4 w-4 shrink-0 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
              </button>
              <button type="button" role="option" data-subject="general" aria-selected="false" class="subject-option flex min-h-11 w-full items-center justify-between gap-2 px-3.5 text-xs sm:text-sm font-semibold transition text-slate-600 hover:bg-slate-50">
                <span class="truncate">General Feedback</span>
                <svg class="subject-tick h-4 w-4 shrink-0 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
              </button>
            </span>
          </span>
        </label>

        <label class="block text-xs font-bold text-slate-600">Message Details *
          <textarea required name="contact[body]" rows="4" class="mt-1.5 w-full rounded-xl border border-slate-200 bg-slate-50/50 p-3.5 text-xs sm:text-sm font-semibold text-brand-ink outline-none focus:border-brand focus:bg-white transition" placeholder="Describe your inquiry in detail..."></textarea>
        </label>

        <button type="submit" id="contact-submit" class="flex min-h-12 w-full sm:w-auto items-center justify-center gap-2 rounded-xl bg-brand px-8 text-xs sm:text-sm font-bold text-white shadow-md hover:bg-brand-dark transition active:scale-[0.98]">
          <span>Send Message</span>
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </button>
        <p id="contact-success" class="mt-3 hidden text-xs font-bold text-emerald-600">Thank you! Your message has been received. Ticket #KZ-HELP-2819 opened.</p>
      {%- endform -%}
    </div>

    <!-- Contact Channels Aside -->
    <aside class="space-y-4">
      <div class="rounded-2xl border border-slate-200/80 bg-white p-4 shadow-sm sm:p-6">
        <h3 class="text-xs font-extrabold uppercase tracking-wider text-brand-ink">Direct Support Channels</h3>
        <div class="mt-4 space-y-4 text-xs sm:text-sm text-slate-600">
          <div class="flex items-start gap-3">
            <span class="text-brand shrink-0 mt-0.5"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></span>
            <div>
              <p class="font-bold text-brand-ink">Email Support</p>
              {%- assign c_email = section.settings.email | default: settings.support_email | default: 'support@kartzo.com' -%}
              <a href="mailto:{{ c_email }}" class="text-brand hover:underline">{{ c_email }}</a>
              <p class="text-[11px] text-slate-400">{{ section.settings.email_sub | default: 'Response within 2-4 hours' }}</p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <span class="text-brand shrink-0 mt-0.5"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg></span>
            <div>
              <p class="font-bold text-brand-ink">Helpline</p>
              {%- assign c_phone = section.settings.phone | default: settings.support_phone | default: '+91 800-123-4567' -%}
              <a href="tel:{{ c_phone | remove: ' ' | remove: '-' }}" class="text-brand hover:underline">{{ c_phone }}</a>
              <p class="text-[11px] text-slate-400">{{ section.settings.hours | default: 'Mon - Sat, 9:00 AM - 7:00 PM IST' }}</p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <span class="text-brand shrink-0 mt-0.5"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg></span>
            <div>
              <p class="font-bold text-brand-ink">Location</p>
              <p class="text-slate-500 leading-relaxed">{{ section.settings.address | default: '709, Kundan Nagar<br>Indore, Madhya Pradesh 452013' }}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- FAQ Shortcut Box -->
      <div class="rounded-2xl border border-slate-200/80 bg-slate-50/70 p-6">
        <h3 class="text-sm font-bold text-brand-ink">Quick Answers</h3>
        <p class="mt-1 text-xs text-slate-500">Need instant answers about tracking, refunds, or PIN coverage?</p>
        <a href="{{ pages['faq'].url | default: '/pages/faq' }}" class="mt-4 inline-flex items-center gap-1.5 text-xs font-bold text-brand hover:underline">
          <span>Visit our Help Center &amp; FAQs</span>
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
    </aside>
  </div>
</div>

{% schema %}
{
  "name": "Contact Us",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "Customer Help Desk"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We're Here to Help"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Have a question regarding your order, delivery timeline, or returns? Reach out anytime."
    },
    {
      "type": "text",
      "id": "form_title",
      "label": "Form Heading",
      "default": "Send Us a Message"
    },
    {
      "type": "textarea",
      "id": "form_sub",
      "label": "Form Subtext",
      "default": "Our customer care team typically responds within 2 business hours."
    },
    {
      "type": "header",
      "content": "Support Channels Info"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Support Email",
      "default": "support@kartzo.com"
    },
    {
      "type": "text",
      "id": "email_sub",
      "label": "Email Subtext",
      "default": "Response within 2-4 hours"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Support Phone",
      "default": "+91 800-123-4567"
    },
    {
      "type": "text",
      "id": "hours",
      "label": "Operating Hours",
      "default": "Mon - Sat, 9:00 AM - 7:00 PM IST"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Location Address (HTML allowed)",
      "default": "709, Kundan Nagar<br>Indore, Madhya Pradesh 452013"
    }
  ],
  "presets": [
    {
      "name": "Contact Us"
    }
  ]
}
{% endschema %}
