{% comment %}
  Kartzo footer — brand column + 3 link columns + payment bar.
  Visible across all screen sizes (responsive grid on mobile & desktop).
{% endcomment %}
{%- assign size_page = pages['size-guide'] -%}
{%- assign tracking_page = pages['tracking'] -%}
{%- assign contact_page = pages['contact'] -%}
{%- assign faq_page = pages['faq'] -%}
{%- assign shipping_page = pages['shipping-policy'] -%}
{%- assign returns_page = pages['returns-policy'] -%}
{%- assign cancel_page = pages['cancellation-policy'] -%}
{%- assign about_page = pages['about'] -%}
{%- assign privacy_page = pages['privacy-policy'] -%}
{%- assign terms_page = pages['terms-conditions'] -%}

<footer class="border-t border-[#e8eef8] bg-white pb-[76px] lg:pb-0">
  <div class="pad mx-auto w-full grid grid-cols-1 gap-8 py-10 sm:grid-cols-2 lg:grid-cols-5">
    <!-- Brand / Mission / Socials -->
    <div class="lg:col-span-2 space-y-4">
      <a href="{{ routes.root_url }}" class="inline-block" aria-label="{{ shop.name }} home">
        {%- if section.settings.logo -%}
          {{ section.settings.logo | image_url: width: 400 | image_tag: widths: '200, 400', alt: shop.name, class: 'h-8 w-auto' }}
        {%- else -%}
          <img src="{{ 'logo.webp' | asset_url }}" alt="{{ shop.name | escape }}" width="541" height="168" class="h-8 w-auto">
        {%- endif -%}
      </a>
      <p class="max-w-sm text-xs sm:text-sm leading-relaxed text-slate-600">
        {{ section.settings.mission | default: "Kartzo delivers curated essentials across consumer technology, fashion, and home lifestyle with guaranteed authentic sourcing, fair pricing, and direct doorstep returns." }}
      </p>

      <!-- Contact details -->
      <div class="space-y-2 pt-1 text-xs text-slate-600">
        <p class="flex items-center gap-2">
          <svg class="h-4 w-4 text-brand shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
          <a href="mailto:{{ settings.support_email | default: 'support@kartzo.com' }}" class="hover:text-brand">{{ settings.support_email | default: 'support@kartzo.com' }}</a>
        </p>
        <p class="flex items-center gap-2">
          <svg class="h-4 w-4 text-brand shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M8 4h3l1 4-2 1a12 12 0 0 0 5 5l1-2 4 1v3c0 1-1 2-2 2C10 18 6 14 4 6c0-1 1-2 2-2z"/></svg>
          <a href="tel:{{ settings.support_phone | default: '+919876543210' }}" class="hover:text-brand">{{ settings.support_phone | default: '+91 98765 43210' }}</a>
        </p>
      </div>

      <!-- Social Links -->
      {%- assign fb = settings.social_facebook | default: 'https://facebook.com' -%}
      {%- assign insta = settings.social_instagram | default: 'https://instagram.com' -%}
      {%- assign tw = settings.social_x | default: 'https://x.com' -%}
      {%- assign yt = settings.social_youtube | default: 'https://youtube.com' -%}
      <div class="flex items-center gap-2 pt-2">
        <a href="{{ fb }}" target="_blank" rel="noopener" class="flex h-9 w-9 items-center justify-center rounded-full border border-slate-200 text-slate-600 hover:border-brand hover:text-brand hover:bg-brand-soft transition" aria-label="Facebook">
          <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 9h3V6h-3c-1.7 0-3 1.3-3 3v2H8v3h3v7h3v-7h3l1-3h-4V9c0-.6.4-1 1-1z"/></svg>
        </a>
        <a href="{{ insta }}" target="_blank" rel="noopener" class="flex h-9 w-9 items-center justify-center rounded-full border border-slate-200 text-slate-600 hover:border-brand hover:text-brand hover:bg-brand-soft transition" aria-label="Instagram">
          <svg class="h-3.5 w-3.5 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="4"/><circle cx="12" cy="12" r="3.5"/><circle cx="17.5" cy="6.5" r="0.8" fill="currentColor"/></svg>
        </a>
        <a href="{{ tw }}" target="_blank" rel="noopener" class="flex h-9 w-9 items-center justify-center rounded-full border border-slate-200 text-slate-600 hover:border-brand hover:text-brand hover:bg-brand-soft transition" aria-label="X">
          <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.5 3h3.1l-6.8 7.8L22 21h-6.2l-4.8-6.3L5.7 21H2.6l7.3-8.4L2 3h6.3l4.4 5.8L17.5 3zm-1.1 16.2h1.7L7.7 4.7H5.9l10.5 14.5z"/></svg>
        </a>
        <a href="{{ yt }}" target="_blank" rel="noopener" class="flex h-9 w-9 items-center justify-center rounded-full border border-slate-200 text-slate-600 hover:border-brand hover:text-brand hover:bg-brand-soft transition" aria-label="YouTube">
          <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 12s0-3.3-.4-4.8a2.5 2.5 0 0 0-1.8-1.8C18.3 5 12 5 12 5s-6.3 0-7.8.4A2.5 2.5 0 0 0 2.4 7.2C2 8.7 2 12 2 12s0 3.3.4 4.8c.2.9.9 1.6 1.8 1.8 1.5.4 7.8.4 7.8.4s6.3 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8c.4-1.5.4-4.8.4-4.8zM10 15.5v-7l6 3.5z"/></svg>
        </a>
      </div>
    </div>

    <!-- Shop Catalog -->
    <nav aria-label="Shop Catalog">
      <h3 class="text-xs font-extrabold uppercase tracking-wider text-brand-ink">Shop Catalog</h3>
      <ul class="mt-4 space-y-2.5 text-xs sm:text-sm text-slate-600 font-medium">
        <li><a href="{{ routes.all_products_collection_url }}" class="hover:text-brand transition">All Products</a></li>
        <li><a href="{{ routes.collections_url }}" class="hover:text-brand transition">Shop by Category</a></li>
        {%- assign deals_page = pages['deals'] -%}
        {%- assign deals_url = section.settings.deals_url | default: deals_page.url -%}
        {%- if deals_url == blank -%}{%- assign deals_url = '/collections/all?view=deals' -%}{%- endif -%}
        <li><a href="{{ deals_url }}" class="hover:text-brand transition">Flash Deals</a></li>
        <li><a href="{{ routes.search_url }}?q=electronics" class="hover:text-brand transition">Audio &amp; Electronics</a></li>
        {%- assign size_url = size_page.url | default: '/collections/all?view=size-guide' -%}
        <li><a href="{{ size_url }}" class="hover:text-brand transition">Size &amp; Fit Guide</a></li>
      </ul>
    </nav>

    <!-- Customer Care -->
    <nav aria-label="Customer Care">
      <h3 class="text-xs font-extrabold uppercase tracking-wider text-brand-ink">Customer Care</h3>
      <ul class="mt-4 space-y-2.5 text-xs sm:text-sm text-slate-600 font-medium">
        {%- assign track_url = tracking_page.url | default: '/collections/all?view=tracking' -%}
        {%- assign contact_url = contact_page.url | default: '/pages/contact' -%}
        {%- assign faq_url = faq_page.url | default: '/collections/all?view=faq' -%}
        {%- assign shipping_url = shipping_page.url | default: shop.shipping_policy.url -%}
        {%- if shipping_url == blank -%}{%- assign shipping_url = '/collections/all?view=shipping-policy' -%}{%- endif -%}
        {%- assign returns_url = returns_page.url | default: shop.refund_policy.url -%}
        {%- if returns_url == blank -%}{%- assign returns_url = '/collections/all?view=returns-policy' -%}{%- endif -%}
        {%- assign cancel_url = cancel_page.url | default: '/collections/all?view=cancellation-policy' -%}
        <li><a href="{{ track_url }}" class="hover:text-brand transition">Track Your Parcel</a></li>
        <li><a href="{{ contact_url }}" class="hover:text-brand transition">Contact Support</a></li>
        <li><a href="{{ faq_url }}" class="hover:text-brand transition">Help &amp; FAQs</a></li>
        <li><a href="{{ shipping_url }}" class="hover:text-brand transition">Shipping Policy</a></li>
        <li><a href="{{ returns_url }}" class="hover:text-brand transition">7-Day Returns Policy</a></li>
        <li><a href="{{ cancel_url }}" class="hover:text-brand transition">Order Cancellation</a></li>
      </ul>
    </nav>

    <!-- Company -->
    <nav aria-label="Company">
      <h3 class="text-xs font-extrabold uppercase tracking-wider text-brand-ink">Company</h3>
      <ul class="mt-4 space-y-2.5 text-xs sm:text-sm text-slate-600 font-medium">
        {%- assign about_url = about_page.url | default: '/collections/all?view=about' -%}
        {%- assign privacy_url = privacy_page.url | default: shop.privacy_policy.url -%}
        {%- if privacy_url == blank -%}{%- assign privacy_url = '/collections/all?view=privacy-policy' -%}{%- endif -%}
        {%- assign terms_url = terms_page.url | default: shop.terms_of_service.url -%}
        {%- if terms_url == blank -%}{%- assign terms_url = '/collections/all?view=terms-conditions' -%}{%- endif -%}
        <li><a href="{{ about_url }}" class="hover:text-brand transition">About {{ shop.name }}</a></li>
        <li><a href="{{ routes.account_url }}" class="hover:text-brand transition">Customer Account</a></li>
        <li><a href="{{ privacy_url }}" class="hover:text-brand transition">Privacy Policy</a></li>
        <li><a href="{{ terms_url }}" class="hover:text-brand transition">Terms of Service</a></li>
      </ul>
    </nav>
  </div>

  <!-- Bottom bar (visible on all screens) -->
  <div class="border-t border-slate-100 bg-slate-50/70">
    <div class="pad mx-auto flex w-full flex-col gap-4 py-6 sm:flex-row sm:items-center sm:justify-between text-xs text-slate-500 font-medium">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
      {%- assign payment_methods = 'Visa,Mastercard,RuPay,UPI,Net Banking,COD' | split: ',' -%}
      <div class="flex flex-wrap items-center gap-2 text-[11px] text-slate-600 font-semibold" aria-label="Accepted payment methods">
        {%- for method in payment_methods -%}
          <span class="rounded bg-white border border-slate-200 px-2 py-0.5">{{ method }}</span>
        {%- endfor -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo (falls back to Kartzo logo asset)" },
    { "type": "textarea", "id": "mission", "label": "Brand mission text", "default": "Kartzo delivers curated essentials across consumer technology, fashion, and home lifestyle with guaranteed authentic sourcing, fair pricing, and direct doorstep returns." },
    { "type": "url", "id": "deals_url", "label": "Flash Deals link (point at your Sale collection)" },
    { "type": "text", "id": "payment_badges", "label": "Payment badges (comma-separated)" }
  ],
  "presets": [{ "name": "Footer" }]
}
{% endschema %}
