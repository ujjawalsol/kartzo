{% comment %}
  Breadcrumbs with schema.org BreadcrumbList. Render with: {% render 'breadcrumbs', trail: 'Shop' %}
  Desktop-only display matches the original (md:block hidden).
{% endcomment %}
<nav aria-label="Breadcrumb" class="pad hidden w-full pt-4 md:block">
  <ol class="flex flex-wrap items-center gap-1.5 text-[13px] font-semibold text-[#7d8aa3]" itemscope itemtype="https://schema.org/BreadcrumbList">
    <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
      <a href="{{ routes.root_url }}" itemprop="item" class="hover:text-brand"><span itemprop="name">{{ 'general.home' | t }}</span></a>
      <meta itemprop="position" content="1">
    </li>
    <li aria-hidden="true">/</li>
    <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" aria-current="page">
      <span itemprop="name" class="text-brand-ink">{{ trail | escape }}</span>
      <meta itemprop="position" content="2">
    </li>
  </ol>
</nav>
