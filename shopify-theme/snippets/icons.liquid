  {%- when 'star' -%}<svg class="{{ icon_class }}" viewBox="0 0 24 24" aria-hidden="true"><path d="m12 2.5 3.09 6.26 6.91 1-5 4.87 1.18 6.88L12 18.25l-6.18 3.26L7 14.63l-5-4.87 6.91-1L12 2.5z"/></svg>
