{% comment %} Customer addresses - manages shipping addresses. {% endcomment %}
{% render 'breadcrumbs', trail: 'Addresses' %}

<div class="pad mx-auto w-full max-w-7xl pb-12 pt-4 sm:pt-6">
  <h1 class="text-2xl font-extrabold tracking-tight sm:text-3xl">Addresses</h1>
  <div class="mt-5 grid gap-6 lg:grid-cols-[260px_minmax(0,1fr)]">
    <nav class="h-fit rounded-2xl border border-[#e6eefb] bg-white p-3 text-sm font-bold" aria-label="Account">
      <a href="{{ routes.account_url }}" class="block rounded-xl px-3 py-2.5 text-slate-600 hover:bg-slate-50">My Orders</a>
      <a href="{{ routes.account_addresses_url }}" aria-current="page" class="block rounded-xl bg-brand-soft px-3 py-2.5 text-brand">Addresses</a>
      <a href="{{ routes.account_logout_url }}" class="block rounded-xl px-3 py-2.5 text-slate-600 hover:bg-slate-50">Sign Out</a>
    </nav>
    <div class="space-y-4">
      <button type="button" onclick="document.getElementById('new-address-form').classList.toggle('hidden')" class="inline-flex min-h-11 items-center rounded-xl bg-brand px-6 text-sm font-bold text-white hover:bg-brand-dark">Add new address</button>
      <div id="new-address-form" class="hidden rounded-2xl border border-[#e6eefb] bg-white p-4">
        {% form 'customer_address', customer.new_address %}
          <div class="grid gap-3 sm:grid-cols-2">
            <input type="text" name="address[first_name]" value="{{ form.first_name }}" placeholder="First name" autocomplete="given-name" class="min-h-11 rounded-xl border border-slate-200 px-3.5 text-sm">
            <input type="text" name="address[last_name]" value="{{ form.last_name }}" placeholder="Last name" autocomplete="family-name" class="min-h-11 rounded-xl border border-slate-200 px-3.5 text-sm">
            <input type="text" name="address[address1]" value="{{ form.address1 }}" placeholder="Address" autocomplete="street-address" class="min-h-11 rounded-xl border border-slate-200 px-3.5 text-sm sm:col-span-2">
            <input type="text" name="address[city]" value="{{ form.city }}" placeholder="City" autocomplete="address-level2" class="min-h-11 rounded-xl border border-slate-200 px-3.5 text-sm">
            <input type="text" name="address[zip]" value="{{ form.zip }}" placeholder="PIN code" autocomplete="postal-code" class="min-h-11 rounded-xl border border-slate-200 px-3.5 text-sm">
            <input type="tel" name="address[phone]" value="{{ form.phone }}" placeholder="Phone" autocomplete="tel" class="min-h-11 rounded-xl border border-slate-200 px-3.5 text-sm sm:col-span-2">
          </div>
          <div class="mt-3 flex gap-2">
            <button type="submit" class="inline-flex min-h-11 items-center rounded-xl bg-brand px-6 text-sm font-bold text-white">Save</button>
          </div>
        {% endform %}
      </div>
      {% paginate customer.addresses by 10 %}
        {% for address in customer.addresses %}
          <article class="rounded-2xl border border-[#e6eefb] bg-white p-4">
            <p class="text-sm font-extrabold">{{ address.first_name }} {{ address.last_name }}{% if address == customer.default_address %} (Default){% endif %}</p>
            <p class="mt-1 text-sm text-slate-600">{{ address.address1 }}<br>{{ address.city }} {{ address.zip }}<br>{{ address.phone }}</p>
          </article>
        {% else %}
          <div class="rounded-3xl border border-dashed border-slate-300 px-6 py-14 text-center">
            <p class="text-lg font-extrabold">No addresses saved</p>
            <p class="mt-1 text-sm text-slate-500">Add an address for faster checkout.</p>
          </div>
        {% endfor %}
      {% endpaginate %}
      <a href="{{ routes.account_url }}" class="inline-flex min-h-11 items-center rounded-xl border border-slate-200 bg-white px-6 text-sm font-bold text-slate-700 hover:bg-slate-50">Back to account</a>
    </div>
  </div>
</div>
