{% comment %} Legacy password reset fallback. {% endcomment %}
<div class="pad mx-auto w-full max-w-md pb-12 pt-10">
  <div class="rounded-3xl border border-[#e6eefb] bg-white p-6 sm:p-8">
    <h1 class="text-2xl font-extrabold tracking-tight">Reset your password</h1>
    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}
        <div class="mt-3 rounded-xl bg-rose-50 px-4 py-3 text-sm font-semibold text-rose-700" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <label for="rst-password" class="mt-4 block text-xs font-bold text-slate-600">New password</label>
      <input id="rst-password" name="customer[password]" type="password" required autocomplete="new-password" class="mt-1 min-h-11 w-full rounded-xl border border-slate-200 px-3 text-sm outline-none focus:border-brand">
      <label for="rst-confirm" class="mt-3 block text-xs font-bold text-slate-600">Confirm password</label>
      <input id="rst-confirm" name="customer[password_confirmation]" type="password" required autocomplete="new-password" class="mt-1 min-h-11 w-full rounded-xl border border-slate-200 px-3 text-sm outline-none focus:border-brand">
      <button type="submit" class="mt-4 flex min-h-11 w-full items-center justify-center rounded-xl bg-brand text-sm font-extrabold text-white hover:bg-brand-dark">Reset password</button>
    {%- endform -%}
  </div>
</div>
