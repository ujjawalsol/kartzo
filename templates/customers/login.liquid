{% comment %} Legacy customer login (used only if classic customer accounts are enabled). {% endcomment %}
{% render 'breadcrumbs', trail: 'Sign in' %}

<div class="pad mx-auto w-full max-w-md pb-12 pt-6">
  <div class="rounded-3xl border border-[#e6eefb] bg-white p-6 sm:p-8">
    <h1 class="text-2xl font-extrabold tracking-tight">Welcome Back</h1>
    <p class="mt-1 text-sm text-slate-500">Sign in to manage orders, tracking and wishlist.</p>
    {%- form 'customer_login', novalidate: 'novalidate' -%}
      {%- if form.errors -%}
        <div class="mt-3 rounded-xl bg-rose-50 px-4 py-3 text-sm font-semibold text-rose-700" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="mt-4 space-y-3">
        <div>
          <label for="login-email" class="text-xs font-bold text-slate-600">Email</label>
          <input id="login-email" name="customer[email]" type="email" required autocomplete="email" class="mt-1 min-h-11 w-full rounded-xl border border-slate-200 px-3 text-sm outline-none focus:border-brand">
        </div>
        <div>
          <label for="login-password" class="text-xs font-bold text-slate-600">Password</label>
          <input id="login-password" name="customer[password]" type="password" required autocomplete="current-password" class="mt-1 min-h-11 w-full rounded-xl border border-slate-200 px-3 text-sm outline-none focus:border-brand">
        </div>
      </div>
      <button type="submit" class="mt-4 flex min-h-11 w-full items-center justify-center rounded-xl bg-brand text-sm font-extrabold text-white hover:bg-brand-dark">Sign In</button>
      <div class="mt-3 flex items-center justify-between text-sm">
        <a href="{{ routes.account_register_url }}" class="font-bold text-brand hover:underline">Create account</a>
        <a href="#recover" id="recover-toggle" class="font-bold text-brand hover:underline">Forgot password?</a>
      </div>
    {%- endform -%}

    <div id="recover" class="mt-6 border-t border-slate-100 pt-5">
      <h2 class="text-base font-extrabold">Reset Password</h2>
      {%- form 'recover_customer_password' -%}
        {%- if form.posted_successfully? -%}
          <p class="mt-2 rounded-xl bg-emerald-50 px-4 py-3 text-sm font-bold text-emerald-700" role="status">Check your email for a reset link.</p>
        {%- endif -%}
        {%- if form.errors -%}
          <div class="mt-2 rounded-xl bg-rose-50 px-4 py-3 text-sm font-semibold text-rose-700" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <label for="reset-email" class="mt-2 block text-xs font-bold text-slate-600">Email</label>
        <input id="reset-email" name="email" type="email" required autocomplete="email" class="mt-1 min-h-11 w-full rounded-xl border border-slate-200 px-3 text-sm outline-none focus:border-brand">
        <button type="submit" class="mt-3 inline-flex min-h-11 items-center rounded-xl bg-brand-ink px-6 text-sm font-bold text-white">Send reset link</button>
      {%- endform -%}
    </div>
  </div>
</div>
