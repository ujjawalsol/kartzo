{% comment %} Legacy customer account dashboard fallback (real customer + orders data). {% endcomment %}
{% render 'breadcrumbs', trail: 'My Account' %}

<div class="pad mx-auto w-full max-w-7xl pb-12 pt-4 sm:pt-6">
  <h1 class="text-2xl font-extrabold tracking-tight sm:text-3xl">Hello, {{ customer.first_name | default: customer.name | escape }}</h1>

  <div class="mt-5 grid gap-6 lg:grid-cols-[260px_minmax(0,1fr)]">
    <nav class="h-fit rounded-2xl border border-[#e6eefb] bg-white p-3 text-sm font-bold" aria-label="Account">
      <a href="{{ routes.account_url }}" aria-current="page" class="block rounded-xl bg-brand-soft px-3 py-2.5 text-brand">My Orders</a>
      <a href="{{ routes.account_addresses_url }}" class="block rounded-xl px-3 py-2.5 text-slate-600 hover:bg-slate-50">Addresses</a>
      <a href="{{ routes.account_logout_url }}" class="block rounded-xl px-3 py-2.5 text-slate-600 hover:bg-slate-50">Sign Out</a>
    </nav>

    <div class="space-y-4">
      {%- paginate customer.orders by 20 -%}
      {%- if customer.orders.size > 0 -%}
        {%- for order in customer.orders -%}
          <article class="rounded-2xl border border-[#e6eefb] bg-white p-4">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div>
                <p class="text-sm font-extrabold">{{ order.name }}</p>
                <p class="text-xs text-slate-500">{{ order.created_at | date: '%d %b %Y' }} · {{ order.item_count }} items</p>
              </div>
              <span class="status-pill {% if order.fulfillment_status == 'fulfilled' %}status-delivered{% elsif order.financial_status == 'paid' %}status-shipped{% else %}status-processing{% endif %}">
                {{ order.fulfillment_status_label }}
              </span>
            </div>
            <div class="mt-3 flex flex-wrap items-center justify-between gap-2">
              <p class="text-sm font-extrabold">{{ order.total_price | money }}</p>
              <a href="{{ order.customer_url }}" class="inline-flex min-h-11 items-center rounded-xl bg-brand-soft px-5 text-xs font-bold text-brand hover:bg-[#dbe7ff]">View order</a>
            </div>
          </article>
        {%- endfor -%}
        {%- if paginate.pages > 1 -%}
          <nav class="flex items-center justify-center gap-2" aria-label="Pagination">
            {{ paginate | default_pagination }}
          </nav>
        {%- endif -%}
      {%- else -%}
        <div class="rounded-3xl border border-dashed border-slate-300 px-6 py-14 text-center">
          <p class="text-lg font-extrabold">No orders yet</p>
          <p class="mt-1 text-sm text-slate-500">Your past purchases will appear here.</p>
          <a href="{{ routes.all_products_collection_url }}" class="mt-4 inline-flex min-h-11 items-center rounded-xl bg-brand px-6 text-sm font-bold text-white hover:bg-brand-dark">Start shopping</a>
        </div>
      {%- endif -%}
      {%- endpaginate -%}
    </div>
  </div>
</div>
