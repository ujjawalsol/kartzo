{% comment %} Legacy customer registration fallback. {% endcomment %}
{% render 'breadcrumbs', trail: 'Create account' %}

<div class="pad mx-auto w-full max-w-md pb-12 pt-6">
  <div class="rounded-3xl border border-[#e6eefb] bg-white p-6 sm:p-8">
    <h1 class="text-2xl font-extrabold tracking-tight">Create an Account</h1>
    <p class="mt-1 text-sm text-slate-500">Faster checkout, order history and saved details.</p>
    {%- form 'create_customer', novalidate: 'novalidate' -%}
      {%- if form.errors -%}
        <div class="mt-3 rounded-xl bg-rose-50 px-4 py-3 text-sm font-semibold text-rose-700" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="mt-4 space-y-3">
        <div>
          <label for="reg-name" class="text-xs font-bold text-slate-600">Full name</label>
          <input id="reg-name" name="customer[first_name]" type="text" required autocomplete="name" class="mt-1 min-h-11 w-full rounded-xl border border-slate-200 px-3 text-sm outline-none focus:border-brand">
        </div>
        <div>
          <label for="reg-email" class="text-xs font-bold text-slate-600">Email</label>
          <input id="reg-email" name="customer[email]" type="email" required autocomplete="email" class="mt-1 min-h-11 w-full rounded-xl border border-slate-200 px-3 text-sm outline-none focus:border-brand">
        </div>
        <div>
          <label for="reg-password" class="text-xs font-bold text-slate-600">Password</label>
          <input id="reg-password" name="customer[password]" type="password" required autocomplete="new-password" class="mt-1 min-h-11 w-full rounded-xl border border-slate-200 px-3 text-sm outline-none focus:border-brand">
        </div>
      </div>
      <button type="submit" class="mt-4 flex min-h-11 w-full items-center justify-center rounded-xl bg-brand text-sm font-extrabold text-white hover:bg-brand-dark">Create account</button>
      <p class="mt-3 text-center text-sm">Already have an account? <a href="{{ routes.account_login_url }}" class="font-bold text-brand hover:underline">Sign in</a></p>
    {%- endform -%}
  </div>
</div>
