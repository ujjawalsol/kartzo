{% comment %}
  Kartzo Policy Content Snippet — 100% interactive 5-policy tabs with instant switching.
{% endcomment %}
{%- assign all_context = template.suffix | append: ' ' | append: page.handle | append: ' ' | append: page.title | append: ' ' | append: request.path | append: ' ' | append: canonical_url | downcase -%}

{%- assign active_tab = 'privacy' -%}
{%- if all_context contains 'shipping' -%}
  {%- assign active_tab = 'shipping' -%}
{%- elsif all_context contains 'return' or all_context contains 'refund' -%}
  {%- assign active_tab = 'return' -%}
{%- elsif all_context contains 'cancel' -%}
  {%- assign active_tab = 'cancel' -%}
{%- elsif all_context contains 'terms' or all_context contains 'condition' -%}
  {%- assign active_tab = 'terms' -%}
{%- elsif all_context contains 'privacy' -%}
  {%- assign active_tab = 'privacy' -%}
{%- endif -%}

{%- assign initial_title = 'Privacy Policy' -%}
{%- if active_tab == 'shipping' -%}
  {%- assign initial_title = 'Shipping Policy' -%}
{%- elsif active_tab == 'return' -%}
  {%- assign initial_title = '7-Day Returns & Exchange Policy' -%}
{%- elsif active_tab == 'cancel' -%}
  {%- assign initial_title = 'Order Cancellation Policy' -%}
{%- elsif active_tab == 'terms' -%}
  {%- assign initial_title = 'Terms & Conditions' -%}
{%- endif -%}

<nav class="pad site-max hidden pt-6 text-xs text-slate-500 md:block" aria-label="Breadcrumb">
  <ol class="flex flex-wrap items-center gap-2">
    <li class="flex items-center gap-2">
      <a class="hover:text-brand transition font-medium text-slate-600" href="{{ routes.root_url }}">Home</a>
      <span aria-hidden="true" class="text-slate-300">/</span>
    </li>
    <li class="flex items-center gap-2">
      <span id="policy-breadcrumb-trail" class="font-bold text-brand-ink">{{ initial_title }}</span>
    </li>
  </ol>
</nav>

<div class="pad site-max py-5 sm:py-8 max-w-4xl mx-auto">
  <!-- Interactive Policy Tabs Bar -->
  <div class="mb-5 flex gap-2 overflow-x-auto no-scrollbar border-b border-slate-200 pb-4 sm:mb-8 sm:flex-wrap sm:overflow-visible sm:pb-4" role="tablist" aria-label="Store Policies Navigation">
    <button type="button" data-policy-tab="shipping" class="shrink-0 rounded-xl px-3.5 py-1.5 text-xs font-bold transition {% if active_tab == 'shipping' %}bg-brand text-white shadow-sm{% else %}border border-slate-200 bg-white text-slate-600 hover:bg-slate-50{% endif %}">Shipping Policy</button>
    <button type="button" data-policy-tab="return" class="shrink-0 rounded-xl px-3.5 py-1.5 text-xs font-bold transition {% if active_tab == 'return' %}bg-brand text-white shadow-sm{% else %}border border-slate-200 bg-white text-slate-600 hover:bg-slate-50{% endif %}">Returns &amp; Exchange</button>
    <button type="button" data-policy-tab="cancel" class="shrink-0 rounded-xl px-3.5 py-1.5 text-xs font-bold transition {% if active_tab == 'cancel' %}bg-brand text-white shadow-sm{% else %}border border-slate-200 bg-white text-slate-600 hover:bg-slate-50{% endif %}">Cancellation</button>
    <button type="button" data-policy-tab="privacy" class="shrink-0 rounded-xl px-3.5 py-1.5 text-xs font-bold transition {% if active_tab == 'privacy' %}bg-brand text-white shadow-sm{% else %}border border-slate-200 bg-white text-slate-600 hover:bg-slate-50{% endif %}">Privacy Policy</button>
    <button type="button" data-policy-tab="terms" class="shrink-0 rounded-xl px-3.5 py-1.5 text-xs font-bold transition {% if active_tab == 'terms' %}bg-brand text-white shadow-sm{% else %}border border-slate-200 bg-white text-slate-600 hover:bg-slate-50{% endif %}">Terms &amp; Conditions</button>
  </div>

  <!-- PANEL 1: Shipping Policy -->
  <div data-policy-panel="shipping" class="{% unless active_tab == 'shipping' %}hidden{% endunless %}">
    <div class="mb-5 sm:mb-8">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-soft px-3 py-1 text-xs font-bold text-brand">
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 5h13v10H2zM15 9h4l3 3v3h-7z"/><circle cx="6" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></svg>
        Fulfillment Guidelines
      </span>
      <h1 class="mt-2 text-[1.45rem] font-extrabold leading-tight tracking-tight text-brand-ink sm:text-4xl">
        Shipping &amp; Delivery Policy
      </h1>
      <p class="mt-1 text-xs sm:text-sm text-slate-500">Last updated: October 2026 • Valid for all orders across India.</p>
    </div>

    <!-- Highlight Banner -->
    <div class="mb-8 rounded-2xl border border-emerald-200 bg-emerald-50 p-5 text-xs sm:text-sm leading-relaxed text-emerald-900">
      <div class="flex items-center gap-2 font-black text-emerald-800">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
        <span>Key Summary: Free Shipping on ₹499+</span>
      </div>
      <p class="mt-1.5">All orders exceeding ₹499 qualify for 100% Free Express Shipping. Orders below ₹499 incur a flat fee of ₹49. All shipments are dispatched within 24 hours.</p>
    </div>

    <article class="prose-kartzo text-xs sm:text-sm leading-relaxed text-slate-600 space-y-8">
      <section>
        <h2 class="text-base sm:text-lg font-extrabold text-brand-ink border-b border-slate-100 pb-2">1. Delivery Network &amp; Fulfillment Speed</h2>
        <p class="mt-3">Kartzo ships across 19,000+ postal PIN codes throughout India. Our primary logistics partners include Blue Dart Express, Delhivery, Shadowfax, and DTDC. Orders placed before 3:00 PM IST on business days are packed and dispatched on the same day.</p>
        <ul class="mt-3 list-disc pl-5 space-y-2 text-slate-600">
          <li><strong>Tier-1 Metro Hubs (Mumbai, Delhi-NCR, Bengaluru, Hyderabad, Chennai, Kolkata):</strong> Delivered within 2 to 3 business days.</li>
          <li><strong>Tier-2 &amp; Tier-3 Cities:</strong> Delivered within 3 to 5 business days.</li>
          <li><strong>Regional &amp; North-Eastern Pin Codes:</strong> Delivered within 5 to 7 business days.</li>
        </ul>
      </section>

      <section>
        <h2 class="text-base sm:text-lg font-extrabold text-brand-ink border-b border-slate-100 pb-2">2. Free Shipping Thresholds &amp; Courier Fees</h2>
        <p class="mt-3">We believe in transparent pricing. If your shopping cart reaches <strong>₹499 or more</strong>, shipping is complimentary. If your order total is less than ₹499, a nominal freight charge of ₹49 is added at checkout to cover regional transportation.</p>
      </section>

      <section>
        <h2 class="text-base sm:text-lg font-extrabold text-brand-ink border-b border-slate-100 pb-2">3. Real-Time Tracking Milestones</h2>
        <p class="mt-3">Upon shipment handover to our courier partner, you will receive an SMS and Email notification containing your unique Air Waybill (AWB) number and direct tracking link. You can also view live milestone updates at any time via the <a href="{{ pages['tracking'].url | default: '/pages/tracking' }}" class="text-brand font-bold hover:underline">Kartzo Order Tracker</a>.</p>
      </section>

      <section>
        <h2 class="text-base sm:text-lg font-extrabold text-brand-ink border-b border-slate-100 pb-2">4. Damaged or Tampered Parcels</h2>
        <p class="mt-3">If you notice that the external tamper-evident polybag has been cut, damaged, or unsealed upon delivery, please do not accept the package from the courier agent. Inform our support team immediately at <a href="mailto:support@kartzo.com" class="text-brand font-bold hover:underline">support@kartzo.com</a> or via phone at <a href="tel:+919876543210" class="text-brand font-bold hover:underline">+91 98765 43210</a>.</p>
      </section>
    </article>
  </div>

  <!-- PANEL 2: Returns & Exchange -->
  <div data-policy-panel="return" class="{% unless active_tab == 'return' %}hidden{% endunless %}">
    <div class="mb-5 sm:mb-8">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-soft px-3 py-1 text-xs font-bold text-brand">
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/><path d="M3 21v-5h5"/></svg>
        Buyer Protection
      </span>
      <h1 class="mt-2 text-[1.45rem] font-extrabold leading-tight tracking-tight text-brand-ink sm:text-4xl">
        7-Day Return &amp; Refund Policy
      </h1>
      <p class="mt-1 text-xs sm:text-sm text-slate-500">Hassle-free doorstep pickup and verified instant refunds.</p>
    </div>

    <!-- Highlight Banner -->
    <div class="mb-8 rounded-2xl border border-brand/20 bg-brand-soft p-5 text-xs sm:text-sm leading-relaxed text-brand-ink">
      <div class="flex items-center gap-2 font-black text-brand">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
        <span>Zero-Friction Doorstep Pickup</span>
      </div>
      <p class="mt-1.5 text-slate-600">You don't need to ship returns yourself. When you request a return, our logistics partner will collect the product directly from your address within 24 to 48 hours.</p>
    </div>

    <article class="prose-kartzo text-xs sm:text-sm leading-relaxed text-slate-600 space-y-8">
      <section>
        <h2 class="text-base sm:text-lg font-extrabold text-brand-ink border-b border-slate-100 pb-2">1. Eligible Conditions for Return</h2>
        <p class="mt-3">All items purchased on Kartzo qualify for replacement or return within <strong>7 calendar days</strong> from the delivery timestamp under any of the following circumstances:</p>
        <ul class="mt-3 list-disc pl-5 space-y-2 text-slate-600">
          <li>The product arrived physically damaged or cosmetically defective.</li>
          <li>The device does not power on, function as described, or missing included in-box accessories.</li>
          <li>An incorrect size, variant, or colorway was dispatched relative to your order confirmation.</li>
        </ul>
      </section>

      <section>
        <h2 class="text-base sm:text-lg font-extrabold text-brand-ink border-b border-slate-100 pb-2">2. How to Request a Return</h2>
        <ol class="mt-3 list-decimal pl-5 space-y-2 text-slate-600">
          <li>Log into your <a href="{{ routes.account_url }}" class="text-brand font-bold hover:underline">Kartzo Account</a> and find the relevant order.</li>
          <li>Click <strong>Request Return / Replacement</strong> and select your reason.</li>
          <li>Attach a quick photo of the defective item or original packaging.</li>
          <li>Our team will approve the request within 4 business hours and schedule doorstep collection.</li>
        </ol>
      </section>

      <section>
        <h2 class="text-base sm:text-lg font-extrabold text-brand-ink border-b border-slate-100 pb-2">3. Refund Processing Timelines</h2>
        <p class="mt-3">Once the returned package reaches our regional fulfillment depot and passes initial serial authentication, your refund is disbursed immediately:</p>
        <ul class="mt-3 list-disc pl-5 space-y-2 text-slate-600">
          <li><strong>UPI &amp; NetBanking:</strong> Refunded directly to your originating bank account within 2 to 4 business hours.</li>
          <li><strong>Credit / Debit Cards:</strong> Settled within 3 to 5 business days per standard RBI banking clearing cycles.</li>
          <li><strong>Cash on Delivery:</strong> Transferred via instant IMPS/UPI upon providing your account details.</li>
        </ul>
      </section>
    </article>
  </div>

  <!-- PANEL 3: Order Cancellation -->
  <div data-policy-panel="cancel" class="{% unless active_tab == 'cancel' %}hidden{% endunless %}">
    <div class="mb-5 sm:mb-8">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-soft px-3 py-1 text-xs font-bold text-brand">
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
        Order Management
      </span>
      <h1 class="mt-2 text-[1.45rem] font-extrabold leading-tight tracking-tight text-brand-ink sm:text-4xl">
        Order Cancellation Policy
      </h1>
      <p class="mt-1 text-xs sm:text-sm text-slate-500">Transparent guidelines on cancelling orders at any stage.</p>
    </div>

    <!-- Highlight Banner -->
    <div class="mb-8 rounded-2xl border border-brand/20 bg-brand-soft p-5 text-xs sm:text-sm leading-relaxed text-brand-ink">
      <div class="flex items-center gap-2 font-black text-brand">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
        <span>100% Free Cancellation Prior to Courier Dispatch</span>
      </div>
      <p class="mt-1.5 text-slate-600">You can cancel any confirmed order with zero penalty prior to warehouse packaging and courier dispatch. Pre-paid amounts will be reversed immediately.</p>
    </div>

    <article class="prose-kartzo text-xs sm:text-sm leading-relaxed text-slate-600 space-y-8">
      <section>
        <h2 class="text-base sm:text-lg font-extrabold text-brand-ink border-b border-slate-100 pb-2">1. Cancellation Prior to Courier Handover</h2>
        <p class="mt-3">You can cancel your order at <strong>100% zero charge</strong> before it has been handed over to the courier partner. Simply visit your <a href="{{ routes.account_url }}" class="text-brand font-bold hover:underline">Orders Dashboard</a>, locate the order, and click the "Cancel Order" button. Any prepaid funds will be reversed immediately.</p>
      </section>

      <section>
        <h2 class="text-base sm:text-lg font-extrabold text-brand-ink border-b border-slate-100 pb-2">2. Cancellation After Shipment Handover</h2>
        <p class="mt-3">If your parcel has already been assigned an AWB tracking code and dispatched from our warehouse, online one-click cancellation will no longer be available. In this case, you may simply refuse acceptance of the parcel when the delivery courier arrives at your address. Upon recorded return to our hub, full prepaid refund will be triggered.</p>
      </section>
    </article>
  </div>

  <!-- PANEL 4: Privacy Policy -->
  <div data-policy-panel="privacy" class="{% unless active_tab == 'privacy' %}hidden{% endunless %}">
    <div class="mb-5 sm:mb-8">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-soft px-3 py-1 text-xs font-bold text-brand">
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
        Data Protection &amp; Confidentiality
      </span>
      <h1 class="mt-2 text-[1.45rem] font-extrabold leading-tight tracking-tight text-brand-ink sm:text-4xl">
        Privacy Policy
      </h1>
      <p class="mt-1 text-xs sm:text-sm text-slate-500">Effective Date: October 2026 • Compliant with Indian IT Act 2000 and DPDP Act guidelines.</p>
    </div>

    <!-- Highlight Banner -->
    <div class="mb-8 rounded-2xl border border-brand/20 bg-brand-soft p-5 text-xs sm:text-sm leading-relaxed text-brand-ink">
      <div class="flex items-center gap-2 font-black text-brand">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
        <span>Key Privacy Guarantee: 100% Encrypted &amp; Never Monetized</span>
      </div>
      <p class="mt-1.5 text-slate-600">Kartzo guarantees complete data discretion. We utilize 256-bit bank-grade encryption for all transactions, never monetize your contact info, and only share address details with verified couriers for direct parcel fulfillment.</p>
    </div>

    <!-- 3-Pillar Privacy Trust Cards -->
    <div class="mb-10 grid grid-cols-1 gap-4 sm:grid-cols-3">
      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-soft text-brand">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        </div>
        <h3 class="mt-3 text-sm font-extrabold text-brand-ink">Bank-Grade Encryption</h3>
        <p class="mt-1 text-xs leading-relaxed text-slate-500">All payment sessions are 256-bit SSL encrypted via RBI-licensed gateways. We never store raw card numbers.</p>
      </div>

      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
        </div>
        <h3 class="mt-3 text-sm font-extrabold text-brand-ink">Zero Data Selling</h3>
        <p class="mt-1 text-xs leading-relaxed text-slate-500">We do not sell, rent, or lease your personal information or contact details to third-party telemarketers.</p>
      </div>

      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m10 15 5-3-5-3v6z"/></svg>
        </div>
        <h3 class="mt-3 text-sm font-extrabold text-brand-ink">Full User Control</h3>
        <p class="mt-1 text-xs leading-relaxed text-slate-500">You retain complete ownership over your account data with instant one-click deletion and export options.</p>
      </div>
    </div>

    <!-- Clauses -->
    <article class="prose-kartzo text-xs sm:text-sm leading-relaxed text-slate-600 space-y-8">
      <section>
        <h2 class="text-base sm:text-lg font-extrabold text-brand-ink border-b border-slate-100 pb-2">1. Information We Collect</h2>
        <p class="mt-3">Kartzo collects personal data strictly necessary to fulfill your purchases, verify transactions, and provide doorstep customer support. This includes:</p>
        <ul class="mt-3 list-disc pl-5 space-y-2 text-slate-600">
          <li><strong>Personal Identifiers:</strong> Name, shipping address, billing address, active mobile phone number, and email address.</li>
          <li><strong>Transactional Records:</strong> Order references, purchased items, invoices, payment status, and warranty registrations.</li>
          <li><strong>Device &amp; Usage Telemetry:</strong> IP address, device operating system, browser type, and session cookies used solely for shopping cart persistence.</li>
        </ul>
      </section>

      <section>
        <h2 class="text-base sm:text-lg font-extrabold text-brand-ink border-b border-slate-100 pb-2">2. Payment Security and Encryption</h2>
        <p class="mt-3">Kartzo does <strong>not</strong> store or hold raw credit card details, debit card CVVs, or online banking passwords on our servers. All transactions are securely routed through RBI-authorized payment gateways using tokenized 256-bit SSL encryption adhering to PCI-DSS Level 1 compliance standards.</p>
      </section>

      <section>
        <h2 class="text-base sm:text-lg font-extrabold text-brand-ink border-b border-slate-100 pb-2">3. Zero Third-Party Data Selling</h2>
        <p class="mt-3">We adhere to a strict zero-monetization policy. We never rent, sell, or trade your personal email, phone number, or purchase habits to external advertising networks or data aggregators. Customer information is shared strictly with authorized logistics couriers (e.g., Blue Dart, Delhivery) for doorstep delivery execution.</p>
      </section>

      <section>
        <h2 class="text-base sm:text-lg font-extrabold text-brand-ink border-b border-slate-100 pb-2">4. Cookies and Session Storage</h2>
        <p class="mt-3">We utilize functional cookies solely to maintain your active shopping cart, preserve wishlist selections, and remember your preferred display settings across visits. You can adjust your browser settings to decline cookies at any time, though some checkout functions may be restricted.</p>
      </section>

      <section>
        <h2 class="text-base sm:text-lg font-extrabold text-brand-ink border-b border-slate-100 pb-2">5. Your Rights Under DPDP Act</h2>
        <p class="mt-3">In compliance with India's Digital Personal Data Protection (DPDP) Act, you have full authority over your data:</p>
        <ul class="mt-3 list-disc pl-5 space-y-2 text-slate-600">
          <li><strong>Right to Access &amp; Portability:</strong> Request an export copy of all stored personal information associated with your account.</li>
          <li><strong>Right to Correction:</strong> Update outdated delivery addresses or phone numbers anytime via your account settings.</li>
          <li><strong>Right to Erasure:</strong> Request permanent deletion of your profile, addresses, and saved data from our production databases.</li>
        </ul>
      </section>

      <section>
        <h2 class="text-base sm:text-lg font-extrabold text-brand-ink border-b border-slate-100 pb-2">6. Grievance Redressal Officer</h2>
        <p class="mt-3">In accordance with the Information Technology Act 2000 and rules made thereunder, any queries, concerns, or data deletion requests may be directed to our appointed Grievance Officer:</p>
        <div class="mt-4 rounded-xl border border-slate-200 bg-slate-50 p-4 text-xs sm:text-sm text-slate-700 space-y-1">
          <p><strong>Support &amp; Inquiries:</strong> Kartzo Support Team</p>
          <p><strong>Email:</strong> <a href="mailto:support@kartzo.com" class="text-brand font-bold hover:underline">support@kartzo.com</a></p>
          <p><strong>Location:</strong> 709, Kundan Nagar, Indore, Madhya Pradesh 452013, India</p>
          <p><strong>Response Time:</strong> Within 48 working hours from receipt of communication.</p>
        </div>
      </section>
    </article>
  </div>

  <!-- PANEL 5: Terms & Conditions -->
  <div data-policy-panel="terms" class="{% unless active_tab == 'terms' %}hidden{% endunless %}">
    <div class="mb-5 sm:mb-8">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-soft px-3 py-1 text-xs font-bold text-brand">
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3M12 17h.01"/></svg>
        Legal Agreement
      </span>
      <h1 class="mt-2 text-[1.45rem] font-extrabold leading-tight tracking-tight text-brand-ink sm:text-4xl">
        Terms of Service
      </h1>
      <p class="mt-1 text-xs sm:text-sm text-slate-500">Applicable to all visitors and customers of Kartzo.</p>
    </div>

    <!-- Highlight Banner -->
    <div class="mb-8 rounded-2xl border border-brand/20 bg-brand-soft p-5 text-xs sm:text-sm leading-relaxed text-brand-ink">
      <div class="flex items-center gap-2 font-black text-brand">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
        <span>Verified Authenticity &amp; Transparent Commerce</span>
      </div>
