      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </a>
  </div>
</div>

<script>
  (function() {
    function initPolicyTabs() {
      var tabs = document.querySelectorAll('[data-policy-tab]');
      var panels = document.querySelectorAll('[data-policy-panel]');
      var breadcrumbTrail = document.getElementById('policy-breadcrumb-trail');
      if (!tabs.length || !panels.length) return;

      var tabNames = {
        'shipping': 'Shipping Policy',
        'return': '7-Day Returns & Exchange Policy',
        'cancel': 'Order Cancellation Policy',
        'privacy': 'Privacy Policy',
        'terms': 'Terms & Conditions'
      };

      function activate(key) {
        if (!tabNames[key]) key = 'privacy';
        tabs.forEach(function(t) {
          var isMatch = t.getAttribute('data-policy-tab') === key;
          if (isMatch) {
            t.className = 'shrink-0 rounded-xl px-3.5 py-1.5 text-xs font-bold transition bg-brand text-white shadow-sm';
            t.setAttribute('aria-selected', 'true');
          } else {
            t.className = 'shrink-0 rounded-xl px-3.5 py-1.5 text-xs font-bold transition border border-slate-200 bg-white text-slate-600 hover:bg-slate-50';
            t.setAttribute('aria-selected', 'false');
          }
        });

        panels.forEach(function(p) {
          if (p.getAttribute('data-policy-panel') === key) {
            p.classList.remove('hidden');
          } else {
            p.classList.add('hidden');
          }
        });

        if (breadcrumbTrail && tabNames[key]) {
          breadcrumbTrail.textContent = tabNames[key];
        }
      }

      tabs.forEach(function(t) {
        t.addEventListener('click', function(e) {
          e.preventDefault();
          var key = this.getAttribute('data-policy-tab');
          activate(key);
          if (window.history && window.history.replaceState) {
            window.history.replaceState(null, '', '#' + key);
          }
        });
      });

      // URL Hash or Path auto-detection
      var hash = (window.location.hash || '').replace('#', '').toLowerCase();
      var path = window.location.pathname.toLowerCase();
      var activeKey = '{{ active_tab }}';

      if (hash && tabNames[hash]) {
        activeKey = hash;
      } else if (path.indexOf('shipping') !== -1) {
        activeKey = 'shipping';
      } else if (path.indexOf('return') !== -1 || path.indexOf('refund') !== -1) {
        activeKey = 'return';
      } else if (path.indexOf('cancel') !== -1) {
        activeKey = 'cancel';
      } else if (path.indexOf('term') !== -1) {
        activeKey = 'terms';
      } else if (path.indexOf('privacy') !== -1) {
        activeKey = 'privacy';
      }

      activate(activeKey);
    }

    initPolicyTabs();
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initPolicyTabs);
    }
  })();
</script>
