{% comment %}
  Kartzo SEO & Structured Data Head Snippet
  Implements Open Graph, Twitter Card, and Google-compliant Schema.org JSON-LD (WebSite, Organization, BreadcrumbList, Product).
{% endcomment %}

{%- assign og_title = page_title | default: shop.name -%}
{%- assign og_url = canonical_url | default: request.origin | append: request.path -%}
{%- assign og_type = 'website' -%}
{%- assign og_description = page_description | default: shop.description | default: og_title | escape -%}

{%- if template.name == 'product' -%}
  {%- assign og_type = 'product' -%}
{%- elsif template.name == 'article' -%}
  {%- assign og_type = 'article' -%}
{%- elsif template.name == 'collection' -%}
  {%- assign og_type = 'product.group' -%}
{%- endif -%}

{%- comment -%} Open Graph Image {%- endcomment -%}
{%- if template.name == 'product' and product.featured_media -%}
  {%- assign og_image = product.featured_media | image_url: width: 1200 -%}
{%- elsif template.name == 'article' and article.image -%}
  {%- assign og_image = article.image | image_url: width: 1200 -%}
{%- elsif template.name == 'collection' and collection.featured_image -%}
  {%- assign og_image = collection.featured_image | image_url: width: 1200 -%}
{%- elsif settings.logo -%}
  {%- assign og_image = settings.logo | image_url: width: 1200 -%}
{%- else -%}
  {%- assign og_image = 'logo.webp' | asset_url -%}
{%- endif -%}

<!-- Open Graph / Social Meta -->
<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">
{%- if og_image != blank -%}
  <meta property="og:image" content="{{ og_image | prepend: 'https:' | replace: 'https:https:', 'https:' }}">
  <meta property="og:image:secure_url" content="{{ og_image | prepend: 'https:' | replace: 'https:https:', 'https:' }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
{%- endif -%}

{%- if template.name == 'product' -%}
  {%- assign current_var = product.selected_or_first_available_variant -%}
  <meta property="product:price:amount" content="{{ current_var.price | money_without_currency | remove: ',' }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
{%- if og_image != blank -%}
  <meta name="twitter:image" content="{{ og_image | prepend: 'https:' | replace: 'https:https:', 'https:' }}">
{%- endif -%}

<!-- Search Engine Directives -->
{%- if template.name == 'search' or template.name == '404' or template.suffix == 'tracking' or template.suffix == 'wishlist' or template.name == 'cart' or template.name == 'password' or template.directory == 'customers' -%}
  <meta name="robots" content="noindex, follow">
{%- else -%}
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
{%- endif -%}

<!-- Structured Data: WebSite (with Sitelinks SearchBox) -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": {{ shop.name | json }},
  "url": {{ shop.url | json }},
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "{{ shop.url }}{{ routes.search_url }}?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
}
</script>

<!-- Structured Data: Organization -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": {{ shop.name | json }},
  "url": {{ shop.url | json }},
  {%- if settings.logo -%}
  "logo": {{ settings.logo | image_url: width: 400 | prepend: 'https:' | replace: 'https:https:', 'https:' | json }},
  {%- else -%}
  "logo": {{ 'logo.webp' | asset_url | prepend: 'https:' | replace: 'https:https:', 'https:' | json }},
  {%- endif -%}
  "contactPoint": [{
    "@type": "ContactPoint",
    "contactType": "Customer Service",
    {%- if settings.support_email != blank -%}
    "email": {{ settings.support_email | json }},
    {%- endif -%}
    {%- if settings.support_phone != blank -%}
    "telephone": {{ settings.support_phone | json }},
    {%- endif -%}
    "areaServed": "IN",
    "availableLanguage": ["en", "hi"]
  }]
}
</script>

<!-- Structured Data: BreadcrumbList -->
{%- unless template.name == 'index' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": {{ shop.url | append: routes.root_url | json }}
    }
    {%- if template.name == 'product' -%}
      {%- if collection -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ collection.title | json }},
        "item": {{ shop.url | append: collection.url | json }}
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": {{ product.title | json }},
        "item": {{ shop.url | append: product.url | json }}
      }
      {%- else -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ product.title | json }},
        "item": {{ shop.url | append: product.url | json }}
      }
      {%- endif -%}
    {%- elsif template.name == 'collection' -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ collection.title | json }},
        "item": {{ shop.url | append: collection.url | json }}
      }
    {%- elsif template.name == 'page' -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ page.title | json }},
        "item": {{ shop.url | append: page.url | json }}
      }
    {%- elsif template.name == 'blog' -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ blog.title | json }},
        "item": {{ shop.url | append: blog.url | json }}
      }
    {%- elsif template.name == 'article' -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ blog.title | json }},
        "item": {{ shop.url | append: blog.url | json }}
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": {{ article.title | json }},
        "item": {{ shop.url | append: article.url | json }}
      }
    {%- endif -%}
  ]
}
</script>
{%- endunless -%}

{%- comment -%} Structured Data: Product (when on Product page) {%- endcomment -%}
{%- if template.name == 'product' and product != blank -%}
  {%- assign variant = product.selected_or_first_available_variant -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": {{ shop.url | append: product.url | json }},
  {%- if product.featured_media -%}
  "image": [
    {{ product.featured_media | image_url: width: 1200 | prepend: 'https:' | replace: 'https:https:', 'https:' | json }}
  ],
  {%- endif -%}
  "description": {{ product.description | strip_html | truncate: 500 | json }},
  "sku": {{ variant.sku | default: variant.id | append: '' | json }},
  "brand": {
    "@type": "Brand",
    "name": {{ product.vendor | default: shop.name | json }}
  },
  "offers": {
    "@type": "Offer",
    "url": {{ shop.url | append: variant.url | json }},
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "price": "{{ variant.price | divided_by: 100.0 }}",
    "priceValidUntil": "{{ 'now' | date: '%s' | plus: 31536000 | date: '%Y-%m-%d' }}",
    "itemCondition": "https://schema.org/NewCondition",
    "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
    "seller": {
      "@type": "Organization",
      "name": {{ shop.name | json }}
    }
  }
  {%- if product.metafields.reviews.rating.value != blank -%}
  ,"aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "{{ product.metafields.reviews.rating.value.rating | default: product.metafields.reviews.rating.value }}",
    "reviewCount": "{{ product.metafields.reviews.rating_count.value | default: 1 }}"
  }
  {%- endif -%}
}
</script>
{%- endif -%}
