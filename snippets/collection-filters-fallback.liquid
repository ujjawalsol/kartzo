{% comment %}
  Fallback filter sidebar when merchant has not configured Shopify Search & Discovery app.
  Provides Collections navigation, Price ranges, Availability, and Trust guarantee.
{% endcomment %}
<div class="space-y-6">
  <!-- Categories Navigation -->
  <div class="border-b border-slate-100 pb-5">
    <h3 class="text-sm font-extrabold text-brand-ink">Categories</h3>
    <ul class="mt-3 space-y-1">
      <li>
        <a href="{{ routes.all_products_collection_url }}" class="flex items-center justify-between rounded-lg px-2.5 py-1.5 text-xs font-semibold {% if collection.handle == 'all' or collection.handle == blank %}bg-brand-soft text-brand font-bold{% else %}text-slate-600 hover:bg-slate-50 hover:text-brand-ink{% endif %} transition">
          <span>All Products</span>
          <span class="text-[11px] text-slate-400">→</span>
        </a>
      </li>
      {%- assign cat_handles = 'electronics,fashion,home,beauty,kitchen,sports' | split: ',' -%}
      {%- assign cat_labels = 'Electronics,Fashion,Home & Living,Beauty & Care,Kitchen & Dining,Sports & Fitness' | split: ',' -%}
      {%- for handle in cat_handles -%}
        {%- assign c_obj = collections[handle] -%}
        {%- assign c_target = c_obj.url -%}
        {%- if c_target == blank -%}{%- assign c_target = routes.collections_url | append: '/' | append: handle -%}{%- endif -%}
        <li>
          <a href="{{ c_target }}" class="flex items-center justify-between rounded-lg px-2.5 py-1.5 text-xs font-semibold {% if collection.handle == handle %}bg-brand-soft text-brand font-bold{% else %}text-slate-600 hover:bg-slate-50 hover:text-brand-ink{% endif %} transition">
            <span>{{ cat_labels[forloop.index0] }}</span>
            <span class="text-[11px] text-slate-400">→</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>

  <!-- Price Range Filter -->
  <div class="border-b border-slate-100 pb-5">
    <h3 class="text-sm font-extrabold text-brand-ink">Price</h3>
    <form method="get" action="{{ collection.url }}" class="mt-3 space-y-2.5">
      <input type="hidden" name="sort_by" value="{{ collection.sort_by }}">
      <div class="flex items-center gap-2">
        <input type="number" name="filter.v.price.gte" placeholder="Min (₹)" min="0" class="min-h-10 w-full rounded-xl border border-slate-200 px-2.5 text-xs font-medium focus:border-brand">
        <span class="text-slate-400 text-xs">–</span>
        <input type="number" name="filter.v.price.lte" placeholder="Max (₹)" min="0" class="min-h-10 w-full rounded-xl border border-slate-200 px-2.5 text-xs font-medium focus:border-brand">
      </div>
      <button type="submit" class="inline-flex min-h-9 w-full items-center justify-center rounded-xl bg-brand px-3 text-xs font-bold text-white hover:bg-brand-dark transition">
        Apply Filter
      </button>
    </form>
    <div class="mt-3 flex flex-wrap gap-1.5">
      <a href="{{ collection.url }}?filter.v.price.lte=1000" class="rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 text-[11px] font-semibold text-slate-600 hover:border-brand hover:text-brand">Under ₹1k</a>
      <a href="{{ collection.url }}?filter.v.price.gte=1000&filter.v.price.lte=3000" class="rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 text-[11px] font-semibold text-slate-600 hover:border-brand hover:text-brand">₹1k - ₹3k</a>
      <a href="{{ collection.url }}?filter.v.price.gte=3000&filter.v.price.lte=10000" class="rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 text-[11px] font-semibold text-slate-600 hover:border-brand hover:text-brand">₹3k - ₹10k</a>
      <a href="{{ collection.url }}?filter.v.price.gte=10000" class="rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 text-[11px] font-semibold text-slate-600 hover:border-brand hover:text-brand">Over ₹10k</a>
    </div>
  </div>

  <!-- Availability Filter -->
  <div class="border-b border-slate-100 pb-5">
    <h3 class="text-sm font-extrabold text-brand-ink">Availability</h3>
    <div class="mt-2.5 space-y-1">
      <a href="{{ collection.url }}?filter.v.availability=1" class="flex items-center gap-2 rounded-lg px-2 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-50 hover:text-brand-ink transition">
        <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>In Stock Only</span>
      </a>
      <a href="{{ collection.url }}" class="flex items-center gap-2 rounded-lg px-2 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-50 hover:text-brand-ink transition">
        <span class="h-2 w-2 rounded-full bg-slate-400"></span>
        <span>All Products</span>
      </a>
    </div>
  </div>

  <!-- Trust Badges -->
  <div class="rounded-2xl bg-brand-soft/70 p-4 space-y-3">
    <div class="flex items-center gap-2.5 text-xs font-bold text-brand-ink">
      <span class="text-brand">{% render 'icons', name: 'truck', class: 'h-4 w-4' %}</span>
      <span>Express Shipping</span>
    </div>
    <div class="flex items-center gap-2.5 text-xs font-bold text-brand-ink">
      <span class="text-brand">{% render 'icons', name: 'refresh', class: 'h-4 w-4' %}</span>
      <span>7-Day Easy Returns</span>
    </div>
    <div class="flex items-center gap-2.5 text-xs font-bold text-brand-ink">
      <span class="text-brand">{% render 'icons', name: 'shield', class: 'h-4 w-4' %}</span>
      <span>100% Genuine Quality</span>
    </div>
  </div>
</div>
