{% comment %}
  Kartzo Order Tracking section — 100% faithful to tracking.html prototype with full settings customization.
{% endcomment %}
{% render 'breadcrumbs', trail: 'Track Package' %}

<div class="pad site-max py-5 sm:py-8 max-w-4xl mx-auto">
  <div class="mb-5 border-b border-slate-200/80 pb-4 text-center sm:mb-8 sm:pb-6">
    <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-soft px-3 py-1 text-xs font-bold text-brand">
      <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 5h13v10H2zM15 9h4l3 3v3h-7z"/><circle cx="6" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></svg>
      {{ section.settings.badge | default: 'Courier Tracking' }}
    </span>
    <h1 class="mt-2 text-[1.45rem] font-extrabold leading-tight tracking-tight text-brand-ink sm:text-4xl">
      {{ section.settings.heading | default: 'Track Your Shipment' }}
    </h1>
    <p class="mt-1 text-xs sm:text-sm text-slate-500">{{ section.settings.subheading | default: 'Enter your Order ID and registered phone number to look up live status.' }}</p>
  </div>

  <!-- Tracking Lookup Form -->
  <form class="rounded-2xl border border-slate-200/80 bg-white p-4 shadow-sm sm:p-7">
    <div class="grid gap-4 sm:grid-cols-2">
      <label class="block text-xs font-bold text-slate-600">Order ID (e.g. KZ-10482)
        <input required class="mt-1.5 min-h-11 w-full rounded-xl border border-slate-200 bg-slate-50/50 px-3.5 text-xs sm:text-sm font-semibold text-brand-ink outline-none focus:border-brand focus:bg-white" value="{{ section.settings.demo_order_id | default: 'KZ-10482' }}">
      </label>
      <label class="block text-xs font-bold text-slate-600">Mobile Number / Email
        <input required class="mt-1.5 min-h-11 w-full rounded-xl border border-slate-200 bg-slate-50/50 px-3.5 text-xs sm:text-sm font-semibold text-brand-ink outline-none focus:border-brand focus:bg-white" value="{{ section.settings.demo_phone | default: '+91 98765 43210' }}">
      </label>
    </div>
    <button type="button" class="mt-4 flex min-h-11 w-full sm:w-auto items-center justify-center gap-2 rounded-xl bg-brand px-6 text-xs sm:text-sm font-bold text-white shadow-sm hover:bg-brand-dark transition">
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7.5"/><path d="m20 20-3.8-3.8"/></svg>
      <span>{{ section.settings.button_label | default: 'Track Order Details' }}</span>
    </button>
  </form>

  <!-- Active Shipment Status Card -->
  <div class="mt-5 rounded-2xl border border-slate-200/80 bg-white p-4 shadow-sm sm:mt-8 sm:p-8">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 pb-5">
      <div>
        <span class="rounded bg-brand-soft px-2.5 py-0.5 text-xs font-bold text-brand">{{ section.settings.carrier_name | default: 'Shipped via Blue Dart Express' }}</span>
        <h2 class="mt-1.5 text-base sm:text-lg font-black text-brand-ink">Order {{ section.settings.demo_order_id | default: 'KZ-10482' }} • AWB: {{ section.settings.demo_awb | default: 'BD-84920482' }}</h2>
        <p class="text-xs text-slate-500 mt-0.5">Estimated Delivery: <strong class="text-brand-ink">{{ section.settings.delivery_date | default: 'Friday, 10 Oct 2026' }}</strong></p>
      </div>
      <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-soft px-3 py-1 text-xs font-bold text-brand">
        <span class="h-2 w-2 rounded-full bg-brand animate-pulse"></span>
        {{ section.settings.status_label | default: 'In Transit' }}
      </span>
    </div>

    <!-- 4-Step Progress Milestone -->
    <ol class="mt-5 grid gap-2.5 grid-cols-2 sm:mt-8 sm:gap-4 sm:grid-cols-4">
      <li class="rounded-xl bg-emerald-50 p-3 text-center sm:p-4">
        <span class="mx-auto flex h-8 w-8 items-center justify-center rounded-full bg-emerald-600 text-white text-xs font-bold">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
        </span>
        <span class="mt-2 block text-xs font-extrabold text-emerald-800">Order Confirmed</span>
        <span class="block text-[10px] text-slate-500">6 Oct, 10:30 AM</span>
      </li>
      <li class="rounded-xl bg-emerald-50 p-3 text-center sm:p-4">
        <span class="mx-auto flex h-8 w-8 items-center justify-center rounded-full bg-emerald-600 text-white text-xs font-bold">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
        </span>
        <span class="mt-2 block text-xs font-extrabold text-emerald-800">Packed &amp; Dispatched</span>
        <span class="block text-[10px] text-slate-500">6 Oct, 04:15 PM</span>
      </li>
      <li class="rounded-xl bg-brand-soft p-3 text-center sm:p-4 ring-2 ring-brand/30">
        <span class="mx-auto flex h-8 w-8 items-center justify-center rounded-full bg-brand text-white text-xs font-bold">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 5h13v10H2zM15 9h4l3 3v3h-7z"/><circle cx="6" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></svg>
        </span>
        <span class="mt-2 block text-xs font-extrabold text-brand">In Transit</span>
        <span class="block text-[10px] text-slate-500">Hub Mumbai</span>
      </li>
      <li class="rounded-xl bg-slate-50 p-3 text-center sm:p-4">
        <span class="mx-auto flex h-8 w-8 items-center justify-center rounded-full bg-slate-200 text-slate-400 text-xs font-bold">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m16.5 9.4-9-5.19M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><path d="M3.27 6.96 12 12.01l8.73-5.05M12 22.08V12"/></svg>
        </span>
        <span class="mt-2 block text-xs font-extrabold text-slate-400">Out for Delivery</span>
        <span class="block text-[10px] text-slate-400">Expected 10 Oct</span>
      </li>
    </ol>

    <!-- Checkpoints Table -->
    <div class="mt-5 border-t border-slate-100 pt-4 sm:mt-8 sm:pt-6">
      <h3 class="text-xs font-extrabold uppercase tracking-wider text-brand-ink">Milestone History</h3>
      <div class="mt-4 space-y-3 text-xs">
        <div class="flex items-start gap-4">
          <span class="w-28 font-bold text-slate-400 shrink-0">8 Oct, 06:40 AM</span>
          <p class="font-bold text-brand-ink">Departed Mumbai Sorting Facility (En route to destination)</p>
        </div>
        <div class="flex items-start gap-4">
          <span class="w-28 font-bold text-slate-400 shrink-0">7 Oct, 09:12 PM</span>
          <p class="text-slate-500">Arrived at Central Logistics Sorting Center</p>
        </div>
        <div class="flex items-start gap-4">
          <span class="w-28 font-bold text-slate-400 shrink-0">6 Oct, 05:00 PM</span>
          <p class="text-slate-500">Package scanned and picked up by courier partner</p>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Order Tracking",
  "settings": [
    { "type": "text", "id": "badge", "label": "Badge", "default": "Courier Tracking" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Track Your Shipment" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Enter your Order ID and registered phone number to look up live status." },
    { "type": "text", "id": "demo_order_id", "label": "Example Order ID", "default": "KZ-10482" },
    { "type": "text", "id": "demo_phone", "label": "Example Phone/Email", "default": "+91 98765 43210" },
    { "type": "text", "id": "carrier_name", "label": "Carrier Name", "default": "Shipped via Blue Dart Express" },
    { "type": "text", "id": "demo_awb", "label": "Example AWB Number", "default": "BD-84920482" },
    { "type": "text", "id": "delivery_date", "label": "Estimated Delivery Date", "default": "Friday, 10 Oct 2026" },
    { "type": "text", "id": "status_label", "label": "Current Status", "default": "In Transit" },
    { "type": "text", "id": "button_label", "label": "Button Label", "default": "Track Order Details" }
  ],
  "presets": [{ "name": "Order Tracking" }]
}
{% endschema %}
