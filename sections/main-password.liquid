{% comment %} Password gate — native storefront-password form (no fake email capture). {% endcomment %}
<div class="pad mx-auto flex min-h-[80vh] w-full max-w-md flex-col items-center justify-center py-12 text-center">
  <img src="{{ 'logo.webp' | asset_url }}" alt="{{ shop.name | escape }}" width="541" height="168" class="h-10 w-auto">
  <h1 class="mt-5 text-3xl font-extrabold tracking-tight">{{ section.settings.heading | default: 'Opening Very Soon' }}</h1>
  <p class="mt-2 text-sm text-slate-500">{{ section.settings.sub | default: 'Enter your store password to preview the shop.' }}</p>
  {%- form 'storefront_password', class: 'mt-5 w-full' -%}
    {%- if form.errors -%}
      <p class="mb-2 text-sm font-semibold text-rose-600" role="alert">{{ form.errors | default_errors }}</p>
    {%- endif -%}
    <label for="store-password" class="sr-only">Store password</label>
    <div class="flex gap-2">
      <input id="store-password" name="password" type="password" required autocomplete="current-password" placeholder="Store password" class="min-h-11 w-full rounded-xl border border-slate-200 px-3 text-sm outline-none focus:border-brand">
      <button type="submit" name="commit" class="inline-flex min-h-11 shrink-0 items-center rounded-xl bg-brand px-5 text-sm font-bold text-white hover:bg-brand-dark">Enter</button>
    </div>
  {%- endform -%}
  <p class="mt-4 text-xs text-slate-400">Store owner? <a href="/admin" class="font-bold text-brand hover:underline">Log in</a></p>
</div>

{% schema %}
{
  "name": "Password gate",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Opening Very Soon" },
    { "type": "text", "id": "sub", "label": "Subtext", "default": "Enter your store password to preview the shop." }
  ],
  "presets": [{ "name": "Password gate" }]
}
{% endschema %}
