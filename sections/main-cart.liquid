{% comment %}
  Kartzo cart page — real cart state, Ajax qty/removal, discount-code reminder (codes apply
  at checkout — Shopify has no theme-level code redemption), native /checkout handoff.
{% endcomment %}
{%- assign cart_trail = cart.title | default: 'Cart' -%}
{% render 'breadcrumbs', trail: cart_trail %}

<div class="pad mx-auto w-full max-w-7xl pb-10 pt-4 sm:pt-6" data-cart-page>
  <h1 class="text-2xl font-extrabold tracking-tight sm:text-3xl">
    {{ 'general.cart_title' | t }} <span id="cart-item-count-label" class="text-base font-bold text-slate-400">({{ cart.item_count }})</span>
  </h1>

  {%- if cart.item_count > 0 -%}
    <div class="mt-5 grid gap-6 lg:grid-cols-[minmax(0,1fr)_360px]">
      <div class="space-y-4">
        {%- for item in cart.items -%}
          <article class="flex gap-4 rounded-2xl border border-[#e6eefb] bg-white p-4" data-key="{{ item.key }}">
            <a href="{{ item.url }}" class="flex h-24 w-24 shrink-0 items-center justify-center rounded-xl bg-slate-50 p-2">
              {%- if item.image -%}
                {{ item.image | image_url: width: 300 | image_tag: widths: '150, 300', loading: 'lazy', alt: item.image.alt | default: item.title, class: 'h-full w-auto object-contain' }}
              {%- endif -%}
            </a>
            <div class="flex min-w-0 flex-1 flex-col justify-between">
              <div class="flex items-start justify-between gap-2">
                <div class="min-w-0">
                  <a href="{{ item.url }}" class="block truncate text-sm font-bold text-brand-ink hover:text-brand">{{ item.product.title }}</a>
                  {%- unless item.product.has_only_default_variant -%}
                    <p class="text-xs text-slate-500">{{ item.variant.title }}</p>
                  {%- endunless -%}
                  {%- if item.selling_plan_allocation -%}
                    <p class="text-xs text-slate-500">{{ item.selling_plan_allocation.selling_plan.name }}</p>
                  {%- endif -%}
                </div>
                <button type="button" data-remove="{{ item.key }}" class="text-slate-400 hover:text-rose-500 transition" aria-label="{{ 'general.remove' | t }}: {{ item.product.title | escape }}">
                  {% render 'icons', name: 'trash', class: 'h-4 w-4' %}
                </button>
              </div>
              <div class="mt-2 flex items-center justify-between">
                <div data-qty data-min="0" data-max="10" data-key="{{ item.key }}" class="inline-flex items-center rounded-lg border border-slate-200 bg-slate-50">
                  <button type="button" class="qty-btn qty-minus flex h-9 w-9 items-center justify-center text-slate-600 hover:text-slate-900" aria-label="Decrease quantity">{% render 'icons', name: 'minus', class: 'h-3.5 w-3.5' %}</button>
                  <span data-qty-value class="min-w-[2rem] text-center text-sm font-bold">{{ item.quantity }}</span>
                  <button type="button" class="qty-btn qty-plus flex h-9 w-9 items-center justify-center text-slate-600 hover:text-slate-900" aria-label="Increase quantity">{% render 'icons', name: 'plus', class: 'h-3.5 w-3.5' %}</button>
                </div>
                <div class="text-right">
                  {%- if item.original_line_price != item.final_line_price -%}
                    <p class="text-xs text-slate-400 line-through">{{ item.original_line_price | money }}</p>
                  {%- endif -%}
                  <p class="text-sm font-extrabold">{{ item.final_line_price | money }}</p>
                </div>
              </div>
            </div>
          </article>
        {%- endfor -%}
        <a href="{{ routes.all_products_collection_url }}" class="inline-flex items-center gap-1 text-sm font-bold text-brand hover:underline">← {{ 'general.continue_shopping' | t }}</a>
      </div>

      <aside class="h-fit rounded-3xl border border-[#e6eefb] bg-[#f8fbff] p-5 lg:sticky lg:top-32">
        <h2 class="text-base font-extrabold">Order Summary</h2>
        <form data-discount-form class="mt-3">
          <label for="coupon-input" class="text-xs font-bold text-slate-600">Discount code</label>
          <div class="mt-1 flex gap-2">
            <input id="coupon-input" name="discount" type="text" autocomplete="off" placeholder="Enter code" class="min-h-11 w-full rounded-xl border border-slate-200 bg-white px-3 text-sm outline-none focus:border-brand">
            <button type="submit" class="inline-flex min-h-11 shrink-0 items-center rounded-xl bg-brand-ink px-4 text-sm font-bold text-white">Apply</button>
          </div>
          <p data-discount-msg hidden class="mt-2 text-xs font-semibold text-emerald-700" role="status"></p>
          <p class="mt-1 text-[11px] text-slate-400">Codes are redeemed on the checkout page.</p>
        </form>
        <dl class="mt-4 space-y-2 text-sm">
          <div class="flex justify-between text-slate-600"><dt>{{ 'general.subtotal' | t }}</dt><dd class="font-bold text-brand-ink" data-cart-subtotal>{{ cart.total_price | money }}</dd></div>
          {%- if cart.total_discount > 0 -%}
            <div class="flex justify-between text-emerald-700"><dt>Discounts</dt><dd class="font-bold">−{{ cart.total_discount | money }}</dd></div>
          {%- endif -%}
          <div class="flex justify-between border-t border-slate-200 pt-2 text-base font-extrabold"><dt>Total</dt><dd class="text-brand" data-cart-total>{{ cart.total_price | money }}</dd></div>
        </dl>
        <p class="mt-1 text-[11px] text-slate-400">Taxes included. Shipping calculated at checkout.</p>
        {%- form 'cart', cart -%}
          <button type="submit" name="checkout" class="mt-4 flex min-h-12 w-full items-center justify-center rounded-xl bg-brand text-sm font-extrabold text-white hover:bg-brand-dark transition">
            {{ 'general.checkout' | t }} →
          </button>
        {%- endform -%}
        <div class="mt-3 flex items-center justify-center gap-1.5 text-[11px] font-semibold text-slate-500">
          {% render 'icons', name: 'lock', class: 'h-3.5 w-3.5' %} Secure Shopify checkout
        </div>
      </aside>
    </div>

    {%- assign rec_collection = collections['all'] -%}
    {%- if rec_collection and rec_collection.products_count > 4 -%}
      <section class="mt-10" aria-label="Recommendations">
        <h2 class="text-xl font-extrabold tracking-tight">Popular Recommendations</h2>
        <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6">
          {%- assign shown = 0 -%}
          {%- for p in rec_collection.products -%}
            {%- assign in_cart = false -%}
            {%- for item in cart.items -%}
              {%- if item.product_id == p.id -%}{%- assign in_cart = true -%}{%- endif -%}
            {%- endfor -%}
            {%- unless in_cart -%}
              {% render 'product-card', product: p %}
              {%- assign shown = shown | plus: 1 -%}
              {%- if shown >= 6 -%}{%- break -%}{%- endif -%}
            {%- endunless -%}
          {%- endfor -%}
        </div>
      </section>
    {%- endif -%}
  {%- else -%}
    <div class="mt-5 rounded-3xl border border-dashed border-slate-300 px-6 py-16 text-center">
      {% render 'icons', name: 'cart', class: 'mx-auto h-12 w-12 text-slate-300' %}
      <p class="mt-3 text-lg font-extrabold">{{ 'general.empty_cart' | t }}</p>
      <p class="mt-1 text-sm text-slate-500">Discover products you'll love.</p>
      <a href="{{ routes.all_products_collection_url }}" class="mt-4 inline-flex min-h-11 items-center rounded-xl bg-brand px-6 text-sm font-bold text-white hover:bg-brand-dark">{{ 'general.browse_catalog' | t }}</a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Cart",
  "settings": [],
  "presets": [{ "name": "Cart" }]
}
{% endschema %}
