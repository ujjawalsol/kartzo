{% comment %}
  Kartzo footer — 100% customizable via Shopify Theme Editor.
  Supports blocks (Brand, Menu columns, Text, Newsletter) and flexible fallback defaults.
{% endcomment %}
{%- assign deals_url = pages['deals'].url | default: collections['deals'].url | default: section.settings.deals_url | default: '/pages/deals' -%}
{%- assign about_url = pages['about'].url | default: pages['about-us'].url | default: collections['about'].url | default: section.settings.about_url | default: '/pages/about' -%}
{%- assign contact_url = pages['contact'].url | default: section.settings.contact_url | default: '/pages/contact' -%}
{%- assign faq_url = pages['faq'].url | default: collections['faq'].url | default: section.settings.faq_url | default: '/pages/faq' -%}
{%- assign tracking_url = pages['tracking'].url | default: collections['tracking'].url | default: section.settings.tracking_url | default: '/pages/tracking' -%}
{%- assign returns_url = pages['returns-policy'].url | default: collections['returns-policy'].url | default: shop.refund_policy.url | default: '/pages/terms-conditions#return' -%}
{%- assign shipping_url = pages['shipping-policy'].url | default: collections['shipping-policy'].url | default: shop.shipping_policy.url | default: '/pages/terms-conditions#shipping' -%}
{%- assign cancel_url = pages['cancellation-policy'].url | default: collections['cancellation-policy'].url | default: '/pages/terms-conditions#cancel' -%}
{%- assign terms_url = pages['terms-conditions'].url | default: collections['terms-conditions'].url | default: shop.terms_of_service.url | default: '/pages/terms-conditions' -%}

<footer class="hidden lg:block border-t border-[#e8eef8] bg-white">
  <div class="pad mx-auto w-full grid grid-cols-1 gap-8 py-10 sm:grid-cols-2 lg:grid-cols-5">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'brand' -%}
            <div class="lg:col-span-2 space-y-4" {{ block.shopify_attributes }}>
              <a href="{{ routes.root_url }}" class="inline-block" aria-label="{{ shop.name }} home">
                {%- if block.settings.logo -%}
                  {%- assign logo_bw = block.settings.logo_width | default: 140 -%}
                  {{ block.settings.logo | image_url: width: 400 | image_tag: widths: '200, 400', alt: shop.name, style: 'width: auto; max-width: ' | append: logo_bw | append: 'px;', class: 'h-8 w-auto object-contain' }}
                {%- elsif section.settings.logo -%}
                  {{ section.settings.logo | image_url: width: 400 | image_tag: widths: '200, 400', alt: shop.name, class: 'h-8 w-auto object-contain' }}
                {%- else -%}
                  <img src="{{ 'logo.webp' | asset_url }}" alt="{{ shop.name | escape }}" width="300" height="169" class="h-8 w-auto">
                {%- endif -%}
              </a>
              {%- if block.settings.text != blank -%}
                <p class="max-w-sm text-xs sm:text-sm leading-relaxed text-slate-600">
                  {{ block.settings.text }}
                </p>
              {%- endif -%}

              {%- if block.settings.show_contact -%}
                {%- assign f_email = block.settings.email | default: section.settings.support_email | default: settings.support_email | default: 'support@kartzo.com' -%}
                {%- assign f_phone = block.settings.phone | default: section.settings.support_phone | default: settings.support_phone | default: '+91 76976 43683' -%}
                <div class="space-y-2 pt-1 text-xs text-slate-600">
                  <p class="flex items-center gap-2">
                    <svg class="h-4 w-4 text-brand shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
                    <a href="mailto:{{ f_email }}" class="hover:text-brand">{{ f_email }}</a>
                  </p>
                  <p class="flex items-center gap-2">
                    <svg class="h-4 w-4 text-brand shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M8 4h3l1 4-2 1a12 12 0 0 0 5 5l1-2 4 1v3c0 1-1 2-2 2C10 18 6 14 4 6c0-1 1-2 2-2z"/></svg>
                    <a href="tel:{{ f_phone | replace: ' ', '' }}" class="hover:text-brand">{{ f_phone }}</a>
                  </p>
                  <p class="flex items-start gap-2">
                    <svg class="h-4 w-4 text-brand shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z"/><circle cx="12" cy="10" r="2.2"/></svg>
                    <span>709, Kundan Nagar, Indore 452013, Madhya Pradesh, India</span>
                  </p>
                </div>
              {%- endif -%}

              {%- if block.settings.show_social -%}
                {%- assign fb = block.settings.facebook_url | default: settings.social_facebook -%}
                {%- assign insta = block.settings.instagram_url | default: settings.social_instagram -%}
                {%- assign tw = block.settings.x_url | default: settings.social_x -%}
                {%- assign yt = block.settings.youtube_url | default: settings.social_youtube -%}
                {%- if fb != blank or insta != blank or tw != blank or yt != blank -%}
                  <div class="flex items-center gap-2 pt-2">
                    {%- if fb != blank -%}
                      <a href="{{ fb }}" target="_blank" rel="noopener" class="flex h-9 w-9 items-center justify-center rounded-full border border-slate-200 text-slate-600 hover:border-brand hover:text-brand hover:bg-brand-soft transition" aria-label="Facebook">
                        <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 9h3V6h-3c-1.7 0-3 1.3-3 3v2H8v3h3v7h3v-7h3l1-3h-4V9c0-.6.4-1 1-1z"/></svg>
                      </a>
                    {%- endif -%}
                    {%- if insta != blank -%}
                      <a href="{{ insta }}" target="_blank" rel="noopener" class="flex h-9 w-9 items-center justify-center rounded-full border border-slate-200 text-slate-600 hover:border-brand hover:text-brand hover:bg-brand-soft transition" aria-label="Instagram">
                        <svg class="h-3.5 w-3.5 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="4"/><circle cx="12" cy="12" r="3.5"/><circle cx="17.5" cy="6.5" r="0.8" fill="currentColor"/></svg>
                      </a>
                    {%- endif -%}
                    {%- if tw != blank -%}
                      <a href="{{ tw }}" target="_blank" rel="noopener" class="flex h-9 w-9 items-center justify-center rounded-full border border-slate-200 text-slate-600 hover:border-brand hover:text-brand hover:bg-brand-soft transition" aria-label="X">
                        <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.5 3h3.1l-6.8 7.8L22 21h-6.2l-4.8-6.3L5.7 21H2.6l7.3-8.4L2 3h6.3l4.4 5.8L17.5 3zm-1.1 16.2h1.7L7.7 4.7H5.9l10.5 14.5z"/></svg>
                      </a>
                    {%- endif -%}
                    {%- if yt != blank -%}
                      <a href="{{ yt }}" target="_blank" rel="noopener" class="flex h-9 w-9 items-center justify-center rounded-full border border-slate-200 text-slate-600 hover:border-brand hover:text-brand hover:bg-brand-soft transition" aria-label="YouTube">
                        <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 12s0-3.3-.4-4.8a2.5 2.5 0 0 0-1.8-1.8C18.3 5 12 5 12 5s-6.3 0-7.8.4A2.5 2.5 0 0 0 2.4 7.2C2 8.7 2 12 2 12s0 3.3.4 4.8c.2.9.9 1.6 1.8 1.8 1.5.4 7.8.4 7.8.4s6.3 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8c.4-1.5.4-4.8.4-4.8zM10 15.5v-7l6 3.5z"/></svg>
                      </a>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              {%- endif -%}
            </div>

          {%- when 'link_list' -%}
            <nav aria-label="{{ block.settings.heading | escape }}" {{ block.shopify_attributes }}>
              <h2 class="text-xs font-extrabold uppercase tracking-wider text-brand-ink">{{ block.settings.heading }}</h2>
              <ul class="mt-4 space-y-2.5 text-xs sm:text-sm text-slate-600 font-medium">
                {%- if block.settings.menu != blank and block.settings.menu.links.size > 0 -%}
                  {%- for link in block.settings.menu.links -%}
                    <li><a href="{{ link.url }}" class="hover:text-brand transition">{{ link.title }}</a></li>
                  {%- endfor -%}
                {%- elsif block.settings.custom_link_1_title != blank -%}
                  {%- if block.settings.custom_link_1_title != blank -%}<li><a href="{{ block.settings.custom_link_1_url | default: '#' }}" class="hover:text-brand transition">{{ block.settings.custom_link_1_title }}</a></li>{%- endif -%}
                  {%- if block.settings.custom_link_2_title != blank -%}<li><a href="{{ block.settings.custom_link_2_url | default: '#' }}" class="hover:text-brand transition">{{ block.settings.custom_link_2_title }}</a></li>{%- endif -%}
                  {%- if block.settings.custom_link_3_title != blank -%}<li><a href="{{ block.settings.custom_link_3_url | default: '#' }}" class="hover:text-brand transition">{{ block.settings.custom_link_3_title }}</a></li>{%- endif -%}
                  {%- if block.settings.custom_link_4_title != blank -%}<li><a href="{{ block.settings.custom_link_4_url | default: '#' }}" class="hover:text-brand transition">{{ block.settings.custom_link_4_title }}</a></li>{%- endif -%}
                  {%- if block.settings.custom_link_5_title != blank -%}<li><a href="{{ block.settings.custom_link_5_url | default: '#' }}" class="hover:text-brand transition">{{ block.settings.custom_link_5_title }}</a></li>{%- endif -%}
                  {%- if block.settings.custom_link_6_title != blank -%}<li><a href="{{ block.settings.custom_link_6_url | default: '#' }}" class="hover:text-brand transition">{{ block.settings.custom_link_6_title }}</a></li>{%- endif -%}
                {%- else -%}
                  {%- assign head_lower = block.settings.heading | downcase -%}
                  {%- if head_lower contains 'catalog' or head_lower contains 'shop' -%}
                    <li><a href="{{ routes.all_products_collection_url }}" class="hover:text-brand transition">All Products</a></li>
                    <li><a href="{{ routes.collections_url }}" class="hover:text-brand transition">Shop by Category</a></li>
                    <li><a href="{{ deals_url }}" class="hover:text-brand transition">Flash Deals &amp; Offers</a></li>
                    <li><a href="{{ collections['best-sellers'].url | default: routes.all_products_collection_url }}" class="hover:text-brand transition">Best Sellers</a></li>
                    <li><a href="{{ collections['new-arrivals'].url | default: routes.all_products_collection_url }}" class="hover:text-brand transition">New Arrivals</a></li>
                  {%- elsif head_lower contains 'care' or head_lower contains 'help' or head_lower contains 'support' -%}
                    <li><a href="{{ tracking_url }}" class="hover:text-brand transition">Track Your Parcel</a></li>
                    <li><a href="{{ contact_url }}" class="hover:text-brand transition">Contact Support</a></li>
                    <li><a href="{{ faq_url }}" class="hover:text-brand transition">Help &amp; FAQs</a></li>
                    <li><a href="{{ returns_url }}" class="hover:text-brand transition">7-Day Returns Policy</a></li>
                    <li><a href="{{ shipping_url }}" class="hover:text-brand transition">Shipping Policy</a></li>
                    <li><a href="{{ cancel_url }}" class="hover:text-brand transition">Order Cancellation</a></li>
                  {%- else -%}
                    <li><a href="{{ about_url }}" class="hover:text-brand transition">About {{ shop.name }}</a></li>
                    <li><a href="{{ routes.account_url }}" class="hover:text-brand transition">Customer Account</a></li>
                    <li><a href="{{ terms_url }}" class="hover:text-brand transition">Terms &amp; Conditions</a></li>
                  {%- endif -%}
                {%- endif -%}
              </ul>
            </nav>

          {%- when 'text' -%}
            <div {{ block.shopify_attributes }}>
              <h2 class="text-xs font-extrabold uppercase tracking-wider text-brand-ink">{{ block.settings.heading }}</h2>
              <div class="mt-4 text-xs sm:text-sm leading-relaxed text-slate-600">
                {{ block.settings.subtext }}
              </div>
            </div>

          {%- when 'newsletter' -%}
            <div {{ block.shopify_attributes }}>
              <h2 class="text-xs font-extrabold uppercase tracking-wider text-brand-ink">{{ block.settings.heading | default: 'Newsletter' }}</h2>
              <p class="mt-2 text-xs text-slate-600">{{ block.settings.subtext | default: 'Subscribe to receive exclusive deals and updates.' }}</p>
              {% form 'customer', class: 'mt-4 flex flex-col gap-2' %}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <input
                  type="email"
                  name="contact[email]"
                  placeholder="Enter your email"
                  required
                  class="min-h-10 w-full rounded-xl border border-slate-200 bg-slate-50 px-3.5 text-xs font-medium text-brand-ink outline-none focus:border-brand focus:bg-white"
                >
                <button type="submit" class="min-h-10 rounded-xl bg-brand px-4 text-xs font-bold text-white hover:bg-brand-dark transition">
                  {{ block.settings.button_label | default: 'Subscribe' }}
                </button>
              {% endform %}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    {%- else -%}
      <!-- Default 4-column fallback if no blocks configured -->
      <div class="lg:col-span-2 space-y-4">
        <a href="{{ routes.root_url }}" class="inline-block" aria-label="{{ shop.name }} home">
          {%- if section.settings.logo -%}
            {{ section.settings.logo | image_url: width: 400 | image_tag: widths: '200, 400', alt: shop.name, class: 'h-8 w-auto' }}
          {%- else -%}
            <img src="{{ 'logo.webp' | asset_url }}" alt="{{ shop.name | escape }}" width="300" height="169" class="h-8 w-auto">
          {%- endif -%}
        </a>
        <p class="max-w-sm text-xs sm:text-sm leading-relaxed text-slate-600">
          {{ section.settings.mission | default: "Kartzo delivers curated essentials across consumer technology, fashion, and home lifestyle with guaranteed authentic sourcing, fair pricing, and direct doorstep returns." }}
        </p>
        <div class="space-y-2 pt-1 text-xs text-slate-600">
          <p class="flex items-center gap-2">
            <svg class="h-4 w-4 text-brand shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            <a href="mailto:{{ section.settings.support_email | default: settings.support_email | default: 'support@kartzo.com' }}" class="hover:text-brand">{{ section.settings.support_email | default: settings.support_email | default: 'support@kartzo.com' }}</a>
          </p>
          <p class="flex items-center gap-2">
            <svg class="h-4 w-4 text-brand shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M8 4h3l1 4-2 1a12 12 0 0 0 5 5l1-2 4 1v3c0 1-1 2-2 2C10 18 6 14 4 6c0-1 1-2 2-2z"/></svg>
            <a href="tel:{{ section.settings.support_phone | default: settings.support_phone | default: '+91 76976 43683' | replace: ' ', '' }}" class="hover:text-brand">{{ section.settings.support_phone | default: settings.support_phone | default: '+91 76976 43683' }}</a>
          </p>
          <p class="flex items-start gap-2">
            <svg class="h-4 w-4 text-brand shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z"/><circle cx="12" cy="10" r="2.2"/></svg>
            <span>709, Kundan Nagar, Indore 452013, Madhya Pradesh, India</span>
          </p>
        </div>
      </div>

      <nav aria-label="Shop Catalog">
        <h2 class="text-xs font-extrabold uppercase tracking-wider text-brand-ink">Shop Catalog</h2>
        <ul class="mt-4 space-y-2.5 text-xs sm:text-sm text-slate-600 font-medium">
          <li><a href="{{ routes.all_products_collection_url }}" class="hover:text-brand transition">All Products</a></li>
          <li><a href="{{ routes.collections_url }}" class="hover:text-brand transition">Shop by Category</a></li>
          <li><a href="{{ deals_url }}" class="hover:text-brand transition">Flash Deals &amp; Offers</a></li>
          <li><a href="{{ collections['best-sellers'].url | default: routes.all_products_collection_url }}" class="hover:text-brand transition">Best Sellers</a></li>
          <li><a href="{{ collections['new-arrivals'].url | default: routes.all_products_collection_url }}" class="hover:text-brand transition">New Arrivals</a></li>
        </ul>
      </nav>

      <nav aria-label="Customer Care">
        <h2 class="text-xs font-extrabold uppercase tracking-wider text-brand-ink">Customer Care</h2>
        <ul class="mt-4 space-y-2.5 text-xs sm:text-sm text-slate-600 font-medium">
          <li><a href="{{ tracking_url }}" class="hover:text-brand transition">Track Your Parcel</a></li>
          <li><a href="{{ contact_url }}" class="hover:text-brand transition">Contact Support</a></li>
          <li><a href="{{ faq_url }}" class="hover:text-brand transition">Help &amp; FAQs</a></li>
          <li><a href="{{ returns_url }}" class="hover:text-brand transition">7-Day Returns Policy</a></li>
          <li><a href="{{ shipping_url }}" class="hover:text-brand transition">Shipping Policy</a></li>
          <li><a href="{{ cancel_url }}" class="hover:text-brand transition">Order Cancellation</a></li>
        </ul>
      </nav>

      <nav aria-label="Company">
        <h2 class="text-xs font-extrabold uppercase tracking-wider text-brand-ink">Company</h2>
        <ul class="mt-4 space-y-2.5 text-xs sm:text-sm text-slate-600 font-medium">
          <li><a href="{{ about_url }}" class="hover:text-brand transition">About {{ shop.name }}</a></li>
          <li><a href="{{ routes.account_url }}" class="hover:text-brand transition">Customer Account</a></li>
          <li><a href="{{ terms_url }}" class="hover:text-brand transition">Terms &amp; Conditions</a></li>
        </ul>
      </nav>
    {%- endif -%}
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-slate-100 bg-slate-50">
    <div class="pad mx-auto flex w-full flex-col gap-4 py-6 sm:flex-row sm:items-center sm:justify-between text-xs text-slate-500 font-medium">
      <p>{{ section.settings.copyright_text | default: shop.name }} &copy; {{ 'now' | date: '%Y' }}. All rights reserved.</p>
      {%- if section.settings.show_payment_badges -%}
        {%- assign payment_badges = section.settings.payment_methods | default: 'Visa,Mastercard,RuPay,UPI,Net Banking,COD' | split: ',' -%}
        <div class="flex flex-wrap items-center gap-2 text-[11px] text-slate-600 font-semibold" aria-label="Accepted payment methods">
          {%- for method in payment_badges -%}
            <span class="rounded bg-white border border-slate-200 px-2 py-0.5">{{ method | strip }}</span>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Default Logo" },
    { "type": "textarea", "id": "mission", "label": "Default brand mission text", "default": "Kartzo delivers curated essentials across consumer technology, fashion, and home lifestyle with guaranteed authentic sourcing, fair pricing, and direct doorstep returns." },
    { "type": "text", "id": "support_email", "label": "Support Email", "default": "support@kartzo.com" },
    { "type": "text", "id": "support_phone", "label": "Support Phone", "default": "+91 76976 43683" },
    { "type": "url", "id": "deals_url", "label": "Flash Deals link" },
    { "type": "url", "id": "about_url", "label": "About Us link" },
    { "type": "url", "id": "contact_url", "label": "Contact link" },
    { "type": "url", "id": "faq_url", "label": "FAQ link" },
    { "type": "url", "id": "tracking_url", "label": "Tracking link" },
    { "type": "url", "id": "size_url", "label": "Size guide link" },
    { "type": "text", "id": "copyright_text", "label": "Copyright notice" },
    { "type": "checkbox", "id": "show_payment_badges", "label": "Show payment badges", "default": true },
    { "type": "text", "id": "payment_methods", "label": "Payment methods (comma-separated)", "default": "Visa,Mastercard,RuPay,UPI,Net Banking,COD" }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand & Contact",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Logo" },
        { "type": "range", "id": "logo_width", "label": "Logo width", "min": 80, "max": 240, "step": 4, "default": 140, "unit": "px" },
        { "type": "textarea", "id": "text", "label": "Brand description", "default": "Kartzo delivers curated essentials across consumer technology, fashion, and home lifestyle with guaranteed authentic sourcing, fair pricing, and direct doorstep returns." },
        { "type": "checkbox", "id": "show_contact", "label": "Show contact details", "default": true },
        { "type": "text", "id": "email", "label": "Support email", "default": "support@kartzo.com" },
        { "type": "text", "id": "phone", "label": "Support phone", "default": "+91 76976 43683" },
        { "type": "checkbox", "id": "show_social", "label": "Show social icons", "default": true },
        { "type": "url", "id": "facebook_url", "label": "Facebook URL" },
        { "type": "url", "id": "instagram_url", "label": "Instagram URL" },
        { "type": "url", "id": "x_url", "label": "X (Twitter) URL" },
        { "type": "url", "id": "youtube_url", "label": "YouTube URL" }
      ]
    },
    {
      "type": "link_list",
      "name": "Menu / Link Column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Column Heading", "default": "Shop Catalog" },
        { "type": "link_list", "id": "menu", "label": "Navigation Menu (leave empty for smart defaults)" },
        { "type": "header", "content": "Or Custom Direct Links" },
        { "type": "text", "id": "custom_link_1_title", "label": "Link 1 Title" },
        { "type": "url", "id": "custom_link_1_url", "label": "Link 1 URL" },
        { "type": "text", "id": "custom_link_2_title", "label": "Link 2 Title" },
        { "type": "url", "id": "custom_link_2_url", "label": "Link 2 URL" },
        { "type": "text", "id": "custom_link_3_title", "label": "Link 3 Title" },
        { "type": "url", "id": "custom_link_3_url", "label": "Link 3 URL" },
        { "type": "text", "id": "custom_link_4_title", "label": "Link 4 Title" },
        { "type": "url", "id": "custom_link_4_url", "label": "Link 4 URL" },
        { "type": "text", "id": "custom_link_5_title", "label": "Link 5 Title" },
        { "type": "url", "id": "custom_link_5_url", "label": "Link 5 URL" },
        { "type": "text", "id": "custom_link_6_title", "label": "Link 6 Title" },
        { "type": "url", "id": "custom_link_6_url", "label": "Link 6 URL" }
      ]
    },
    {
      "type": "text",
      "name": "Custom Text",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "About Us" },
        { "type": "richtext", "id": "subtext", "label": "Text", "default": "<p>Share store details, promotions, or brand values with your customers.</p>" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Stay in the Loop" },
