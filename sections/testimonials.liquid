{% comment %} Customer reviews — merchant-managed testimonial blocks (no fabricated aggregate scores). {% endcomment %}
<section class="pad w-full pb-8" aria-labelledby="reviews-title">
  <div class="mb-4 flex items-center justify-between gap-3">
    <h2 id="reviews-title" class="text-xl font-extrabold tracking-tight sm:text-2xl">{{ section.settings.heading_first }} <span class="text-brand">{{ section.settings.heading_accent }}</span></h2>
  </div>
  {%- if section.blocks.size > 0 -%}
    <div class="no-scrollbar flex gap-3 overflow-x-auto pb-2 sm:grid sm:grid-cols-3 sm:overflow-visible lg:gap-4">
      {%- for block in section.blocks -%}
        <figure class="w-72 shrink-0 rounded-2xl border border-[#e6eefb] bg-white p-4 shadow-[0_2px_10px_rgba(15,50,120,0.04)] sm:w-auto" {{ block.shopify_attributes }}>
          <div class="flex items-center gap-1" aria-hidden="true">
            {%- for i in (1..5) -%}
              {%- assign star_class = 'h-3.5 w-3.5 fill-slate-200 text-slate-200' -%}
              {%- if i <= block.settings.stars -%}
                {%- assign star_class = 'h-3.5 w-3.5 fill-amber-400 text-amber-400' -%}
              {%- endif -%}
              {% render 'icons', name: 'star', class: star_class %}
            {%- endfor -%}
          </div>
          <blockquote class="mt-2 text-sm leading-relaxed text-slate-600">“{{ block.settings.quote }}”</blockquote>
          <figcaption class="mt-3 flex items-center gap-2.5">
            {%- if block.settings.avatar -%}
              {{ block.settings.avatar | image_url: width: 80 | image_tag: loading: 'lazy', alt: block.settings.name | default: '', class: 'h-9 w-9 rounded-full object-cover' }}
            {%- elsif block.settings.avatar_asset != blank -%}
              <img src="{{ block.settings.avatar_asset | asset_url }}" alt="{{ block.settings.name | escape }}" width="80" height="80" class="h-9 w-9 rounded-full object-cover" loading="lazy">
            {%- elsif forloop.index == 1 -%}
              <img src="{{ 'avatar-rahul.webp' | asset_url }}" alt="{{ block.settings.name | escape }}" width="80" height="80" class="h-9 w-9 rounded-full object-cover" loading="lazy">
            {%- elsif forloop.index == 2 -%}
              <img src="{{ 'avatar-priya.webp' | asset_url }}" alt="{{ block.settings.name | escape }}" width="80" height="80" class="h-9 w-9 rounded-full object-cover" loading="lazy">
            {%- elsif forloop.index == 3 -%}
              <img src="{{ 'avatar-amit.webp' | asset_url }}" alt="{{ block.settings.name | escape }}" width="80" height="80" class="h-9 w-9 rounded-full object-cover" loading="lazy">
            {%- else -%}
              <span class="flex h-9 w-9 items-center justify-center rounded-full bg-brand-soft text-xs font-black text-brand" aria-hidden="true">{{ block.settings.name | slice: 0 }}</span>
            {%- endif -%}
            <span><span class="block text-sm font-extrabold">{{ block.settings.name }}</span>
            {%- if block.settings.detail != blank -%}<span class="block text-xs text-slate-500">{{ block.settings.detail }}</span>{%- endif -%}</span>
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>
  {%- else -%}
    <div class="no-scrollbar flex gap-3 overflow-x-auto pb-2 sm:grid sm:grid-cols-3 sm:overflow-visible lg:gap-4">
      <figure class="w-72 shrink-0 rounded-2xl border border-[#e6eefb] bg-white p-4 shadow-[0_2px_10px_rgba(15,50,120,0.04)] sm:w-auto">
        <div class="flex items-center gap-1" aria-hidden="true">
          {%- for i in (1..5) -%}{% render 'icons', name: 'star', class: 'h-3.5 w-3.5 fill-amber-400 text-amber-400' %}{%- endfor -%}
        </div>
        <blockquote class="mt-2 text-sm leading-relaxed text-slate-600">“Amazing quality products and super fast delivery. Kartzo is now my go-to store!”</blockquote>
        <figcaption class="mt-3 flex items-center gap-2.5">
          <img src="{{ 'avatar-rahul.webp' | asset_url }}" alt="Rahul Mehta" width="80" height="80" class="h-9 w-9 rounded-full object-cover" loading="lazy">
          <span><span class="block text-sm font-extrabold">Rahul Mehta</span><span class="block text-xs text-slate-500">Verified Buyer</span></span>
        </figcaption>
      </figure>
      <figure class="w-72 shrink-0 rounded-2xl border border-[#e6eefb] bg-white p-4 shadow-[0_2px_10px_rgba(15,50,120,0.04)] sm:w-auto">
        <div class="flex items-center gap-1" aria-hidden="true">
          {%- for i in (1..5) -%}{% render 'icons', name: 'star', class: 'h-3.5 w-3.5 fill-amber-400 text-amber-400' %}{%- endfor -%}
        </div>
        <blockquote class="mt-2 text-sm leading-relaxed text-slate-600">“Loved the shopping experience. Great prices on products and excellent customer support.”</blockquote>
        <figcaption class="mt-3 flex items-center gap-2.5">
          <img src="{{ 'avatar-priya.webp' | asset_url }}" alt="Priya Sharma" width="80" height="80" class="h-9 w-9 rounded-full object-cover" loading="lazy">
          <span><span class="block text-sm font-extrabold">Priya Sharma</span><span class="block text-xs text-slate-500">Verified Buyer</span></span>
        </figcaption>
      </figure>
      <figure class="w-72 shrink-0 rounded-2xl border border-[#e6eefb] bg-white p-4 shadow-[0_2px_10px_rgba(15,50,120,0.04)] sm:w-auto">
        <div class="flex items-center gap-1" aria-hidden="true">
          {%- for i in (1..5) -%}{% render 'icons', name: 'star', class: 'h-3.5 w-3.5 fill-amber-400 text-amber-400' %}{%- endfor -%}
        </div>
        <blockquote class="mt-2 text-sm leading-relaxed text-slate-600">“Wide range of products and genuine quality. Highly recommend Kartzo!”</blockquote>
        <figcaption class="mt-3 flex items-center gap-2.5">
          <img src="{{ 'avatar-amit.webp' | asset_url }}" alt="Amit Verma" width="80" height="80" class="h-9 w-9 rounded-full object-cover" loading="lazy">
          <span><span class="block text-sm font-extrabold">Amit Verma</span><span class="block text-xs text-slate-500">Verified Buyer</span></span>
        </figcaption>
      </figure>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "text", "id": "heading_first", "label": "Heading (dark part)", "default": "What Our" },
    { "type": "text", "id": "heading_accent", "label": "Heading (brand part)", "default": "Customers Say" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Great quality and fast delivery. Shopping here is easy." },
        { "type": "text", "id": "name", "label": "Name", "default": "Happy customer" },
        { "type": "text", "id": "detail", "label": "Detail (e.g. Verified buyer)", "default": "Verified buyer" },
        { "type": "range", "id": "stars", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "image_picker", "id": "avatar", "label": "Avatar" },
        { "type": "text", "id": "avatar_asset", "label": "Theme asset avatar filename" }
      ]
    }
  ],
  "presets": [{ "name": "Testimonials", "blocks": [{ "type": "review" }, { "type": "review" }, { "type": "review" }] }]
}
{% endschema %}
