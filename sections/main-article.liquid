{% comment %} Article — real article content, author, share, related product via metafield-free picker. {% endcomment %}
{% render 'breadcrumbs', trail: blog.title %}

<article class="pad mx-auto w-full max-w-3xl pb-12 pt-4 sm:pt-6">
  <p class="text-[11px] font-bold uppercase tracking-wider text-brand">{{ blog.title }}</p>
  <h1 class="mt-1 text-2xl font-extrabold tracking-tight sm:text-4xl">{{ article.title }}</h1>
  <p class="mt-2 text-xs font-semibold text-slate-400">{{ article.published_at | date: '%d %b %Y' }} · {{ article.author }}{% if article.comments_enabled %} · {{ article.comments_count }} comments{% endif %}</p>

  {%- if article.image -%}
    {{ article.image | image_url: width: 1600 | image_tag: widths: '750, 1200, 1600', fetchpriority: 'high', alt: '', class: 'mt-5 aspect-[16/9] w-full rounded-3xl object-cover' }}
  {%- endif -%}

  <div class="prose-kartzo mt-6 space-y-4 text-sm leading-relaxed text-slate-600 sm:text-base">
    {{ article.content }}
  </div>

  {%- if section.settings.product -%}
    <aside class="mt-8 rounded-3xl border border-[#e6eefb] bg-[#f8fbff] p-4" aria-label="Featured product">
      <p class="text-[11px] font-extrabold uppercase tracking-wider text-slate-400">Featured in this guide</p>
      <div class="mt-2">
        {% render 'product-card', product: section.settings.product %}
      </div>
    </aside>
  {%- endif -%}

  <div class="mt-6 flex items-center gap-2">
    <span class="text-sm font-bold">Share:</span>
    <a href="https://www.facebook.com/sharer/sharer.php?u={{ shop.url | append: article.url | url_encode }}" target="_blank" rel="noopener" class="flex h-9 w-9 items-center justify-center rounded-full border border-slate-200 text-slate-600 hover:border-brand hover:text-brand" aria-label="Share on Facebook">
      <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 9h3V6h-3c-1.7 0-3 1.3-3 3v2H8v3h3v7h3v-7h3l1-3h-4V9c0-.6.4-1 1-1z"/></svg>
    </a>
    <a href="https://twitter.com/intent/tweet?url={{ shop.url | append: article.url | url_encode }}&text={{ article.title | url_encode }}" target="_blank" rel="noopener" class="flex h-9 w-9 items-center justify-center rounded-full border border-slate-200 text-slate-600 hover:border-brand hover:text-brand" aria-label="Share on X">
      <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.5 3h3.1l-6.8 7.8L22 21h-6.2l-4.8-6.3L5.7 21H2.6l7.3-8.4L2 3h6.3l4.4 5.8L17.5 3zm-1.1 16.2h1.7L7.7 4.7H5.9l10.5 14.5z"/></svg>
    </a>
  </div>

  {%- if blog.comments_enabled? -%}
    {%- paginate article.comments by 10 -%}
    {%- if article.comments_count > 0 -%}
    <section class="mt-8" aria-label="Comments">
      <h2 class="text-lg font-extrabold">Comments ({{ article.comments_count }})</h2>
      <ul class="mt-3 space-y-3">
        {%- for comment in article.comments -%}
          <li class="rounded-2xl border border-[#e6eefb] p-4">
            <p class="text-sm font-bold">{{ comment.author }}</p>
            <p class="text-xs text-slate-400">{{ comment.created_at | date: '%d %b %Y' }}</p>
            <div class="mt-1 text-sm text-slate-600">{{ comment.content }}</div>
          </li>
        {%- endfor -%}
      </ul>
      {%- if paginate.pages > 1 -%}
        <nav class="mt-3 flex items-center gap-2" aria-label="Comment pages">{{ paginate | default_pagination }}</nav>
      {%- endif -%}
    </section>
    {%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}

  {%- if blog.comments_enabled? -%}
    <section class="mt-8 rounded-3xl border border-[#e6eefb] p-5" aria-label="Leave a comment">
      <h2 class="text-lg font-extrabold">Leave a comment</h2>
      {%- form 'new_comment', article -%}
        {%- if form.posted_successfully? -%}
          <p class="mt-2 rounded-xl bg-emerald-50 px-4 py-3 text-sm font-bold text-emerald-700" role="status">Thanks — your comment is awaiting moderation.</p>
        {%- endif -%}
        {%- if form.errors -%}
          <div class="mt-2 rounded-xl bg-rose-50 px-4 py-3 text-sm font-semibold text-rose-700" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          <div>
            <label for="comment-author" class="text-xs font-bold text-slate-600">Name</label>
            <input id="comment-author" name="comment[author]" type="text" required autocomplete="name" class="mt-1 min-h-11 w-full rounded-xl border border-slate-200 px-3 text-sm outline-none focus:border-brand">
          </div>
          <div>
            <label for="comment-email" class="text-xs font-bold text-slate-600">Email</label>
            <input id="comment-email" name="comment[email]" type="email" required autocomplete="email" class="mt-1 min-h-11 w-full rounded-xl border border-slate-200 px-3 text-sm outline-none focus:border-brand">
          </div>
          <div class="sm:col-span-2">
            <label for="comment-body" class="text-xs font-bold text-slate-600">Comment</label>
            <textarea id="comment-body" name="comment[body]" rows="4" required class="mt-1 w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm outline-none focus:border-brand"></textarea>
          </div>
        </div>
        <button type="submit" class="mt-3 inline-flex min-h-11 items-center rounded-xl bg-brand px-6 text-sm font-bold text-white hover:bg-brand-dark">Post comment</button>
      {%- endform -%}
    </section>
  {%- endif -%}
</article>

{% schema %}
{
  "name": "Article",
  "settings": [
    { "type": "product", "id": "product", "label": "Featured product (optional)" }
  ],
  "presets": [{ "name": "Article" }]
}
{% endschema %}
