{% comment %} Blog preview — real blog + articles. {% endcomment %}
<section id="blog" class="pad hidden w-full pb-8 sm:block" aria-label="Blog">
  <div class="mb-4 flex items-center justify-between gap-3">
    <h2 class="text-xl font-extrabold tracking-tight sm:text-2xl">{{ section.settings.heading_first }} <span class="text-brand">{{ section.settings.heading_accent }}</span></h2>
    {%- if section.settings.blog -%}
      <a href="{{ section.settings.blog.url }}" class="text-sm font-bold text-brand hover:underline">{{ 'general.view_all' | t }} →</a>
    {%- endif -%}
  </div>
  {%- assign target_blog = section.settings.blog -%}
  {%- if target_blog == blank or target_blog.articles.size == 0 -%}
    {%- if blogs.news and blogs.news.articles.size > 0 -%}
      {%- assign target_blog = blogs.news -%}
    {%- endif -%}
  {%- endif -%}

  {%- if target_blog and target_blog.articles.size > 0 -%}
    <div class="grid gap-4 sm:grid-cols-3">
      {%- for article in target_blog.articles limit: 3 -%}
        <article class="overflow-hidden rounded-2xl border border-[#e6eefb] bg-white transition hover:border-[#b9d0ff] hover:shadow-card">
          <a href="{{ article.url }}" class="block aspect-[16/9] overflow-hidden bg-[#F6F8FB]" tabindex="-1" aria-hidden="true">
            {%- if article.image -%}
              {{ article.image | image_url: width: 800 | image_tag: widths: '400, 800', loading: 'lazy', alt: article.title | default: '', class: 'h-full w-full object-cover' }}
            {%- endif -%}
          </a>
          <div class="p-4">
            <p class="text-[11px] font-bold uppercase tracking-wider text-slate-400">{{ article.published_at | date: '%d %b %Y' }}</p>
            <h3 class="mt-1 text-sm font-extrabold leading-snug"><a href="{{ article.url }}" class="hover:text-brand">{{ article.title }}</a></h3>
            {%- if article.excerpt != blank -%}
              <p class="mt-1 line-clamp-2 text-xs text-slate-500">{{ article.excerpt | strip_html }}</p>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  {%- else -%}
    {%- comment -%} Kartzo demo articles matching index.html {%- endcomment -%}
    <div class="grid gap-4 sm:grid-cols-3">
      <article class="overflow-hidden rounded-2xl border border-[#e6eefb] bg-white transition hover:border-[#b9d0ff] hover:shadow-card">
        <div class="block aspect-[16/9] overflow-hidden bg-[#F6F8FB]">
          <img src="{{ 'blog-gadgets.webp' | asset_url }}" alt="Top 10 Gadgets You Need in 2026" width="800" height="450" class="h-full w-full object-cover" loading="lazy">
        </div>
        <div class="p-4">
          <p class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Buying Guide</p>
          <h3 class="mt-1 text-sm font-extrabold leading-snug"><span class="text-brand-ink">Top 10 Gadgets You Need in 2026</span></h3>
          <p class="mt-1 line-clamp-2 text-xs text-slate-500">Discover the latest tech innovations that make everyday living smarter and simpler.</p>
        </div>
      </article>
      <article class="overflow-hidden rounded-2xl border border-[#e6eefb] bg-white transition hover:border-[#b9d0ff] hover:shadow-card">
        <div class="block aspect-[16/9] overflow-hidden bg-[#F6F8FB]">
          <img src="{{ 'blog-home.webp' | asset_url }}" alt="Home Decor Trends to Elevate Your Space" width="800" height="450" class="h-full w-full object-cover" loading="lazy">
        </div>
        <div class="p-4">
          <p class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Home &amp; Living</p>
          <h3 class="mt-1 text-sm font-extrabold leading-snug"><span class="text-brand-ink">Home Decor Trends to Elevate Your Space</span></h3>
          <p class="mt-1 line-clamp-2 text-xs text-slate-500">Simple interior styling ideas to make your living room comfortable, stylish and welcoming.</p>
        </div>
      </article>
      <article class="overflow-hidden rounded-2xl border border-[#e6eefb] bg-white transition hover:border-[#b9d0ff] hover:shadow-card">
        <div class="block aspect-[16/9] overflow-hidden bg-[#F6F8FB]">
          <img src="{{ 'blog-shopping.webp' | asset_url }}" alt="Smart Shopping: How to Get the Best Deals Online" width="800" height="450" class="h-full w-full object-cover" loading="lazy">
        </div>
        <div class="p-4">
          <p class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Smart Tips</p>
          <h3 class="mt-1 text-sm font-extrabold leading-snug"><span class="text-brand-ink">Smart Shopping: How to Get the Best Deals Online</span></h3>
          <p class="mt-1 line-clamp-2 text-xs text-slate-500">Expert tips on discount timing, product comparisons, and shopping essentials on a budget.</p>
        </div>
      </article>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Blog posts",
  "settings": [
    { "type": "text", "id": "heading_first", "label": "Heading (dark part)", "default": "Latest from" },
    { "type": "text", "id": "heading_accent", "label": "Heading (brand part)", "default": "Our Blog" },
    { "type": "blog", "id": "blog", "label": "Blog" }
  ],
  "presets": [{ "name": "Blog posts" }]
}
{% endschema %}
