{% comment %}
  Ajax cart drawer — same visuals as the original, wired to real Shopify cart state.
  JS re-renders items from /cart.js; Liquid renders the initial server state for no-JS.
{% endcomment %}
<div
  id="cart-drawer"
  class="drawer-backdrop fixed inset-0 z-[80] bg-slate-950/60 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-labelledby="drawer-title"
>
  <div class="drawer-panel ml-auto flex h-full w-full max-w-md flex-col bg-white shadow-2xl" tabindex="-1">
    <div class="flex items-center justify-between border-b border-slate-200 px-6 py-5">
      <div class="flex items-center gap-2.5">
        <h2 id="drawer-title" class="text-base font-extrabold text-brand-ink">{{ 'general.cart_title' | t }}</h2>
        <span id="drawer-cart-count" data-cart-count class="rounded-full bg-brand-soft px-2.5 py-0.5 text-xs font-black text-brand">{{ cart.item_count }}</span>
      </div>
      <button type="button" data-cart-drawer-close class="flex h-9 w-9 items-center justify-center rounded-full text-slate-400 hover:bg-slate-100 hover:text-slate-700 transition" aria-label="{{ 'general.close' | t }}">
        {% render 'icons', name: 'close', class: 'h-4 w-4' %}
      </button>
    </div>

    <div class="border-b border-slate-100 bg-slate-50/70 px-6 py-3.5" data-ship-meter>
      <div class="flex items-center justify-between gap-2 text-xs font-semibold text-brand-ink">
        <span id="drawer-shipping-text" data-ship-text class="inline-flex items-center gap-1.5"></span>
        <span data-ship-goal class="font-extrabold text-emerald-600"></span>
      </div>
      <div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-slate-200">
        <div id="drawer-shipping-progress" data-ship-bar class="h-full rounded-full bg-emerald-600 transition-all duration-300" style="width: 0%;"></div>
      </div>
    </div>

    <div class="flex-1 space-y-4 overflow-y-auto p-6" id="drawer-items" data-cart-items>
      {%- if cart.item_count > 0 -%}
        {%- for item in cart.items -%}
          <article class="drawer-item flex gap-4 rounded-2xl border border-slate-200/80 bg-white p-3.5 shadow-sm" data-key="{{ item.key }}" data-price="{{ item.final_price }}">
            <a href="{{ item.url }}" class="flex h-20 w-20 shrink-0 items-center justify-center rounded-xl bg-slate-50 p-2">
              {%- if item.image -%}
                {{ item.image | image_url: width: 200 | image_tag: widths: '100, 200', loading: 'lazy', alt: item.image.alt | default: item.title, class: 'h-full w-auto object-contain' }}
              {%- endif -%}
            </a>
            <div class="flex min-w-0 flex-1 flex-col justify-between">
              <div class="flex items-start justify-between gap-1">
                <div class="min-w-0">
                  <a href="{{ item.url }}" class="block truncate text-xs sm:text-sm font-bold text-brand-ink hover:text-brand transition">{{ item.product.title }}</a>
                  {%- unless item.product.has_only_default_variant -%}
                    <p class="text-[11px] text-slate-500">{{ item.variant.title }}</p>
                  {%- endunless -%}
                </div>
                <button type="button" class="drawer-remove-item text-slate-400 hover:text-rose-500 transition" data-remove="{{ item.key }}" aria-label="{{ 'general.remove' | t }}: {{ item.product.title | escape }}">
                  {% render 'icons', name: 'trash', class: 'h-4 w-4' %}
                </button>
              </div>
              <div class="mt-2.5 flex items-center justify-between">
                <div data-qty data-min="0" data-max="10" data-key="{{ item.key }}" class="inline-flex items-center rounded-lg border border-slate-200 bg-slate-50">
                  <button type="button" class="qty-btn qty-minus flex h-7 w-7 items-center justify-center text-slate-600 hover:text-slate-900" aria-label="Decrease quantity">{% render 'icons', name: 'minus', class: 'h-3 w-3' %}</button>
                  <span data-qty-value class="min-w-[1.5rem] text-center text-xs font-bold text-brand-ink">{{ item.quantity }}</span>
                  <button type="button" class="qty-btn qty-plus flex h-7 w-7 items-center justify-center text-slate-600 hover:text-slate-900" aria-label="Increase quantity">{% render 'icons', name: 'plus', class: 'h-3 w-3' %}</button>
                </div>
                <p class="text-xs sm:text-sm font-extrabold text-brand-ink">{{ item.final_line_price | money }}</p>
              </div>
            </div>
          </article>
        {%- endfor -%}
      {%- else -%}
        <div class="flex h-full flex-col items-center justify-center gap-3 py-10 text-center" data-cart-empty>
          {% render 'icons', name: 'cart', class: 'h-10 w-10 text-slate-300' %}
          <p class="text-sm font-bold text-brand-ink">{{ 'general.empty_cart' | t }}</p>
          <button type="button" data-cart-drawer-close class="mt-1 inline-flex min-h-11 items-center rounded-xl bg-brand px-6 text-sm font-bold text-white hover:bg-brand-dark">{{ 'general.continue_shopping' | t }}</button>
        </div>
      {%- endif -%}
    </div>

    <div class="border-t border-slate-200 bg-slate-50/50 p-6" data-cart-footer {% if cart.item_count == 0 %}hidden{% endif %}>
      <div class="space-y-2 text-xs">
        <div class="flex justify-between text-slate-600">
          <span>{{ 'general.subtotal' | t }}</span>
          <span class="font-bold text-brand-ink" data-cart-subtotal>{{ cart.total_price | money }}</span>
        </div>
        <div class="flex justify-between border-t border-slate-200 pt-2 text-sm font-extrabold text-brand-ink">
          <span>Total</span>
          <span class="text-base text-brand" data-cart-total>{{ cart.total_price | money }}</span>
        </div>
      </div>
      <p class="mt-2 text-[11px] text-slate-400">Taxes included. Discounts and shipping calculated at checkout.</p>
      <div class="mt-4 flex flex-col gap-2.5">
        <a href="{{ routes.root_url }}checkout" data-checkout-link class="flex min-h-12 items-center justify-center rounded-xl bg-brand text-xs sm:text-sm font-bold text-white shadow-md hover:bg-brand-dark transition active:scale-[0.99]">
          Checkout Now
        </a>
        <a href="{{ routes.cart_url }}" class="flex min-h-11 items-center justify-center rounded-xl border border-slate-200 bg-white text-xs font-bold text-slate-700 hover:bg-slate-50 transition">
          View Shopping Cart
        </a>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Cart drawer",
  "settings": [
    { "type": "paragraph", "content": "Free-shipping threshold comes from Theme settings > Store. Checkout always uses Shopify's native checkout." }
  ],
  "presets": [{ "name": "Cart drawer" }]
}
{% endschema %}
