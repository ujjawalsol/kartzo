{% comment %} Why-choose band — merchant-editable feature blocks + stats. {% endcomment %}
<section id="about" class="pad hidden w-full py-8 sm:block" aria-label="Why choose us">
  <h2 class="mb-4 text-xl font-extrabold tracking-tight sm:text-2xl">{{ section.settings.heading_first }} <span class="text-brand">{{ section.settings.heading_accent }}</span></h2>
  {%- if section.blocks.size > 0 -%}
    <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 xl:grid-cols-6">
      {%- for block in section.blocks -%}
        <li class="rounded-2xl border border-[#e7eefb] bg-[#f7faff] px-3 py-5 text-center" {{ block.shopify_attributes }}>
          <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-[#e7efff] text-brand" aria-hidden="true">{% render 'icons', name: block.settings.icon, class: 'h-6 w-6' %}</span>
          <p class="mt-3 text-sm font-extrabold">{{ block.settings.title }}</p>
          <p class="mt-1 text-xs leading-relaxed text-brand-muted">{{ block.settings.sub }}</p>
        </li>
      {%- endfor -%}
    </ul>
  {%- else -%}
    <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 xl:grid-cols-6">
      <li class="rounded-2xl border border-[#e7eefb] bg-[#f7faff] px-3 py-5 text-center">
        <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-[#e7efff] text-brand" aria-hidden="true">{% render 'icons', name: 'shield', class: 'h-6 w-6' %}</span>
        <p class="mt-3 text-sm font-extrabold">Premium Quality</p>
        <p class="mt-1 text-xs text-brand-muted">Only genuine products</p>
      </li>
      <li class="rounded-2xl border border-[#e7eefb] bg-[#f7faff] px-3 py-5 text-center">
        <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-[#e7efff] text-brand" aria-hidden="true">{% render 'icons', name: 'tag', class: 'h-6 w-6' %}</span>
        <p class="mt-3 text-sm font-extrabold">Best Prices</p>
        <p class="mt-1 text-xs text-brand-muted">Unbeatable deals</p>
      </li>
      <li class="rounded-2xl border border-[#e7eefb] bg-[#f7faff] px-3 py-5 text-center">
        <a href="{{ pages['terms-conditions'].url | default: shop.terms_of_service.url | default: '/pages/terms-conditions' }}" class="block group">
          <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-[#e7efff] text-brand group-hover:scale-105 transition" aria-hidden="true">{% render 'icons', name: 'shield', class: 'h-6 w-6' %}</span>
          <p class="mt-3 text-sm font-extrabold group-hover:text-brand transition">Secure Shopping</p>
          <p class="mt-1 text-xs text-brand-muted">100% safe payments</p>
        </a>
      </li>
      <li class="rounded-2xl border border-[#e7eefb] bg-[#f7faff] px-3 py-5 text-center">
        <a href="{{ pages['returns-policy'].url | default: shop.refund_policy.url | default: '/pages/terms-conditions#return' }}" class="block group">
          <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-[#e7efff] text-brand group-hover:scale-105 transition" aria-hidden="true">{% render 'icons', name: 'refresh', class: 'h-6 w-6' %}</span>
          <p class="mt-3 text-sm font-extrabold group-hover:text-brand transition">Easy Returns</p>
          <p class="mt-1 text-xs text-brand-muted">7 days hassle free</p>
        </a>
      </li>
      <li class="rounded-2xl border border-[#e7eefb] bg-[#f7faff] px-3 py-5 text-center">
        <a href="{{ pages['shipping-policy'].url | default: shop.shipping_policy.url | default: '/pages/terms-conditions#shipping' }}" class="block group">
          <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-[#e7efff] text-brand group-hover:scale-105 transition" aria-hidden="true">{% render 'icons', name: 'truck', class: 'h-6 w-6' %}</span>
          <p class="mt-3 text-sm font-extrabold group-hover:text-brand transition">Fast Delivery</p>
          <p class="mt-1 text-xs text-brand-muted">On-time delivery</p>
        </a>
      </li>
      <li class="rounded-2xl border border-[#e7eefb] bg-[#f7faff] px-3 py-5 text-center">
        <a href="{{ pages['faq'].url | default: '/pages/faq' }}" class="block group">
          <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-[#e7efff] text-brand group-hover:scale-105 transition" aria-hidden="true">{% render 'icons', name: 'headset', class: 'h-6 w-6' %}</span>
          <p class="mt-3 text-sm font-extrabold group-hover:text-brand transition">24/7 Support</p>
          <p class="mt-1 text-xs text-brand-muted">Always here to help</p>
        </a>
      </li>
    </ul>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Why choose us",
  "settings": [
    { "type": "text", "id": "heading_first", "label": "Heading (dark part)", "default": "Why Choose" },
    { "type": "text", "id": "heading_accent", "label": "Heading (brand part)", "default": "Us?" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Quality checked" },
        { "type": "text", "id": "sub", "label": "Text", "default": "Every product is quality-checked before dispatch." },
        { "type": "select", "id": "icon", "label": "Icon", "default": "shield", "options": [
          { "value": "shield", "label": "Shield" },
          { "value": "truck", "label": "Truck" },
          { "value": "refresh", "label": "Returns" },
          { "value": "headset", "label": "Support" },
          { "value": "tag", "label": "Tag" },
          { "value": "check", "label": "Check" }
        ]}
      ]
    }
  ],
  "presets": [{ "name": "Why choose us", "blocks": [{ "type": "feature" }, { "type": "feature" }, { "type": "feature" }, { "type": "feature" }] }]
}
{% endschema %}
