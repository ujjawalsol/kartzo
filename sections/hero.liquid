{% comment %} Kartzo hero carousel — full-bleed slides, same motion/UX as the original. {% endcomment %}
<section class="hero-carousel relative mx-3 mt-3 overflow-hidden rounded-[1.4rem] bg-brand-ink sm:mx-4 lg:mx-0 lg:mt-0 lg:rounded-none" data-hero-carousel aria-label="Featured offers">
  <div class="hero-stage relative min-h-[150px] sm:min-h-[520px] lg:min-h-[540px]">
    {%- for block in section.blocks -%}
      <article
        class="hero-slide relative col-start-1 row-start-1 min-w-0 {% if forloop.first %}is-active{% endif %}"
        data-hero-slide
        aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
        {% unless forloop.first %}inert{% endunless %}
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.image -%}
          {%- if forloop.first -%}
            {{ block.settings.image | image_url: width: 1500 | image_tag: widths: '750, 1100, 1500', fetchpriority: 'high', alt: block.settings.image.alt | default: block.settings.heading, class: 'hero-slide-image absolute inset-0 h-full w-full object-cover object-center' }}
          {%- else -%}
            {{ block.settings.image | image_url: width: 1500 | image_tag: widths: '750, 1100, 1500', loading: 'lazy', alt: block.settings.image.alt | default: block.settings.heading, class: 'hero-slide-image absolute inset-0 h-full w-full object-cover object-center' }}
          {%- endif -%}
        {%- else -%}
          {%- assign hero_num = forloop.index0 | modulo: 3 | plus: 1 -%}
          {%- assign hero_asset = 'hero-' | append: hero_num | append: '.webp' -%}
          <img src="{{ hero_asset | asset_url }}" alt="{{ block.settings.heading | escape }}" width="1500" height="534" {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %} class="hero-slide-image absolute inset-0 h-full w-full object-cover object-center">
        {%- endif -%}
        <div class="hero-slide-shade absolute inset-0"></div>
        <div class="pad relative z-10 flex min-h-[150px] items-center py-3 sm:min-h-[520px] lg:min-h-[540px]">
          <div class="max-w-xl text-white">
            {%- if block.settings.kicker != blank -%}
              <p class="hero-kicker inline-flex items-center rounded-full bg-white/15 px-3 py-1 text-[11px] font-extrabold uppercase tracking-[0.18em] text-white/90 backdrop-blur-sm">{{ block.settings.kicker }}</p>
            {%- endif -%}
            <{% if forloop.first %}h1{% else %}h2{% endif %} class="mt-2 max-w-lg text-[1.6rem] sm:mt-4 font-extrabold leading-[1.05] tracking-[-0.03em] sm:text-6xl lg:text-[4.7rem]">
              {{ block.settings.heading | newline_to_br }}
              <span class="text-[#b9d5ff]">{{ block.settings.heading_accent }}</span>
            </{% if forloop.first %}h1{% else %}h2{% endif %}>
            {%- if block.settings.sub_mobile != blank -%}
              <p class="mt-1.5 truncate text-[13px] font-semibold text-white/85 sm:hidden">{{ block.settings.sub_mobile }}</p>
            {%- endif -%}
            {%- if block.settings.sub != blank -%}
              <p class="mt-3 hidden max-w-md text-sm leading-relaxed text-white/80 sm:mt-5 sm:block sm:text-base">{{ block.settings.sub }}</p>
            {%- endif -%}
            <div class="mt-3 flex flex-wrap gap-3 sm:mt-7">
              {%- if block.settings.cta_label != blank -%}
                <a href="{{ block.settings.cta_link | default: routes.all_products_collection_url }}" class="inline-flex min-h-11 items-center justify-center rounded-xl bg-white px-6 text-sm font-extrabold text-brand-ink shadow-[0_12px_28px_rgba(0,0,0,0.18)] transition hover:bg-[#eaf2ff]">
                  {{ block.settings.cta_label }} <span class="ml-2" aria-hidden="true">→</span>
                </a>
              {%- endif -%}
              {%- if block.settings.cta2_label != blank -%}
                <a href="{{ block.settings.cta2_link | default: routes.all_products_collection_url }}" class="hidden min-h-11 items-center justify-center rounded-xl border border-white/30 sm:inline-flex bg-white/10 px-6 text-sm font-bold text-white backdrop-blur-sm transition hover:bg-white/20">
                  {{ block.settings.cta2_label }}
                </a>
              {%- endif -%}
            </div>
          </div>
        </div>
      </article>
    {%- endfor -%}
    <div class="pad pointer-events-none absolute inset-x-0 bottom-0 z-20 flex flex-wrap items-center justify-center gap-2.5 px-4 sm:gap-2 sm:px-0 sm:bottom-5">
      <div class="pointer-events-auto flex items-center" data-hero-dots role="group" aria-label="{{ 'accessibility.choose_slide' | t }}"></div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero carousel",
  "max_blocks": 5,
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Background image" },
        { "type": "text", "id": "kicker", "label": "Kicker", "default": "Featured collection" },
        { "type": "textarea", "id": "heading", "label": "Heading line 1", "default": "Upgrade your" },
        { "type": "text", "id": "heading_accent", "label": "Heading line 2 (accent)", "default": "everyday." },
        { "type": "text", "id": "sub_mobile", "label": "Mobile subtitle", "default": "Top brands, great deals" },
        { "type": "textarea", "id": "sub", "label": "Desktop subtitle", "default": "Smart tech, home upgrades and daily essentials — curated for better living and better value." },
        { "type": "text", "id": "cta_label", "label": "Primary button label", "default": "Shop collection" },
        { "type": "url", "id": "cta_link", "label": "Primary button link" },
        { "type": "text", "id": "cta2_label", "label": "Secondary button label", "default": "View hot deals" },
        { "type": "url", "id": "cta2_link", "label": "Secondary button link" }
      ]
    }
  ],
  "presets": [{ "name": "Hero carousel", "blocks": [{ "type": "slide" }, { "type": "slide" }, { "type": "slide" }] }]
}
{% endschema %}
